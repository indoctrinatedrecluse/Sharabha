                color: is_selected ? #38bdf8 : #64748b;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.proc_name;
                        font-size: 12px;
