}

export component SaveKeyValueRow inherits Rectangle {
    in property <length> col_offset_w: 100px;
    in property <length> col_key_w: 170px;
    in property <length> col_type_w: 95px;
    in property <length> col_conf_w: 95px;
    in property <length> col_hex_w: 85px;

    in property <string> offset_str: "0x0000";
    in property <string> key_name: "UNKNOWN_KEY";
    in property <string> type_str: "i32";
    in property <string> conf_str: "99%";
    in property <string> hex_str: "00 00 00 00";
    in-out property <string> val_str: "0";
    in property <bool> is_even: false;
    callback write_clicked(string);

    height: 42px;
    background: is_even ? #0c1422aa : #080d1688;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has_hover ? #38bdf888 : #16203266;

    touch := TouchArea { }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 0px;

        // 1. Offset / Sthana (Left-aligned, monospace, clean padding)
        Rectangle {
            width: root.col_offset_w;
            clip: true;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 8px;
                alignment: start;
                Text {
                    text: root.offset_str;
                    font-size: 10px;
                    font-weight: 700;
                    color: #38bdf8;
                    font-family: "Consolas, monospace";
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        // Divider Spacer 1
        Rectangle { width: 8px; }

        // 2. Key Identifier / Property Name (Lakshana) - Left-aligned, bold, key icon
        Rectangle {
            width: root.col_key_w;
            clip: true;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: start;
                Text {
                    text: "🔑";
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.key_name;
                    font-size: 11px;
                    font-weight: 800;
                    color: #f1f5f9;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        // Divider Spacer 2
        Rectangle { width: 8px; }

        // 3. Type (Rupa) - Cleanly centered amber badge
        Rectangle {
            width: root.col_type_w;
            clip: true;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                alignment: center;
                Rectangle {
                    height: 24px;
                    background: #ca8a0422;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #ca8a0455;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text {
                            text: root.type_str;
                            font-size: 9px;
                            font-weight: 700;
                            color: #facc15;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Divider Spacer 3
        Rectangle { width: 8px; }

        // 4. Confidence (Vishwas) - Cleanly centered emerald pill badge
        Rectangle {
            width: root.col_conf_w;
            clip: true;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                alignment: center;
                Rectangle {
                    height: 24px;
                    background: #22c55e22;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #22c55e55;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text {
                            text: root.conf_str;
                            font-size: 9px;
                            font-weight: 700;
                            color: #4ade80;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Divider Spacer 4
        Rectangle { width: 8px; }

        // 5. Hex Dump - Cleanly centered monospace
        Rectangle {
            width: root.col_hex_w;
            clip: true;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                alignment: center;
                Rectangle {
                    height: 22px;
                    background: #1e293b44;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: #33415555;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;
                        Text {
                            text: root.hex_str;
                            font-size: 10px;
                            font-family: "Consolas, monospace";
                            color: #94a3b8;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Divider Spacer 5
        Rectangle { width: 8px; }

        // 6. Pre-loaded Editable Value - Stretching with clean padding
        Rectangle {
            horizontal-stretch: 1;
            min-width: 90px;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 8px;
                LineEdit {
                    text <=> root.val_str;
                    min-width: 60px;
                    height: 32px;
                    font-size: 12px;
                }
            }
        }

        // 7. Action Button - Cleanly centered
        Rectangle {
            width: 76px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 70px;
                    height: 30px;
                    background: btn_touch.has_hover ? #0284c7 : #1e3a5f;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #38bdf8;
                    btn_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.write_clicked(root.val_str);
                        }
                    }
                    Text {
                        text: "WRITE ✎";
                        font-size: 10px;
                        font-weight: 800;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component DiffTableRow inherits Rectangle {
    in property <string> offset_str: "0x0000";
    in property <string> field_name: "UNKNOWN_FIELD";
    in property <string> type_str: "i32";
    in property <string> before_str: "0";
    in property <string> after_str: "0";
    in property <string> delta_str: "+0";
    in property <string> conf_str: "100%";
    in property <bool> is_even: false;
    callback promote_clicked();

    height: 42px;
    background: is_even ? #0c1422aa : #080d1688;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has_hover ? #eab30888 : #16203266;

    touch := TouchArea { }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: center;

        // 1. Offset
        Rectangle {
            width: 100px;
            clip: true;
            Text {
                text: root.offset_str;
                font-size: 10px;
                font-weight: 700;
                color: #38bdf8;
                font-family: "Consolas, monospace";
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // 2. Field Name
        Rectangle {
            width: 170px;
            clip: true;
            Text {
                text: root.field_name;
                font-size: 11px;
                font-weight: 800;
                color: #f1f5f9;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // 3. Type
        Rectangle {
            width: 90px;
            clip: true;
            Rectangle {
                height: 22px;
                background: #ca8a0422;
                border-radius: 4px;
                border-width: 1px;
                border-color: #ca8a0455;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text { text: root.type_str; font-size: 9px; font-weight: 800; color: #facc15; vertical-alignment: center; overflow: elide; }
                }
            }
        }

        // 4. Baseline Before Value
        Rectangle {
            width: 120px;
            clip: true;
            Text {
                text: root.before_str;
                font-size: 11px;
                font-family: "Consolas, monospace";
                color: #94a3b8;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Arrow
        Text {
            text: "➔";
            font-size: 12px;
            color: #64748b;
            vertical-alignment: center;
            width: 20px;
            horizontal-alignment: center;
        }

        // 5. Evolved After Value
        Rectangle {
            width: 120px;
            clip: true;
            Text {
                text: root.after_str;
                font-size: 11px;
                font-weight: 700;
                font-family: "Consolas, monospace";
                color: #facc15;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // 6. Delta Badge
        Rectangle {
            width: 100px;
            clip: true;
            Rectangle {
                height: 24px;
                background: #15803d33;
                border-radius: 4px;
                border-width: 1px;
                border-color: #22c55e66;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: root.delta_str;
                        font-size: 10px;
                        font-weight: 800;
                        font-family: "Consolas, monospace";
                        color: #4ade80;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // 7. Confidence
        Rectangle {
            width: 130px;
            clip: true;
            Text {
                text: root.conf_str;
                font-size: 10px;
                font-weight: 700;
                color: #38bdf8;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // 8. Promote Button
        Rectangle {
            width: 80px;
            Rectangle {
                width: 74px;
                height: 28px;
                background: btn_touch.has_hover ? #ca8a04 : #854d0e;
                border-radius: 4px;
                border-width: 1px;
                border-color: #facc15;
                btn_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.promote_clicked(); }
                }
                Text {
                    text: "+ AGAMA";
                    font-size: 9px;
                    font-weight: 900;
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component ScanResultRow inherits Rectangle {
    in property <string> address_str: "0x00000000";
    in-out property <string> val_str: "0";
    in property <string> prev_val: "0";
    in property <string> type_str: "4 Bytes (i32)";
    in-out property <bool> is_frozen: false;
    in property <bool> is_even: false;

    callback freeze_toggled(bool);
    callback pin_clicked();
    callback write_clicked(string);
    callback ptr_scan_clicked();
    callback disasm_clicked();
    callback watch_writes_clicked();

    height: 36px;
    background: is_even ? #0c1422cc : #080d16aa;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has_hover ? #ff7b0066 : #16203244;

    touch := TouchArea { }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: center;

        // Freeze Checkbox
        Rectangle {
            width: 55px;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.is_frozen = !root.is_frozen;
                    root.freeze_toggled(root.is_frozen);
                }
            }
            Text {
                text: root.is_frozen ? "☑" : "☐";
                font-size: 16px;
                font-weight: 700;
                color: root.is_frozen ? #22c55e : #94a3b8;
                vertical-alignment: center;
            }
        }

        // Address
        Text {
            text: root.address_str;
            width: 130px;
            font-size: 11px;
            font-weight: 700;
            color: #ff7b00;
            vertical-alignment: center;
            font-family: "Consolas, monospace";
            overflow: elide;
        }

        // Live Editable Value
        LineEdit {
            text <=> root.val_str;
            width: 110px;
            font-size: 11px;
            height: 28px;
        }

        // Previous Value
        Text {
            text: root.prev_val;
            width: 90px;
            font-size: 11px;
            color: #64748b;
            vertical-alignment: center;
            overflow: elide;
        }

        // Type
        Text {
            text: root.type_str;
            width: 80px;
            font-size: 10px;
            color: #94a3b8;
            vertical-alignment: center;
            overflow: elide;
        }

        // Action Buttons
        HorizontalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            alignment: start;

            ThematicActionButton {
                text: "+ PIN";
                devanagari: "योजन";
                btn_width: 55px;
                btn_height: 26px;
                bg_color: #1e3a5f;
                hover_color: #2563eb;
                clicked => {
                    root.pin_clicked();
                }
            }

            ThematicActionButton {
                text: "WRITE";
                devanagari: "लेखन";
                btn_width: 55px;
                btn_height: 26px;
                bg_color: #0369a1;
                hover_color: #0284c7;
                clicked => {
                    root.write_clicked(root.val_str);
                }
            }

            ThematicActionButton {
                text: "PTR 🔗";
                devanagari: "व्यूह सूत्र";
                btn_width: 58px;
                btn_height: 26px;
                bg_color: #065f46;
                hover_color: #059669;
                clicked => {
                    root.ptr_scan_clicked();
                }
            }

            ThematicActionButton {
                text: "ASM ⚙";
                devanagari: "व्याकरण";
                btn_width: 58px;
                btn_height: 26px;
                bg_color: #581c87;
                hover_color: #7e22ce;
                clicked => {
                    root.disasm_clicked();
                }
            }

            ThematicActionButton {
                text: "F6 👁";
                devanagari: "ताण्डव";
                btn_width: 52px;
                btn_height: 26px;
                bg_color: #831843;
                hover_color: #be185d;
                clicked => {
                    root.watch_writes_clicked();
                }
            }
        }
    }
}

export component CheatTableRow inherits Rectangle {
    in property <int> row_id;
    in property <string> desc;
    in property <string> addr;
    in property <string> val_type;
    in-out property <string> val;
    in-out property <bool> is_frozen;
    in property <bool> is_script;
    in property <bool> script_active;
    in property <bool> is_group;
    in property <int> depth;
    in property <string> hotkey;
    in property <bool> is_even;

    callback toggle_active();
    callback write_or_run(string);

    height: root.is_group ? 28px : 32px;
    background: root.is_group ? #16213aee : (root.is_even ? #141e2ecc : transparent);
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 6px;

        // Enable / disable / folder marker
        Rectangle {
            width: 32px;
            horizontal-stretch: 0;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle_active(); }
            }
            Text {
                text: root.is_group ? "📁" : (root.is_script ? (root.script_active ? "⚡" : "○") : (root.is_frozen ? "☑" : "☐"));
                font-size: root.is_group ? 13px : 15px;
                font-weight: 700;
                color: root.is_group ? #eab308 : (root.is_script ? (root.script_active ? #a855f7 : #64748b) : (root.is_frozen ? #22c55e : #94a3b8));
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Description with folder indentation + hotkey chip
        HorizontalLayout {
            width: 200px;
            horizontal-stretch: 0;
            spacing: 4px;
            Rectangle {
                width: min(root.depth, 8) * 13px;
                background: transparent;
            }
            Text {
                text: root.desc;
                horizontal-stretch: 1;
                min-width: 0px;
                font-size: 11px;
                font-weight: root.is_group ? 800 : 400;
                color: root.is_group ? #fbbf24 : #f8fafc;
                vertical-alignment: center;
                overflow: elide;
            }
            if (root.hotkey != "") : Rectangle {
                width: 56px;
                height: 18px;
                background: #1e293bcc;
                border-radius: 3px;
                border-width: 1px;
                border-color: #38bdf855;
                Text {
                    text: root.hotkey;
                    font-size: 9px;
                    font-weight: 700;
                    color: #38bdf8;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        Text {
            text: root.addr;
            width: 120px;
            horizontal-stretch: 0;
            font-size: 10px;
            color: #ff7b00;
            vertical-alignment: center;
            font-family: "Consolas, monospace";
            overflow: elide;
        }
        Text {
            text: root.val_type;
            width: 70px;
            horizontal-stretch: 0;
            font-size: 9px;
            color: #94a3b8;
            vertical-alignment: center;
            overflow: elide;
        }

        if (root.is_group) : Text {
            text: "—";
            width: 70px;
            horizontal-stretch: 0;
            font-size: 10px;
            color: #475569;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if (!root.is_group) : LineEdit {
            text <=> root.val;
            width: 70px;
            horizontal-stretch: 0;
            font-size: 11px;
            height: 24px;
            enabled: !root.is_script;
        }

        HorizontalLayout {
            spacing: 4px;
            width: 72px;
            horizontal-stretch: 0;
            alignment: start;
            if (!root.is_group) : ThematicActionButton {
                text: root.is_script ? (root.script_active ? "DISABLE" : "ENABLE") : "WRITE";
                devanagari: root.is_script ? "प्रयोग" : "लेखन";
                compact: true;
                btn_width: 0px;
                btn_height: 22px;
                bg_color: root.is_script ? (root.script_active ? #b91c1c : #7c3aed) : #0369a1;
                hover_color: root.is_script ? (root.script_active ? #dc2626 : #8b5cf6) : #0284c7;
                clicked => { root.write_or_run(root.val); }
            }
        }

        // Absorb any leftover width so the columns stay pinned to their cells
        // instead of drifting apart on very wide windows.
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }
}

/* ==========================================================================
   RESIZABLE PANEL SPLITTER (Vibhajana Rekha / विभजन रेखा)
   Drag math uses absolute window coordinates: the handle itself moves while you
   drag it, so `mouse-x - pressed-x` (what the old code used) collapses to ~0 and
   the panel would run away or freeze. Emitting an incremental delta measured in
   screen space keeps the drag 1:1 with the pointer.
   ========================================================================== */
export component PanelSplitter inherits Rectangle {
    in property <bool> horizontal: false; // true = horizontal bar, resizes vertically
    in property <color> accent: #ff4d2e;
    in property <bool> enabled: true;

    callback moved_by(length);

    property <length> last_abs: 0px;
    property <bool> armed: false;

    background: touch.has_hover || touch.pressed ? root.accent : #1e2738aa;
    border-radius: 5px;

    HorizontalLayout {
        alignment: center;
        if root.horizontal : Rectangle { height: 2px; width: 26px; border-radius: 1px; background: #94a3b8cc; }
        if !root.horizontal : Rectangle { width: 2px; height: 26px; border-radius: 1px; background: #94a3b8cc; }
    }

    touch := TouchArea {
        mouse-cursor: root.horizontal ? row-resize : col-resize;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                root.armed = false;
            }
        }
        moved => {
            if (!self.pressed) {
                root.armed = false;
            } else if (!root.armed) {
                root.armed = true;
                root.last_abs = root.horizontal ? (self.absolute-position.y + self.mouse-y) : (self.absolute-position.x + self.mouse-x);
            } else {
                root.moved_by((root.horizontal ? (self.absolute-position.y + self.mouse-y) : (self.absolute-position.x + self.mouse-x)) - root.last_abs);
                root.last_abs = root.horizontal ? (self.absolute-position.y + self.mouse-y) : (self.absolute-position.x + self.mouse-x);
            }
        }
    }
}

/* Thin wrappers so a splitter fills the cross axis of its layout: a column bar
   spans the full height, a row bar spans the full width. */
export component VerticalSplitter inherits PanelSplitter {
    width: 9px;
}

export component HorizontalSplitter inherits PanelSplitter {
    horizontal: true;
    height: 9px;
}

export component RightResizeHandle inherits Rectangle {
    in property <color> accent: #38bdf8;
    callback moved_by(length);

    property <length> last_abs: 0px;
    property <bool> armed: false;

    width: 5px;
    background: touch.has_hover || touch.pressed ? root.accent : transparent;
    border-radius: 3px;

    touch := TouchArea {
        mouse-cursor: col-resize;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                root.armed = false;
            }
        }
        moved => {
            if (!self.pressed) {
                root.armed = false;
            } else if (!root.armed) {
                root.armed = true;
                root.last_abs = self.absolute-position.x + self.mouse-x;
            } else {
                root.moved_by((self.absolute-position.x + self.mouse-x) - root.last_abs);
                root.last_abs = self.absolute-position.x + self.mouse-x;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "SHARABHA — The Dual Aspect Engine (शरभ)";
    preferred-width: 1580px;
    preferred-height: 940px;
    min-width: 1120px;
    min-height: 700px;
    default-font-family: "Segoe UI, sans-serif";
    background: #07090d;

    forward-focus: global_key_scope;

    global_key_scope := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "p" || event.text == "P") {
                root.show_command_palette = !root.show_command_palette;
                return accept;
            }
            if event.text == Key.Escape {
                if root.show_netra_modal {
                    root.show_netra_modal = false;
                    return accept;
                }
                if root.show_update_modal {
                    root.show_update_modal = false;
                    root.dismiss_update_modal(root.active_tab);
                    return accept;
                }
                if root.show_process_modal {
                    root.show_process_modal = false;
                    return accept;
                }
                if root.show_command_palette {
                    root.show_command_palette = false;
                    return accept;
                }
                if root.show_docs_modal {
                    root.show_docs_modal = false;
                    return accept;
                }
                if root.show_vault_modal {
                    root.show_vault_modal = false;
                    return accept;
                }
            }
            return reject;
        }
    }

    // Universal Command Palette & Documentation Knowledge Base State
    in-out property <bool> show_netra_modal: false;
    in-out property <int> netra_selected_hit: 0;
    in-out property <int> kalyana_sub_tab: 0; // 0 = Save Forge, 1 = Kala Chakra (Save Diff)
    callback diff_saves_backup();
    callback diff_saves_dialog();
    in-out property <bool> show_update_modal: UpdaterState.is_modal_open;
    in-out property <bool> show_command_palette: false;
    in-out property <string> command_palette_search: "";
    in-out property <bool> show_docs_modal: false;
    in-out property <string> docs_search_query: "";
    in-out property <int> docs_selected_category: 0;
    in-out property <int> docs_active_article_idx: 0;

    // Documentation Knowledge Base Structured Codex Arrays
    in property <[string]> doc_titles: [
        "ASHTAMURTI DUAL-ASPECT ARCHITECTURE",
        "RUDRA TANDAVA // WIN32 MEMORY SCANNER",
        "STAMBHANA SENTINEL // MEMORY FREEZING",
        "MUDRA SUTRA // FAST AOB & WILDCARD MATCHER",
        "KALYANA STHITI // DUAL-MODE SAVE FORGE",
        "SHANNON ENTROPY MATHEMATICAL THEORY",
        "CHI-SQUARE & BYTE DENSITY METRICS",
        "STHITI RAKSHA // CHECKSUM RECOMPUTATION",
        "STHITI SANKALPA // ATOMIC REWRITE VOW",
        "GUPTA KOSHA // HARDWARE DPAPI VAULT",
        "LUAJIT 2.1 ASHTAMURTI BINDINGS",
        "UNIVERSAL COMMAND PALETTE CODEX"
    ];

    in property <[string]> doc_devanagaris: [
        "अष्टमूर्ति व चित्रपट (Eight Aspects & Hardware Video Engine)",
        "रुद्र ताण्डव अन्वेषण (Process Inquest & Page Enumeration)",
        "स्तम्भन सिद्धि (100ms Sentinel Memory Preservation)",
        "मुद्रा सूत्र अन्वेषण (Signature & Dynamic Hook Points)",
        "कल्याण स्थिति रचना (Agama Deterministic & Pravaha Fuzzy)",
        "संशय मान गणित (Entropy Formulations & Compression)",
        "साम्य व घनत्व मान (Statistical Goodness-of-Fit & Sparsity)",
        "स्थिति रक्षा मुद्रा (MD5, CRC-32, Adler-32 Auto-Seals)",
        "कर्म कवच संकल्प (MoveFileEx Atomic Swap Guarantee)",
        "गुप्त कोष मुद्रण (CryptProtectData & Zero Cloud Exposure)",
        "लुआ उद्बोधन वेदी (Native Memory Hooks in LuaJIT)",
        "सर्वज्ञ आज्ञा चक्र (Ctrl+P Fast Action Dispatcher)"
    ];

    in property <[string]> doc_theories: [
        "Sharabha (शरभ) pairs Rudra Tandava (aggressive process memory surgery) with Kalyana Sthiti (peaceful heuristic save forging). The Chitrapata subsystem provides 24 FPS hardware video loop animation synchronized to Slint hardware timers. When in Sacred Altar (Still) or Obsidian (Off) modes, timer execution is suspended, consuming exactly 0.0% idle CPU on the Intel Core Ultra 9 275HX.",
        "Rudra Tandava opens Win32 process handles via OpenProcess with VM_READ | VM_WRITE access. It scans the virtual address space using VirtualQueryEx to discover committed writable memory regions (PAGE_READWRITE, PAGE_EXECUTE_READWRITE). Scan passes evaluate Exact, Increased, Decreased, Changed, and Unchanged values across SIMD-aligned data buffers.",
        "Stambhana (स्तम्भन सिद्धि) implements high-precision variable locking. When an address is marked as frozen, a dedicated background sentinel periodically overwrites the target RAM location on a 100ms cadence. This locks Player Health, Stamina, Runes, and Currency in real time without thread deadlocks or crashes.",
        "Mudra Sutra is a high-speed Array of Bytes (AOB) signature pattern matcher. It compiles hex patterns containing single (?) or double (??) wildcards into mask vectors, scans executable segments, and resolves virtual addresses for live needle injection and dynamic code hooking.",
        "Kalyana Sthiti operates in dual modes: (1) Agama Deterministic Mode leverages verified temple profiles for known games (Elden Ring, Unreal Engine, Cyberpunk 2077) with dedicated field cards; (2) Pravaha Fuzzy Mode employs multi-metric heuristic inference to reverse-engineer unknown binary saves without schemas.",
        "Shannon Entropy measures the uncertainty in byte distributions: H(X) = -sum(P(x) * log2(P(x))). Saves with entropy >= 7.8 bits/byte indicate compressed or encrypted blobs (Zlib, Deflate, Oodle, AES). Entropy between 4.0 and 6.5 bits/byte indicates structured binary structs, while entropy < 2.5 reveals sparse, null-padded text and tables.",
        "The Chi-Square test computes goodness-of-fit against a uniform distribution across 256 byte bins: chi^2 = sum((O_i - E_i)^2 / E_i). Byte density metrics analyze the ratio of null bytes (0x00) versus printable ASCII characters (0x20-0x7E) to automatically isolate structured string headers and numeric records.",
        "Sthiti Raksha automatically computes and applies checksum seals before any file is rewritten. Supported algorithms include CRC-32 (IEEE 802.3), Adler-32 (Zlib rolling checksum), FromSoftware MD5 (128-bit slot digest for Elden Ring .sl2), and Sum32. This guarantees that modified saves pass game engine validation without corruption.",
        "Sthiti Sankalpa guarantees zero-data-loss through Karma Kavacha: (1) An automatic .sharabha.bak backup is generated in the save directory; (2) Data is written to a temporary staging file; (3) Win32 MoveFileExW performs an atomic swap with MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH.",
        "Gupta Kosha utilizes Windows Data Protection API (CryptProtectData / CryptUnprotectData) to seal user API keys using hardware-tied machine master keys. Supported BYOK providers include Google Gemini 2.5, DeepSeek R1/V3, and OpenAI-compatible local LLMs (Ollama, LM Studio) for Divya Drishti AI pre-analysis.",
        "The embedded LuaJIT 2.1 scripting altar exposes native memory bindings to Lua: sharabha.read_i32(addr), sharabha.write_u32(addr, val), sharabha.freeze_u32(addr, val, label), and sharabha.log(msg). Scripts execute with native JIT speed directly against attached processes.",
        "The Universal Command Palette (Ctrl+P) provides an all-in-one action dispatcher. Users can switch aspect workspaces, initiate memory scans, toggle locks, open save files, and cycle video modes. Press Esc at any time to dismiss."
    ];

    in property <[string]> doc_specs: [
        "• Stack: Pure Zig 0.17 + Slint 1.18 + LuaJIT 2.1 + SurrealDB\n• Hardware: Intel Core Ultra 9 275HX GPU Texture Engine\n• FPS: 24.0 (42ms interval) | Zero CPU Overhead when idle",
        "• Win32 APIs: OpenProcess, VirtualQueryEx, ReadProcessMemory, WriteProcessMemory\n• Protections: PAGE_READWRITE (0x04), PAGE_EXECUTE_READWRITE (0x40)\n• Candidate Filtering: Exact, Increased, Decreased, Changed, Unchanged",
        "• Subsystem: Stambhana Goraksha Sentinel\n• Precision: 100ms non-blocking periodic timer\n• Safety: Non-reentrant, thread-safe memory lock tables",
        "• Subsystem: Mudra Sutra (मुद्रा सूत्र)\n• Syntax: '48 89 5C 24 ?? 57' (hex bytes + wildcards)\n• Target: Dynamic hook injection & byte pattern resolution",
        "• Engine: Agama Deterministic Profiles + Pravaha Multi-Metric Fuzzy Overseer\n• Verified Vessels: Suzerain, Mass Effect LE 1/2/3 (.pcsav), Elden Ring (.sl2), Unreal GVAS (.sav)\n• Attributions: MELE research by Karlitos (Trilogy Save Editor); Suzerain by Abhishek Mitra",
        "• Formula: H(X) = -Σ P(x) * log2(P(x)) [Shannon 1948]\n• Thresholds: >= 7.8 (Compressed/Encrypted) | 4.0 - 6.5 (Structs) | < 2.5 (Sparse)\n• Subsystem: src/metrics/shannon.zig",
        "• Formulation: χ² = Σ ((O_i - E_i)² / E_i) over 256 byte frequency bins\n• Null Sparsity: Ratio of 0x00 bytes vs printable ASCII (0x20-0x7E)\n• Stride: Autocorrelation at 32, 64, 128 byte offsets",
        "• Algorithms: CRC-32 (IEEE), CRC-32/BZIP2 (BioWare Unreal), Adler-32 (Zlib), MD5\n• Target: Sthiti Raksha auto-seal on MELE2/3 (.pcsav), Elden Ring, Unreal GVAS, Cyberpunk saves\n• Subsystem: src/save/checksum.zig",
        "• Win32 API: MoveFileExW(temp, target, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)\n• Backup: <save>.sharabha.bak created prior to write\n• Subsystem: src/save/rewrite.zig",
        "• Win32 API: CryptProtectData / CryptUnprotectData\n• Cipher: Local Windows hardware-bound DPAPI master key\n• Zero Cloud Exposure: Keys stored exclusively in local encrypted vault",
        "• Lua Runtime: LuaJIT 2.1 (x64 Windows Native)\n• Bindings: sharabha.read_i32, sharabha.write_u32, sharabha.freeze_u32, sharabha.log\n• Execution: JIT native memory inquest",
        "• Shortcut: Ctrl + P (Global Key Scope)\n• Dismiss: Escape Key\n• Action: 20+ instant executable commands across all subsystems"
    ];

    in property <[string]> doc_actions: [
        "CYCLE VIDEO ENGINE (चित्रपट)",
        "SWITCH TO RUDRA TANDAVA",
        "TOGGLE STAMBHANA FREEZE",
        "EXECUTE PATTERN SCAN",
        "SWITCH TO SAVE FORGE",
        "SET METRIC: SHANNON ENTROPY",
        "SET METRIC: CHI-SQUARE",
        "VERIFY SAVE CHECKSUM",
        "COMMIT SAVE ATOMICALLY",
        "OPEN GUPTA KOSHA VAULT",
        "OPEN LUA ALTAR",
        "OPEN COMMAND PALETTE (Ctrl+P)"
    ];

    // Splash State
    in-out property <bool> show_splash: !LiveSave.skip_splash_hint;
    in-out property <string> splash_status: "Awakening the Ashtamurti & Invoking Sharabha (अष्टमूर्ति)...";

    // Active Tab: 0 = Rudra (Memory), 1 = Kalyana (Save Forge), 2 = Jnana (Knowledge Base)
    in-out property <int> active_tab: UpdaterState.active_tab >= 0 ? UpdaterState.active_tab : LiveSave.active_tab_hint;

    // Resizable Panes Dimensions (Interactive Drag Splitters)
    in-out property <string> active_process_name: LiveProcesses.proc_0_name + " [PID " + LiveProcesses.proc_0_pid + "]";
    in-out property <length> rudra_left_width: 320px;
    // Height of the "Found Addresses" panel; the Cheat Table below it takes every
    // remaining pixel (no more dead space under the table).
    in-out property <length> rudra_results_height: 210px;
    in-out property <length> kalyana_left_width: 270px;
    in-out property <length> jnana_left_width: 320px;

    // Ambient Altar Canvas & Video Controller (Chitrapata)
    in-out property <int> canvas_mode: 0; // 0=Sacred Altar (Still), 1=Animated Loop (Motion), 2=Obsidian (Off)
    in-out property <string> canvas_mode_name: "SACRED ALTAR (स्थिर वेदी)";
    in-out property <float> canvas_opacity: 0.88; // Default 72% so art shines brightly through frosted glass!
    in-out property <string> canvas_opacity_label: "ALTAR 88%";

