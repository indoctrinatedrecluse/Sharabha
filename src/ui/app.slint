    callback dismiss_update_modal(int);

    // =========================================================================
    // LAYER 1: AMBIENT CANVAS BACKGROUND (SACRED ALTAR STILL / ANIMATED LOOP)
    // =========================================================================
    Rectangle {
        width: 100%;
        height: 100%;
        background: #040609;

        // Mode 0: Sacred Altar Still Inscription (Fixed)
        if root.canvas_mode == 0: Image {
            source: @image-url("../../assets/media/bg_canvas_fallback.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.canvas_opacity;
        }

        // Mode 1: Animated Motion Video Loop (Chitrapata Active Stream @ 24 FPS)
        if root.canvas_mode == 1: Image {
            source: root.chitrapata_frames[root.current_loop_frame];
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.canvas_opacity;
        }

        // Mode 1: Animated Loop / Active Motion Flares
        if root.canvas_mode == 1: Rectangle {
            width: 100%;
            height: 100%;

            Rectangle {
                x: parent.width * 0.05;
                y: parent.height * 0.08;
                width: 600px;
                height: 600px;
                border-radius: 300px;
                background: @radial-gradient(circle, #ff4d2e28 0%, transparent 70%);
            }

            Rectangle {
                x: parent.width * 0.60;
                y: parent.height * 0.25;
                width: 700px;
                height: 700px;
                border-radius: 350px;
                background: @radial-gradient(circle, #0ea5e928 0%, transparent 70%);
            }
        }

        // Gentle vignette to maintain perfect contrast with text
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #07090d50 0%, #07090d20 50%, #07090d70 100%);
        }
    }

    // =========================================================================
    // LAYER 2: MAIN WORKSPACE INTERFACE
    // =========================================================================
    if !root.show_splash: VerticalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        padding: 16px;
        spacing: 12px;

        // TOP HEADER BAR: Trishula Logo & Aspect Selector (Frosted Glass, High-Z)
        Rectangle {
            height: 68px;
            background: #070b14b0;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: #2e3b5288;
            clip: false;
            z: 1000;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                // Logo & Motto (Responsive & Compact)
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    Image {
                        source: @image-url("../../assets/media/app_icon.png");
                        width: 38px;
                        height: 38px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "SHARABHA";
                                font-size: 18px;
                                font-weight: 900;
                                letter-spacing: 1.5px;
                                color: #f8fafc;
                            }
                            Text {
                                text: "शरभ";
                                font-size: 15px;
                                font-weight: 800;
                                color: #eab308;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Dual Aspect Tool // Sharabha Avatar";
                            font-size: 10px;
                            color: #64748b;
                            overflow: elide;
                            min-width: 0px;
                        }
                    }
                }

                // Aspect Tabs
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    TabButton {
                        title: "RUDRA (रुद्र)";
                        subtitle: "Memory Engine";
                        icon_text: "🔥";
                        is_active: root.active_tab == 0;
                        active_color: #ff4d2e;
                        sanskrit_title: "रुद्र ताण्डव // RUDRA TANDAVA";
                        feature_name: "Aspect: Memory Penetration & Needle Injection";
                        explanation: "Win32 process attachment, SIMD memory scanning, variable freezing, and live code injection.";
                        clicked => { root.active_tab = 0; }
                    }

                    TabButton {
                        title: "KALYANA (कल्याण)";
                        subtitle: "Save Forge";
                        icon_text: "🧊";
                        is_active: root.active_tab == 1;
                        active_color: #38bdf8;
                        sanskrit_title: "कल्याण स्थिति // KALYANA STHITI";
                        feature_name: "Aspect: Universal Heuristic Save Editor";
                        explanation: "Shannon entropy inference, candidate string/numeric table extraction, and atomic safe write.";
                        clicked => { root.active_tab = 1; }
                    }

                    TabButton {
                        title: "JNANA (ज्ञान)";
                        subtitle: "Agama Graph";
                        icon_text: "📜";
                        is_active: root.active_tab == 2;
                        active_color: #eab308;
                        sanskrit_title: "ज्ञान कोष // JNANA KOSHA";
                        feature_name: "Aspect: Embedded SurrealDB Knowledge Graph";
                        explanation: "Stores verified game save structures, format headers, and memory pointer tables.";
                        clicked => { root.active_tab = 2; }
                    }

                    // Ambient Canvas Switcher (Downwards & Right-Aligned Tooltip)
                    ThematicActionButton {
                        text: "CANVAS";
                        devanagari: root.canvas_opacity_label;
                        btn_width: 110px;
                        btn_height: 42px;
                        bg_color: root.canvas_mode == 0 ? #0369a1 : (root.canvas_mode == 1 ? #6d28d9 : #1e293b);
                        hover_color: #38bdf8;
                        tooltip_down: true;
                        tooltip_right_align: true;
                        sanskrit_title: "चित्रपट वेदी // SACRED CANVAS";
                        feature_name: "Feature: Altar Canvas & Loop Switcher";
                        explanation: "Toggles between Sacred Altar Still (bg_canvas_fallback.jpg), Animated Motion Loop, and Minimal Obsidian with translucency tuning.";
                        clicked => {
                            if root.canvas_mode == 0 {
                                root.canvas_mode = 1;
                                root.canvas_mode_name = "ANIMATED LOOP (सजीव चित्रपट)";
                                root.canvas_opacity = 0.92;
                                root.canvas_opacity_label = "LOOP 92%";
                            } else if root.canvas_mode == 1 {
                                root.canvas_mode = 2;
                                root.canvas_mode_name = "MINIMAL OBSIDIAN (निराकार)";
                                root.canvas_opacity = 0.10;
                                root.canvas_opacity_label = "OFF 10%";
                            } else {
                                root.canvas_mode = 0;
                                root.canvas_mode_name = "SACRED ALTAR (स्थिर वेदी)";
                                root.canvas_opacity = 0.88;
                                root.canvas_opacity_label = "ALTAR 88%";
                            }
                            root.cycle_canvas_mode();
                        }
                    }

                    // Vault Button (Downwards & Right-Aligned Tooltip)
                    ThematicActionButton {
                        text: "VAULT";
                        devanagari: "गुप्त कोष";
                        btn_width: 105px;
                        btn_height: 42px;
                        bg_color: #1e293b;
                        hover_color: #334155;
                        tooltip_down: true;
                        tooltip_right_align: true;
                        sanskrit_title: "गुप्त कोष // SECURE VAULT";
                        feature_name: "Feature: Windows DPAPI Encrypted Vault";
                        explanation: "Encrypted BYOK storage for Gemini, DeepSeek, and OpenAI-compatible API keys via local Windows DPAPI.";
                        clicked => { root.show_vault_modal = !root.show_vault_modal; }
                    }

                    // Universal Command Palette Quick Trigger (Ctrl+P)
                    ThematicActionButton {
                        text: "PALETTE";
                        devanagari: "⌘ P (आज्ञा)";
                        btn_width: 110px;
                        btn_height: 42px;
                        bg_color: #312e81;
                        hover_color: #4338ca;
                        tooltip_down: true;
                        tooltip_right_align: true;
                        sanskrit_title: "सर्वज्ञ आज्ञा चक्र // COMMAND PALETTE";
                        feature_name: "Feature: Universal Command Palette (Ctrl+P)";
                        explanation: "Opens universal searchable action dispatcher. Instant access to memory scans, save tools, scripts, and navigation.";
                        clicked => { root.show_command_palette = !root.show_command_palette; }
                    }

                    // Documentation Knowledge Base Quick Trigger
                    ThematicActionButton {
                        text: "DOCS";
                        devanagari: "शास्त्र ज्ञान";
                        btn_width: 100px;
                        btn_height: 42px;
                        bg_color: #713f12;
                        hover_color: #854d0e;
                        tooltip_down: true;
                        tooltip_right_align: true;
                        sanskrit_title: "शास्त्र पीठ // KNOWLEDGE BASE";
                        feature_name: "Feature: Searchable Documentation Manual";
                        explanation: "Interactive documentation codex covering Rudra memory inquest, Shannon entropy formulas, Chi-Square, and Lua bindings.";
                        clicked => { root.show_docs_modal = !root.show_docs_modal; }
                    }

                    // Auto-Updater Quick Trigger
                    ThematicActionButton {
                        text: "UPDATE";
                        devanagari: "अद्यतन चक्र";
                        btn_width: 105px;
                        btn_height: 42px;
                        bg_color: #065f46;
                        hover_color: #047857;
                        tooltip_down: true;
                        tooltip_right_align: true;
                        sanskrit_title: "अद्यतन संशुद्धि // AUTO-UPDATER";
                        feature_name: "Feature: Sacred Temple Release Synchronizer";
                        explanation: "Checks GitHub repository for latest sanctified release, renders markdown changelog, downloads setup, and performs seamless upgrade.";
                        clicked => {
                            root.show_update_modal = true;
                            root.check_for_updates(root.active_tab);
                        }
                    }
                }
            }
        }

        // BODY WORKSPACE CONTAINER (Frosted Glass)
        Rectangle {
            vertical-stretch: 1;
            background: #05080f70;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: #1e293b88;

            // -------------------------------------------------------------
            // TAB 0: 🔥 RUDRA ENGINE (Memory Scanner & Injection)
            // -------------------------------------------------------------
            if root.active_tab == 0: HorizontalLayout {
                width: 100%;
                height: 100%;
                padding: 16px;
                spacing: 12px;

                // Process Selector Panel (Resizable)
                Rectangle {
                    width: root.rudra_left_width;
                    horizontal-stretch: 0;
                    background: #090e1899;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #243048aa;
                    z: 50;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "DARSHANA & BANDHANA (दर्शन व बन्धन)";
                                font-size: 11px;
                                font-weight: 800;
                                letter-spacing: 0.5px;
                                color: #ff4d2e;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 88px;
                                height: 24px;
                                background: #162032b8;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #2e3b52;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.rudra_status_text = "Netra Inquest: Refreshing 180+ Win32 processes";
                                        root.refresh_processes();
                                    }
                                }
                                Text {
                                    text: "REFRESH ⟳";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        ThematicActionButton {
                            text: "PROCESS LIST DIALOG...";
                            devanagari: "सम्पूर्ण प्रक्रिया सूची";
                            btn_width: 0px;
                            btn_height: 38px;
                            bg_color: #1e3a5f;
                            hover_color: #2563eb;
                            tooltip_down: true;
                            sanskrit_title: "सम्पूर्ण प्रक्रिया सूची // PROCESS LIST DIALOG";
                            feature_name: "Feature: System Process Inquest Dialog";
                            explanation: "Opens a full-screen searchable process selector dialog listing all active OS tasks, window titles, and memory footprints.";
                            clicked => {
                                root.show_process_modal = true;
                            }
                        }

                        LineEdit {
                            placeholder-text: "Filter process name or PID (e.g. game.exe)...";
                            height: 36px;
                        }

                        // Active Process Mock List
                        Rectangle {
                            background: #080d16a8;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;

                                Rectangle {
                                    height: 34px;
                                    background: root.selected_process_idx == 0 ? #1e293ecc : #00000000;
                                    border-radius: 4px;
                                    border-width: root.selected_process_idx == 0 ? 1px : 0px;
                                    border-color: #ff7b00;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_process_idx = 0;
                                            root.active_process_name = LiveProcesses.proc_0_name + " [PID " + LiveProcesses.proc_0_pid + "]";
                                            root.active_process_pid = LiveProcesses.proc_0_pid;
                                            root.process_bound = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;
                                        Text { text: LiveProcesses.proc_0_name; font-size: 11px; font-weight: 700; color: #f8fafc; vertical-alignment: center; }
                                        Text { text: "PID " + LiveProcesses.proc_0_pid + " [" + LiveProcesses.proc_0_ram + "]"; font-size: 10px; color: #ff7b00; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    background: root.selected_process_idx == 1 ? #1e293ecc : #00000000;
                                    border-radius: 4px;
                                    border-width: root.selected_process_idx == 1 ? 1px : 0px;
                                    border-color: #ff7b00;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_process_idx = 1;
                                            root.active_process_name = LiveProcesses.proc_1_name + " [PID " + LiveProcesses.proc_1_pid + "]";
                                            root.active_process_pid = LiveProcesses.proc_1_pid;
                                            root.process_bound = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;
                                        Text { text: LiveProcesses.proc_1_name; font-size: 11px; color: #f8fafc; vertical-alignment: center; }
                                        Text { text: "PID " + LiveProcesses.proc_1_pid + " [" + LiveProcesses.proc_1_ram + "]"; font-size: 10px; color: #ff7b00; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    background: root.selected_process_idx == 2 ? #1e293ecc : #00000000;
                                    border-radius: 4px;
                                    border-width: root.selected_process_idx == 2 ? 1px : 0px;
                                    border-color: #ff7b00;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_process_idx = 2;
                                            root.active_process_name = LiveProcesses.proc_2_name + " [PID " + LiveProcesses.proc_2_pid + "]";
                                            root.active_process_pid = LiveProcesses.proc_2_pid;
                                            root.process_bound = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;
                                        Text { text: LiveProcesses.proc_2_name; font-size: 11px; color: #f8fafc; vertical-alignment: center; }
                                        Text { text: "PID " + LiveProcesses.proc_2_pid + " [" + LiveProcesses.proc_2_ram + "]"; font-size: 10px; color: #ff7b00; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    background: root.selected_process_idx == 3 ? #1e293ecc : #00000000;
                                    border-radius: 4px;
                                    border-width: root.selected_process_idx == 3 ? 1px : 0px;
                                    border-color: #ff7b00;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_process_idx = 3;
                                            root.active_process_name = LiveProcesses.proc_3_name + " [PID " + LiveProcesses.proc_3_pid + "]";
                                            root.active_process_pid = LiveProcesses.proc_3_pid;
                                            root.process_bound = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;
                                        Text { text: LiveProcesses.proc_3_name; font-size: 11px; color: #f8fafc; vertical-alignment: center; }
                                        Text { text: "PID " + LiveProcesses.proc_3_pid + " [" + LiveProcesses.proc_3_ram + "]"; font-size: 10px; color: #ff7b00; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    background: root.selected_process_idx == 4 ? #1e293ecc : #00000000;
                                    border-radius: 4px;
                                    border-width: root.selected_process_idx == 4 ? 1px : 0px;
                                    border-color: #ff7b00;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_process_idx = 4;
                                            root.active_process_name = LiveProcesses.proc_4_name + " [PID " + LiveProcesses.proc_4_pid + "]";
                                            root.active_process_pid = LiveProcesses.proc_4_pid;
                                            root.process_bound = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;
                                        Text { text: LiveProcesses.proc_4_name; font-size: 11px; color: #f8fafc; vertical-alignment: center; }
                                        Text { text: "PID " + LiveProcesses.proc_4_pid + " [" + LiveProcesses.proc_4_ram + "]"; font-size: 10px; color: #ff7b00; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Attach Button (Dynamic width - stretches with splitter)
                        ThematicActionButton {
                            text: root.process_bound ? "✓ BOUND // Attached" : "BIND PROCESS // Attach";
                            devanagari: root.process_bound ? "बद्ध प्रक्रिया" : "शरभ बन्धन";
                            btn_width: 0px;
                            btn_height: 44px;
                            bg_color: root.process_bound ? #15803d : #ff4d2e;
                            hover_color: root.process_bound ? #16a34a : #ff6548;
                            tooltip_down: true;
                            sanskrit_title: "शरभ बन्धन // PROCESS BINDING";
                            feature_name: "Feature: OpenProcess Memory Handle";
                            explanation: "Opens a full-access Win32 process handle (VM_READ | VM_WRITE) to attach hooks and scanner needles.";
                            clicked => {
                                root.process_bound = true;
                                root.process_bind_status = "BOUND // Armed [VM_READ | VM_WRITE]";
                                root.rudra_status_text = "Target Hooked: " + root.active_process_name + " • VM Ready";
                                root.attach_process(root.active_process_pid);
                            }
                        }
                    }
                }

                // Interactive Splitter Divider (Click & Drag to resize)
                VerticalSplitter {
                    moved_by(delta) => {
                        root.rudra_left_width = clamp(220px, max(220px, parent.width - 360px), root.rudra_left_width + delta);
                    }
                }

                // Memory Scanner & Match Results Panel (Fills remainder)
                Rectangle {
                    horizontal-stretch: 1;
                    background: #090e1899;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #243048aa;
                    z: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // Scan Control Bar (Fully Responsive with horizontal-stretch)
                        HorizontalLayout {
                            spacing: 8px;

                            LineEdit {
                                text <=> root.scan_target_value;
                                placeholder-text: "Target value (e.g. 100, 999999)...";
                                horizontal-stretch: 3;
                                min-width: 130px;
                                height: 42px;
                            }

                            // Scan Mode Cycle Selector (Exact, Increased, Decreased, Changed, Unchanged)
                            Rectangle {
                                horizontal-stretch: 2;
                                min-width: 120px;
                                height: 42px;
                                background: #162032b8;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2e3b52;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if root.scan_iteration == 0 {
                                            root.selected_scan_type = Math.mod(root.selected_scan_type + 1, 5);
                                            if root.selected_scan_type == 0 {
                                                root.scan_type_name = "EXACT (सटीक मान)";
                                            } else if root.selected_scan_type == 1 {
                                                root.scan_type_name = "BIGGER THAN (अधिकतम >)";
                                            } else if root.selected_scan_type == 2 {
                                                root.scan_type_name = "SMALLER THAN (न्यूनतम <)";
                                            } else if root.selected_scan_type == 3 {
                                                root.scan_type_name = "VALUE BETWEEN (मध्यवर्ती)";
                                            } else {
                                                root.scan_type_name = "UNKNOWN INITIAL (अज्ञात)";
                                            }
                                        } else {
                                            root.selected_rescan_type = Math.mod(root.selected_rescan_type + 1, 5);
                                            if root.selected_rescan_type == 0 {
                                                root.rescan_type_name = "EXACT VALUE (सटीक)";
                                            } else if root.selected_rescan_type == 1 {
                                                root.rescan_type_name = "INCREASED (वर्धित >)";
                                            } else if root.selected_rescan_type == 2 {
                                                root.rescan_type_name = "DECREASED (ह्रासित <)";
                                            } else if root.selected_rescan_type == 3 {
                                                root.rescan_type_name = "CHANGED (परिवर्तित !=)";
                                            } else {
                                                root.rescan_type_name = "UNCHANGED (अपरिवर्तित ==)";
                                            }
                                        }
                                        root.cycle_scan_type();
                                    }
                                }
                                Text {
                                    text: root.scan_iteration == 0 ? root.scan_type_name : root.rescan_type_name;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #ff7b00;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            // Data Type Cycle Selector
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 80px;
                                height: 42px;
                                background: #162032b8;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2e3b52;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected_data_type = Math.mod(root.selected_data_type + 1, 8);
                                        if root.selected_data_type == 0 {
                                            root.data_type_name = "4 Bytes (i32)";
                                        } else if root.selected_data_type == 1 {
                                            root.data_type_name = "4 Bytes (u32)";
                                        } else if root.selected_data_type == 2 {
                                            root.data_type_name = "8 Bytes (i64)";
                                        } else if root.selected_data_type == 3 {
                                            root.data_type_name = "Float (f32)";
                                        } else if root.selected_data_type == 4 {
                                            root.data_type_name = "Double (f64)";
                                        } else if root.selected_data_type == 5 {
                                            root.data_type_name = "1 Byte (i8)";
                                        } else if root.selected_data_type == 6 {
                                            root.data_type_name = "2 Bytes (i16)";
                                        } else {
                                            root.data_type_name = "String (Text)";
                                        }
                                        root.cycle_data_type();
                                    }
                                }
                                Text {
                                    text: root.data_type_name;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            ThematicActionButton {
                                text: "FIRST SCAN (प्रथम)";
                                devanagari: "सकल अन्वेषण";
                                horizontal-stretch: 2;
                                btn_width: 0px;
                                btn_height: 42px;
                                bg_color: #ff4d2e;
                                hover_color: #ff6548;
                                tooltip_down: true;
                                sanskrit_title: "प्रथम दृष्टि // FIRST INQUEST";
                                feature_name: "Feature: Initial RAM Value Scanner";
                                explanation: "Queries VirtualQueryEx for committed writable pages and cataloges all addresses matching the target.";
                                clicked => {
                                    if !root.process_bound {
                                        root.attach_process(root.active_process_pid);
                                        root.process_bound = true;
                                    }
                                    root.rudra_status_text = "Scanning process RAM for '" + root.scan_target_value + "' (" + root.data_type_name + ")...";
                                    root.scan_result_count_str = "SCANNING (अन्वेषण)...";
                                    root.start_memory_scan(root.scan_target_value, root.data_type_name);
                                }
                            }

                            ThematicActionButton {
                                text: "NEXT SCAN (पुनः)";
                                devanagari: "परिशोधन";
                                horizontal-stretch: 2;
                                btn_width: 0px;
                                btn_height: 42px;
                                bg_color: #242e42;
                                hover_color: #2e3b54;
                                tooltip_down: true;
                                sanskrit_title: "पुनर्दृष्टि // REFINED INQUEST";
                                feature_name: "Feature: Next Scan Address Filter";
                                explanation: "Re-reads only previously matched memory locations and discards any addresses whose value does not match.";
                                clicked => {
                                    root.rudra_status_text = "Refining previous candidates with '" + root.rescan_type_name + "' filter...";
                                    root.scan_result_count_str = "REFINING (परिशोधन)...";
                                    root.rescan_memory(root.scan_target_value, root.rescan_type_name);
                                }
                            }

                            ThematicActionButton {
                                text: "NEW SCAN (नूतन)";
                                devanagari: "नूतन शोधन";
                                horizontal-stretch: 1;
                                btn_width: 0px;
                                btn_height: 42px;
                                bg_color: #334155;
                                hover_color: #475569;
                                tooltip_down: true;
                                sanskrit_title: "नूतन शोधन // RESET SCANNER";
                                feature_name: "Feature: Reset Memory Inquest";
                                explanation: "Clears previous scan address cache and resets iteration state to 0 for a new target search.";
                                clicked => {
                                    root.scan_iteration = 0;
                                    root.found_count = 0;
                                    root.scan_result_count_str = "READY (नूतन अन्वेषण)";
                                    root.rudra_status_text = "Scanner Reset: Ready for fresh memory inquest";
                                    root.reset_memory_scan();
                                }
                            }
                        }

                        // Telemetry & Status Indicator Strip
                        Rectangle {
                            height: 24px;
                            background: #080d1688;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;
                                Text {
                                    text: "Iteration #" + root.scan_iteration + " • Status: " + root.scan_result_count_str;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: root.scan_iteration > 0 ? #22c55e : #64748b;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Type: " + root.data_type_name + " • Align: 4 Bytes • Range: 0x00000000..0x7FFFFFFF";
                                    font-size: 10px;
                                    color: #94a3b8;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // -------------------------------------------------------------
                        // UPPER TABLE: FOUND ADDRESSES (परिणाम शोधन / Found Addresses)
                        // -------------------------------------------------------------
                        Rectangle {
                            height: root.rudra_results_height;
                            background: #080d16a8;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;

                                // Results Header
                                Rectangle {
                                    height: 30px;
                                    background: #0c1422cc;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        Text { text: "FREEZE"; width: 55px; font-size: 9px; font-weight: 800; color: #64748b; vertical-alignment: center; }
                                        Text { text: "ADDRESS (क्षेत्र)"; width: 130px; font-size: 9px; font-weight: 800; color: #ff7b00; vertical-alignment: center; }
                                        Text { text: "LIVE VALUE (वर्तमान)"; width: 110px; font-size: 9px; font-weight: 800; color: #f8fafc; vertical-alignment: center; }
                                        Text { text: "PREVIOUS (पूर्व)"; width: 90px; font-size: 9px; font-weight: 800; color: #64748b; vertical-alignment: center; }
                                        Text { text: "TYPE (रूप)"; width: 80px; font-size: 9px; font-weight: 800; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "ACTIONS (क्रिया)"; horizontal-stretch: 1; font-size: 9px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                if root.scan_iteration == 0: Rectangle {
                                    height: 100px;
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "No active scan inquest. Enter target value above and click FIRST SCAN.";
                                            font-size: 11px;
                                            color: #64748b;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }

                                if root.scan_iteration >= 1 && root.scan_rows.length == 0: Rectangle {
                                    height: 100px;
                                    background: transparent;
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "No matching memory addresses found in target address space.";
                                            font-size: 11px;
                                            color: #64748b;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }

                                if root.scan_iteration >= 1 && root.scan_rows.length > 0: ScrollView {
                                    VerticalLayout {
                                        spacing: 4px;

                                        for row[idx] in root.scan_rows: ScanResultRow {
                                            address_str: row.address;
                                            val_str: row.val;
                                            prev_val: row.previous;
                                            type_str: row.val_type;
                                            is_frozen: row.is_frozen;
                                            is_even: Math.mod(idx, 2) == 0;
                                            freeze_toggled(frozen) => {
                                                root.rudra_status_text = frozen ?
                                                    "STAMBHANA ACTIVE: " + row.address + " locked" :
                                                    "Stambhana Unlocked: " + row.address + " unfrozen";
                                                root.toggle_freeze_address(row.address, frozen);
                                            }
                                            pin_clicked => {
                                                root.table_addr_0 = row.address;
                                                root.table_val_0 = row.val;
                                                root.table_type_0 = row.val_type;
                                                root.rudra_status_text = "Pinned " + row.address + " to Cheat Table";
                                            }
                                            write_clicked(val) => {
                                                root.rudra_status_text = "RAM Modified: " + row.address + " set to " + val;
                                                root.write_memory_address(row.address, val);
                                            }
                                            ptr_scan_clicked => {
                                                root.rudra_status_text = "Vyūha Sūtra: Scanning multi-level pointer chains for " + row.address + "...";
                                                root.scan_pointer(row.address);
                                            }
                                            disasm_clicked => {
                                                root.rudra_status_text = "Vyākaraṇa: Disassembling instructions at " + row.address + "...";
                                                root.disassemble_address(row.address);
                                            }
                                            watch_writes_clicked => {
                                                root.show_netra_modal = true;
                                                root.rudra_status_text = "Netra Drishtanta: Intercepting writes to " + row.address + " [DR0 Breakpoint Armed]...";
                                                root.watch_address_writes(row.address);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Draggable divider: Found Addresses <-> Cheat Table
                        HorizontalSplitter {
                            accent: #eab308;
                            moved_by(delta) => {
                                root.rudra_results_height = clamp(110px, max(110px, parent.height - 260px), root.rudra_results_height + delta);
                            }
                        }

                        // -------------------------------------------------------------
                        // LOWER TABLE: SAVED ADDRESS LIST / CHEAT TABLE (संरक्षित तालिका)
                        // -------------------------------------------------------------
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 150px;
                            background: #080d16a8;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #243048aa;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;

                                // Table Toolbar Header
                                HorizontalLayout {
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        Text {
                                            text: "CHETANA TALIKA // CHEAT TABLE (संरक्षित स्मृति तालिका)";
                                            font-size: 11px;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            color: #eab308;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.is_ct_loaded
                                                ? (root.ct_visible_entries + " / " + root.ct_total_entries + " rows · " + root.ct_table_count + " table(s)")
                                                : (root.table_row_count + " Tracked Entries");
                                            font-size: 10px;
                                            color: #64748b;
                                            vertical-alignment: center;
                                        }
                                        if (root.ct_filter != "") : Rectangle {
                                            background: #38bdf822;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: #38bdf866;
                                            horizontal-stretch: 1;
                                            height: 18px;
                                            Text {
                                                text: "FILTER: " + root.ct_filter;
                                                font-size: 9px;
                                                font-weight: 700;
                                                color: #38bdf8;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                }

                                // Action bar: table lifecycle + value refresh + search
                                HorizontalLayout {
                                    spacing: 6px;
                                    CompactActionButton {
                                        text: "LOAD .CT"; devanagari: "सीटी प्रवेश"; btn_width: 84px; btn_height: 26px;
                                        bg_color: #ca8a04; hover_color: #eab308;
                                        sanskrit_title: "सीटी प्रवेश // OPEN TABLE (REPLACE)";
                                        feature_name: "Feature: Cheat Engine Table Inquest";
                                        explanation: "Opens a .CT table, replacing the current address list while keeping the attached process.";
                                        clicked => {
                                            root.rudra_status_text = "🔱 Selecting Cheat Engine (.CT) Table (सीटी प्रवेश)...";
                                            root.load_ct_file();
                                        }
                                    }
                                    CompactActionButton {
                                        text: "MERGE .CT"; devanagari: "सीटी संयोग"; btn_width: 88px; btn_height: 26px;
                                        bg_color: #7c3aed; hover_color: #8b5cf6;
                                        sanskrit_title: "सीटी संयोग // MERGE TABLE";
                                        feature_name: "Feature: Non-destructive Table Merge";
                                        explanation: "Loads another .CT and appends its records to the current address list, keeping the bound process and every existing row.";
                                        clicked => {
                                            root.rudra_status_text = "🔱 Merging Cheat Engine Table (process + address list preserved)...";
                                            root.load_ct_merge();
                                        }
                                    }
                                    CompactActionButton {
                                        text: "⟳ VALUES"; devanagari: "मान नवीकरण"; btn_width: 76px; btn_height: 26px;
                                        bg_color: #0f766e; hover_color: #14b8a6;
                                        sanskrit_title: "मान नवीकरण // REFRESH VALUES";
                                        feature_name: "Feature: Live Value Re-read";
                                        explanation: "Re-reads every resolvable record from the attached process and refreshes the VALUE column.";
                                        clicked => {
                                            root.rudra_status_text = "⟳ Re-reading address list values...";
                                            root.refresh_ct_values();
                                        }
                                    }
                                    CompactActionButton {
                                        text: "CLEAR"; devanagari: "तालिका मोचन"; btn_width: 68px; btn_height: 26px;
                                        bg_color: #7f1d1d; hover_color: #991b1b;
                                        sanskrit_title: "तालिका मोचन // CLEAR ADDRESS LIST";
                                        feature_name: "Feature: Clear Address List";
                                        explanation: "Empties the address list without touching the attached process or the scan results.";
                                        clicked => {
                                            root.rudra_status_text = "Address list cleared (process binding preserved)";
                                            root.clear_ct_table();
                                        }
                                    }
                                    LineEdit {
                                        placeholder-text: "SEARCH (Enter) — desc / address / hotkey";
                                        text <=> root.ct_filter_input;
                                        horizontal-stretch: 1;
                                        min-width: 140px;
                                        height: 26px;
                                        font-size: 10px;
                                        accepted(t) => {
                                            root.ct_filter = t;
                                            root.filter_ct_table(t);
                                        }
                                    }
                                    if (root.ct_filter != "") : CompactActionButton {
                                        text: "✕ FILTER"; btn_width: 70px; btn_height: 26px;
                                        bg_color: #1e293b; hover_color: #334155;
                                        clicked => {
                                            root.ct_filter_input = "";
                                            root.ct_filter = "";
                                            root.filter_ct_table("");
                                        }
                                    }
                                }


                                // Cheat Table Column Headers
                                Rectangle {
                                    height: 26px;
                                    background: #0d1626cc;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Text { text: "ON"; width: 32px; horizontal-stretch: 0; font-size: 9px; font-weight: 800; color: #64748b; vertical-alignment: center; horizontal-alignment: center; }
                                        Text { text: "DESCRIPTION (नाम/वर्णन)"; width: 200px; horizontal-stretch: 0; font-size: 9px; font-weight: 800; color: #f8fafc; vertical-alignment: center; overflow: elide; }


                                        Text { text: "ADDRESS (क्षेत्र)"; width: 120px; horizontal-stretch: 0; font-size: 9px; font-weight: 800; color: #ff7b00; vertical-alignment: center; }
                                        Text { text: "TYPE (रूप)"; width: 70px; horizontal-stretch: 0; font-size: 9px; font-weight: 800; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "VALUE (मान)"; width: 70px; horizontal-stretch: 0; font-size: 9px; font-weight: 800; color: #f8fafc; vertical-alignment: center; }
                                        Text { text: "ACTION"; width: 72px; horizontal-stretch: 0; font-size: 9px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                // Secondary bar: freeze / persistent table / injection
                                HorizontalLayout {
                                    spacing: 6px;
                                    CompactActionButton {
                                        text: "+ ADDRESS"; devanagari: "हस्त योजन"; btn_width: 76px; btn_height: 24px;
                                        bg_color: #1e293b; hover_color: #334155;
                                        clicked => {
                                            root.table_row_count = min(3, root.table_row_count + 1);
                                            root.rudra_status_text = "Manual Address Row Added to Cheat Table";
                                        }
                                    }
                                    CompactActionButton {
                                        text: "FREEZE ALL"; devanagari: "सर्व स्तम्भन"; btn_width: 82px; btn_height: 24px;
                                        bg_color: #15803d; hover_color: #16a34a;
                                        clicked => {
                                            root.table_active_0 = true;
                                            root.table_active_1 = true;
                                            root.table_active_2 = true;
                                            root.rudra_status_text = "All Tracked Cheat Table Entries Frozen (Stambhana Armed)";
                                        }
                                    }
                                    CompactActionButton {
                                        text: "UNFREEZE"; devanagari: "सर्व मोक्ष"; btn_width: 78px; btn_height: 24px;
                                        bg_color: #7f1d1d; hover_color: #991b1b;
                                        clicked => {
                                            root.table_active_0 = false;
                                            root.table_active_1 = false;
                                            root.table_active_2 = false;
                                            root.rudra_status_text = "All Tracked Cheat Table Entries Unfrozen";
                                        }
                                    }
                                    CompactActionButton {
                                        text: "SAVE TBL"; devanagari: "सारिणी संग्रह"; btn_width: 72px; btn_height: 24px;
                                        bg_color: #0369a1; hover_color: #0284c7;
                                        sanskrit_title: "सारिणी संग्रह // SAVE TABLE";
                                        feature_name: "Feature: Serialize Cheat Table";
                                        explanation: "Saves tracked addresses, pointer chains, freeze sentinels, and Lua scripts to a .sharabha workspace file.";
                                        clicked => {
                                            root.rudra_status_text = "✓ Serializing Memory Table to " + root.table_file_path;
                                            root.save_memory_table(root.table_file_path);
                                        }
                                    }
                                    CompactActionButton {
                                        text: "LOAD TBL"; devanagari: "सारिणी प्रवेश"; btn_width: 72px; btn_height: 24px;
                                        bg_color: #0d9488; hover_color: #14b8a6;
                                        sanskrit_title: "सारिणी प्रवेश // LOAD TABLE";
                                        feature_name: "Feature: Load Cheat Table";
                                        explanation: "Loads persistent .sharabha workspace table, activating known records and embedded scripts.";
                                        clicked => {
                                            root.rudra_status_text = "✓ Loading Memory Table from " + root.table_file_path;
                                            root.load_memory_table(root.table_file_path);
                                        }
                                    }
                                    CompactActionButton {
                                        text: "INJECT"; devanagari: "पाश बन्धन"; btn_width: 66px; btn_height: 24px;
                                        bg_color: #9333ea; hover_color: #a855f7;
                                        sanskrit_title: "पाश बन्धन // DLL INJECTION";
                                        feature_name: "Feature: Win32 Remote Thread Injection";
                                        explanation: "Injects native DLL into attached process via CreateRemoteThread and LoadLibraryW.";
                                        clicked => {
                                            root.rudra_status_text = "🔱 Pasha Bandhana: Injecting " + root.dll_inject_path + " into " + root.active_process_name;
                                            root.inject_dll(root.dll_inject_path);
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }

                                // Virtualised rows: a 12k-entry table stays smooth because
                                // ListView only instantiates the visible slice.
                                if (root.is_ct_loaded) : ListView {
                                    // Pin the item width to the visible area: a ListView
                                    // otherwise sizes items to the widest row, which makes
                                    // proportionally-sized columns grow without bound.
                                    content-width: parent.width;
                                    for row[idx] in root.ct_rows: CheatTableRow {
                                        width: 100%;
                                        row_id: row.id;
                                        desc: row.description;
                                        addr: row.address;
                                        val_type: row.val_type;
                                        val: row.val;
                                        is_frozen: row.is_frozen;
                                        is_script: row.is_script;
                                        script_active: row.script_active;
                                        is_group: row.is_group;
                                        depth: row.depth;
                                        hotkey: row.hotkey;
                                        is_even: Math.mod(idx, 2) == 0;
                                        toggle_active => {
                                            if (row.is_group) {
                                                root.rudra_status_text = "📁 " + row.description;
                                            } else if (row.is_script) {
                                                root.rudra_status_text = (row.script_active ? "🔱 Disabling: " : "🔱 Enabling: ") + row.description;
                                                root.run_table_entry(row.source, row.ce_id, !row.script_active);
                                            } else {
                                                root.rudra_status_text = "Stambhana toggled: " + row.description;
                                                root.toggle_freeze_address(row.address, !row.is_frozen);
                                            }
                                        }
                                        write_or_run(new_val) => {
                                            if (row.is_script) {
                                                root.rudra_status_text = (row.script_active ? "🔱 Disabling: " : "🔱 Enabling: ") + row.description;
                                                root.run_table_entry(row.source, row.ce_id, !row.script_active);
                                            } else if (row.is_group) {
                                                root.rudra_status_text = "📁 " + row.description;
                                            } else {
                                                root.rudra_status_text = "RAM Written: " + row.address + " set to " + new_val;
                                                root.write_memory_address(row.address, new_val);
                                            }
                                        }
                                    }
                                }

                                if (!root.is_ct_loaded) : ScrollView {
                                    VerticalLayout {
                                        spacing: 4px;

                                            // Table Row 0
                                            Rectangle {
                                                height: 34px;
                                                background: #141e2ecc;
                                                border-radius: 4px;
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 55px;
                                                        TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.table_active_0 = !root.table_active_0;
                                                                root.rudra_status_text = root.table_active_0 ?
                                                                    "STAMBHANA: " + root.table_desc_0 + " frozen at " + root.table_val_0 :
                                                                    root.table_desc_0 + " unfrozen";
                                                                root.toggle_freeze_address(root.table_addr_0, root.table_active_0);
                                                            }
                                                        }
                                                        Text {
                                                            text: root.table_active_0 ? "☑" : "☐";
                                                            font-size: 16px;
                                                            font-weight: 700;
                                                            color: root.table_active_0 ? #22c55e : #94a3b8;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    LineEdit { text <=> root.table_desc_0; width: 140px; font-size: 11px; height: 26px; }
                                                    Text { text: root.table_addr_0; width: 130px; font-size: 11px; color: #ff7b00; vertical-alignment: center; font-family: "Consolas, monospace"; }
                                                    Text { text: root.table_type_0; width: 85px; font-size: 10px; color: #94a3b8; vertical-alignment: center; }
                                                    LineEdit { text <=> root.table_val_0; width: 110px; font-size: 11px; height: 26px; }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        horizontal-stretch: 1;
                                                        alignment: start;
                                                        ThematicActionButton {
                                                            text: "WRITE"; devanagari: "लेखन"; btn_width: 55px; btn_height: 26px;
                                                            bg_color: #0369a1; hover_color: #0284c7;
                                                            clicked => {
                                                                root.rudra_status_text = "RAM Written: " + root.table_addr_0 + " set to " + root.table_val_0;
                                                                root.write_memory_address(root.table_addr_0, root.table_val_0);
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // Table Row 1
                                            Rectangle {
                                                height: 34px;
                                                background: transparent;
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 55px;
                                                        TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.table_active_1 = !root.table_active_1;
                                                                root.toggle_freeze_address(root.table_addr_1, root.table_active_1);
                                                            }
                                                        }
                                                        Text {
                                                            text: root.table_active_1 ? "☑" : "☐";
                                                            font-size: 16px;
                                                            font-weight: 700;
                                                            color: root.table_active_1 ? #22c55e : #94a3b8;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    LineEdit { text <=> root.table_desc_1; width: 140px; font-size: 11px; height: 26px; }
                                                    Text { text: root.table_addr_1; width: 130px; font-size: 11px; color: #ff7b00; vertical-alignment: center; font-family: "Consolas, monospace"; }
                                                    Text { text: root.table_type_1; width: 85px; font-size: 10px; color: #94a3b8; vertical-alignment: center; }
                                                    LineEdit { text <=> root.table_val_1; width: 110px; font-size: 11px; height: 26px; }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        horizontal-stretch: 1;
                                                        alignment: start;
                                                        ThematicActionButton {
                                                            text: "WRITE"; devanagari: "लेखन"; btn_width: 55px; btn_height: 26px;
                                                            bg_color: #0369a1; hover_color: #0284c7;
                                                            clicked => {
                                                                root.rudra_status_text = "RAM Written: " + root.table_addr_1 + " set to " + root.table_val_1;
                                                                root.write_memory_address(root.table_addr_1, root.table_val_1);
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            // Table Row 2
                                            Rectangle {
                                                height: 34px;
                                                background: #141e2ecc;
                                                border-radius: 4px;
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    spacing: 8px;
                                                    Rectangle {
                                                        width: 55px;
                                                        TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.table_active_2 = !root.table_active_2;
                                                                root.toggle_freeze_address(root.table_addr_2, root.table_active_2);
                                                            }
                                                        }
                                                        Text {
                                                            text: root.table_active_2 ? "☑" : "☐";
                                                            font-size: 16px;
                                                            font-weight: 700;
                                                            color: root.table_active_2 ? #22c55e : #94a3b8;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    LineEdit { text <=> root.table_desc_2; width: 140px; font-size: 11px; height: 26px; }
                                                    Text { text: root.table_addr_2; width: 130px; font-size: 11px; color: #ff7b00; vertical-alignment: center; font-family: "Consolas, monospace"; }
                                                    Text { text: root.table_type_2; width: 85px; font-size: 10px; color: #94a3b8; vertical-alignment: center; }
                                                    LineEdit { text <=> root.table_val_2; width: 110px; font-size: 11px; height: 26px; }
                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        horizontal-stretch: 1;
                                                        alignment: start;
                                                        ThematicActionButton {
                                                            text: "WRITE"; devanagari: "लेखन"; btn_width: 55px; btn_height: 26px;
                                                            bg_color: #0369a1; hover_color: #0284c7;
                                                            clicked => {
                                                                root.rudra_status_text = "RAM Written: " + root.table_addr_2 + " set to " + root.table_val_2;
                                                                root.write_memory_address(root.table_addr_2, root.table_val_2);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                    }
                                }
                            }
                        }

                        // Interactive Lua Altar (उद्बोधन वेदी)
                        Rectangle {
                            background: #0e131fd8;
                            border-radius: 8px;
                            border-width: 1.5px;
                            border-color: #7c3aed88;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;

                                // Altar Header & Template Quick-Pickers
                                HorizontalLayout {
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Text {
                                            text: "🔱 LUA SCRIPT ALTAR (उद्बोधन वेदी):";
                                            font-size: 11px;
                                            font-weight: 800;
                                            color: #c084fc;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Process: " + root.active_process_name + " (PID " + root.active_process_pid + ")";
                                            font-size: 10px;
                                            color: #94a3b8;
                                            vertical-alignment: center;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        ThematicActionButton {
                                            text: "READ/WRITE"; devanagari: "स्मृति म्यूटेशन"; btn_width: 82px; btn_height: 22px;
                                            bg_color: #1e1b4b; hover_color: #312e81;
                                            clicked => {
                                                root.lua_script_input = "local addr = 0x7FF74A8014E4; local v = sharabha.read_i32(addr) or 0; sharabha.write_i32(addr, v + 1000); print('🔱 Mutated RAM value to: ' .. tostring(v + 1000));";
                                                root.lua_output_text = "Template Loaded: Direct Memory Read & Mutation";
                                            }
                                        }
                                        ThematicActionButton {
                                            text: "POINTER CHAIN"; devanagari: "व्यूह सूत्र"; btn_width: 92px; btn_height: 22px;
                                            bg_color: #1e1b4b; hover_color: #312e81;
                                            clicked => {
                                                root.lua_script_input = "local base = 0x7FF74A800000; local offsets = { 0x18, 0x68, 0x30 }; local target = sharabha.read_pointer(base, offsets); if target then print('✓ Resolved: 0x' .. string.format('%X', target) .. ' Val: ' .. tostring(sharabha.read_i32(target))); else print('❌ Traversal failed'); end";
                                                root.lua_output_text = "Template Loaded: Multi-Level Pointer Traversal";
                                            }
                                        }
                                        ThematicActionButton {
                                            text: "FREEZE LOCK"; devanagari: "स्तम्भन"; btn_width: 82px; btn_height: 22px;
                                            bg_color: #1e1b4b; hover_color: #312e81;
                                            clicked => {
                                                root.lua_script_input = "local ok = sharabha.freeze_i32(0x7FF74A8014E0, 999999, 'Godmode Lock'); if ok then print('✓ Stambhana Freeze Sentinel Armed'); else print('❌ Freeze failed'); end";
                                                root.lua_output_text = "Template Loaded: Stambhana Freeze Sentinel";
                                            }
                                        }
                                        ThematicActionButton {
                                            text: "INJECT DLL"; devanagari: "पाश बन्धन"; btn_width: 82px; btn_height: 22px;
                                            bg_color: #1e1b4b; hover_color: #312e81;
                                            clicked => {
                                                root.lua_script_input = "local hMod = sharabha.inject_dll('" + root.dll_inject_path + "'); if hMod then print('✓ Injected Base: 0x' .. string.format('%X', hMod)); else print('❌ Injection failed'); end";
                                                root.lua_output_text = "Template Loaded: Remote Thread DLL Injection";
                                            }
                                        }
                                        ThematicActionButton {
                                            text: "CODE CAVE"; devanagari: "गुहा स्थापन"; btn_width: 82px; btn_height: 22px;
                                            bg_color: #1e1b4b; hover_color: #312e81;
                                            clicked => {
                                                root.lua_script_input = "local cave = sharabha.allocate_cave(256); if cave then print('✓ Remote Code Cave Allocated: 0x' .. string.format('%X', cave)); else print('❌ Allocation failed'); end";
                                                root.lua_output_text = "Template Loaded: Executable Code Cave Allocation";
                                            }
                                        }
                                    }
                                }

                                // Script Code Editor Input Bar
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    LineEdit {
                                        text <=> root.lua_script_input;
                                        placeholder-text: "sharabha.write_u32(0x7FF74A8014E4, 999999); print('Mudra Awakened!')";
                                        font-size: 11px;
                                        font-family: "Consolas, monospace";
                                        horizontal-stretch: 1;
                                        height: 34px;
                                    }

                                    ThematicActionButton {
                                        text: "AWAKEN // Run";
                                        devanagari: "उद्बोधन";
                                        btn_width: 140px;
                                        btn_height: 34px;
                                        bg_color: #6d28d9;
                                        hover_color: #7c3aed;
                                        sanskrit_title: "उद्बोधन // AWAKEN LUA";
                                        feature_name: "Feature: Execute LuaJIT Script";
                                        explanation: "Executes custom Lua script with native memory read/write and freeze bindings directly against attached game process.";
                                        clicked => {
                                            root.rudra_status_text = "🔱 Lua Script Awakened: Memory mutation applied to " + root.active_process_name;
                                            root.lua_output_text = "🔱 Executing script against PID " + root.active_process_pid + "...";
                                            root.run_lua_script(root.lua_script_input);
                                        }
                                    }
                                }

                                // Interactive Script Output / Console Log
                                Rectangle {
                                    height: 26px;
                                    background: #07090ebd;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #334155;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;

                                        Text {
                                            text: "OUTPUT:";
                                            font-size: 9px;
                                            font-weight: 800;
                                            color: #a855f7;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.lua_output_text;
                                            font-size: 10px;
                                            font-family: "Consolas, monospace";
                                            color: #22c55e;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -------------------------------------------------------------
            // TAB 1: 🧊 KALYANA / SAVE FORGE (Fuzzy Save Editor)
            // -------------------------------------------------------------
            if root.active_tab == 1: HorizontalLayout {
                width: 100%;
                height: 100%;
                padding: 16px;
                spacing: 12px;

                // Left: File Information & Multi-Metric Switcher (Resizable)
                Rectangle {
                    width: root.kalyana_left_width;
                    background: #090e1899;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #243048aa;
                    z: 50;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "STHITI PARIKSHA (स्थिति परीक्षा)";
                                font-size: 12px;
                                font-weight: 800;
                                letter-spacing: 1px;
                                color: #38bdf8;
                            }
                            Text {
                                text: "Yukti Heuristic v1";
                                font-size: 10px;
                                color: #64748b;
                            }
                        }

                        ThematicActionButton {
                            text: "OPEN SAVE VESSEL // Load Save";
                            devanagari: "पात्र प्रवेश";
                            btn_width: 0px;
                            btn_height: 44px;
                            bg_color: #0284c7;
                            hover_color: #0396df;
                            tooltip_down: true;
                            sanskrit_title: "पात्र प्रवेश // OPEN VESSEL";
                            feature_name: "Feature: Load Save Binary / Struct";
                            explanation: "Loads arbitrary save game files and initiates Shannon entropy and heuristic pattern scanning.";
                            clicked => {
                                root.save_commit_feedback = "Launching Windows Open File Dialog (पात्र प्रवेश)...";
                                root.open_save_file();
                            }
                        }

                        // Metric Switcher Selector
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "PARIKSHA MANA // Metric Switcher (मान परीक्षा)";
                                font-size: 10px;
                                font-weight: 800;
                                color: #94a3b8;
                            }
                            Rectangle {
                                height: 38px;
                                background: #162032b8;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #0284c7;
                                TouchArea {
                                    clicked => {
                                        root.selected_metric = Math.mod(root.selected_metric + 1, 5);
                                        if root.selected_metric == 0 {
                                            root.metric_display_name = "AUTO-DETECT (सर्वज्ञ मान)";
                                            root.metric_score_value = "4.812 bits/byte";
                                            root.metric_verdict_value = "StructuredBinary (प्रपत्र)";
                                            root.container_sig_value = "RawCustomBinary (द्वि-आधारी)";
                                        } else if root.selected_metric == 1 {
                                            root.metric_display_name = "SHANNON ENTROPY (संशय मान)";
                                            root.metric_score_value = "1.393 bits/byte";
                                            root.metric_verdict_value = "SparseOrText (शुद्ध पाठ/रिक्त)";
                                            root.container_sig_value = "SparseZeroPadded (रिक्त बाहुल्य)";
                                        } else if root.selected_metric == 2 {
                                            root.metric_display_name = "CHI-SQUARE TEST (साम्य परीक्षा)";
                                            root.metric_score_value = "χ² = 0.0 (p < 0.001)";
                                            root.metric_verdict_value = "HighlyStructured (अत्यन्त व्यवस्थित)";
                                            root.container_sig_value = "TableRecords (अभिलेख)";
                                        } else if root.selected_metric == 3 {
                                            root.metric_display_name = "BYTE DENSITY & NULLS (घनत्व मान)";
                                            root.metric_score_value = "Null:82% Ascii:16%";
                                            root.metric_verdict_value = "SparseZeroPadded (रिक्त बाहुल्य)";
                                            root.container_sig_value = "HeaderAndPayload (शीर्षक)";
                                        } else {
                                            root.metric_display_name = "STRIDE PERIODICITY (आवर्तन परीक्षा)";
                                            root.metric_score_value = "Period: 32 bytes (100%)";
                                            root.metric_verdict_value = "UniformRecordArray (समरूप सारणी)";
                                            root.container_sig_value = "FixedRecordTable (नियत सारणी)";
                                        }
                                        root.cycle_metric();
                                    }
                                }
                                Text {
                                    text: root.metric_display_name;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Extractor Switcher Selector
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "NISKARSHANA // Extractor (निष्कर्षण युक्ति)";
                                font-size: 10px;
                                font-weight: 800;
                                color: #94a3b8;
                            }
                            Rectangle {
                                height: 38px;
                                background: #162032b8;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #0369a1;
                                TouchArea {
                                    clicked => {
                                        root.selected_extractor = Math.mod(root.selected_extractor + 1, 5);
                                        if root.selected_extractor == 0 {
                                            root.extractor_display_name = "AUTO HEURISTIC (स्वयंसिद्ध)";
                                        } else if root.selected_extractor == 1 {
                                            root.extractor_display_name = "AGAMA HYBRID (आगम सम्मिश्र)";
                                        } else if root.selected_extractor == 2 {
                                            root.extractor_display_name = "BINARY RECORD TABLE (अभिलेख सारणी)";
                                        } else if root.selected_extractor == 3 {
                                            root.extractor_display_name = "DELIMITED KEY-VALUE (परिसीमित तत्त्व)";
                                        } else {
                                            root.extractor_display_name = "BINARY TLV (दैर्घ्य संपुट)";
                                        }
                                        root.cycle_extractor();
                                    }
                                }
                                Text {
                                    text: root.extractor_display_name;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #eab308;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Telemetry Metric Score Card
                        Rectangle {
                            background: #080d16a8;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;

                                Text { text: "Score: " + root.metric_score_value; font-size: 11px; font-weight: 700; color: #38bdf8; }
                                Text { text: "Verdict: " + root.metric_verdict_value; font-size: 10px; color: #cbd5e1; }
                                Text { text: "Container: " + root.container_sig_value; font-size: 10px; color: #94a3b8; }
                            }
                        }

                        // AI Pre-Analysis (Divya Drishti) Toggle
                        Rectangle {
                            height: 38px;
                            background: root.ai_guidance_active ? #1e3a5f : #0f172a;
                            border-radius: 6px;
                            border-width: 1.5px;
                            border-color: root.ai_guidance_active ? #38bdf8 : #334155;
                            TouchArea {
                                clicked => {
                                    root.ai_guidance_active = !root.ai_guidance_active;
                                    root.ai_guidance_status = root.ai_guidance_active ? "DIVYA DRISHTI // Active [BYOK Vault]" : "DIVYA DRISHTI // Ready [BYOK]";
                                    root.toggle_ai_guidance();
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;
                                Text {
                                    text: "🔮 " + root.ai_guidance_status;
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: root.ai_guidance_active ? #7dd3fc : #94a3b8;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.ai_guidance_active ? "[ACTIVE]" : "[OFF]";
                                    font-size: 10px;
                                    font-weight: 900;
                                    color: root.ai_guidance_active ? #38bdf8 : #64748b;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Sthiti Safety Guarantees
                        Rectangle {
                            background: #0b111caa;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #0369a144;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                Text {
                                    text: "🛡️ Sthiti Karma Kavacha (कर्म कवच):";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                }
                                Text {
                                    text: "• Automatic .sharabha.bak prana backup\n• Shadow temp buffer integrity vow\n• Win32 MoveFileEx atomic swap";
                                    font-size: 10px;
                                    color: #64748b;
                                }
                            }
                        }

                        // Commit Button (Dynamic width - stretches with splitter)
                        ThematicActionButton {
                            text: "STHITI SANKALPA // Atomic Commit";
                            devanagari: "स्थिति संकल्प";
                            btn_width: 0px;
                            btn_height: 44px;
                            bg_color: #0369a1;
                            hover_color: #0779b8;
                            tooltip_down: true;
                            sanskrit_title: "स्थिति संकल्प // ATOMIC REWRITE VOW";
                            feature_name: "Feature: Safe File Commit";
                            explanation: "Duplicates original to .sharabha.bak, writes temporary shadow file, and swaps via MoveFileEx.";
                            clicked => {
                                root.save_commit_feedback = "🛡️ Sthiti Sankalpa Sealed: " + root.save_filename + " re-written with valid checksum & .sharabha.bak";
                                root.save_file_atomic();
                            }
                        }
                    }
                }

                // Interactive Splitter Divider (Click & Drag to resize)
                Rectangle {
                    width: 8px;
                    background: splitter_kalyana.has_hover ? #38bdf8 : #1e2738aa;
                    border-radius: 4px;
                    splitter_kalyana := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            root.kalyana_left_width = max(240px, min(parent.width - 400px, root.kalyana_left_width + (self.mouse-x - self.pressed-x)));
                        }
                    }
                }

                // Right: Editable Key-Value Table (Fills remainder)
                Rectangle {
                    horizontal-stretch: 1;
                    background: #090e1899;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #243048aa;
                    z: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // Header Banner
                        Rectangle {
                            height: 64px;
                            background: #141c2bcc;
                            border-radius: 8px;
                            border-width: 1.5px;
                            border-color: #0284c766;
                            clip: true;

                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                alignment: space-between;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 3px;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text {
                                            text: root.save_game_title;
                                            font-size: 14px;
                                            font-weight: 800;
                                            color: #38bdf8;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            height: 20px;
                                            background: root.is_deterministic ? #22c55e25 : #eab30825;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: root.is_deterministic ? #22c55e66 : #eab30866;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: root.is_deterministic ? "✓ Agama Deterministic (प्रमाण आगम)" : "Pravaha Fuzzy Overseer (सूक्ष्म रेखा)";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: root.is_deterministic ? #4ade80 : #facc15;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Vessel: " + root.save_filename + " (" + root.metric_verdict_value + " • " + root.metric_score_value + ")";
                                        font-size: 11px;
                                        color: #94a3b8;
                                        overflow: elide;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Rectangle {
                                        height: 24px;
                                        background: #0ea5e925;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: #0ea5e955;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text {
                                                text: root.save_checksum_info;
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #38bdf8;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Text {
                                        text: "Ranked by Confidence ↓ • " + root.save_filtered_count + " of " + root.save_extracted_count + " Extracted K-V Pairs";
                                        font-size: 9px;
                                        color: #64748b;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }

                        // Kalyana Sub-Tab Switcher (Save Forge vs Kala Chakra Save Diff)
                        HorizontalLayout {
                            spacing: 8px;

                            Rectangle {
                                width: 180px;
                                height: 36px;
                                background: root.kalyana_sub_tab == 0 ? #0284c733 : #0a101b99;
                                border-radius: 6px;
                                border-width: 1.5px;
                                border-color: root.kalyana_sub_tab == 0 ? #38bdf8 : #1e293b;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.kalyana_sub_tab = 0; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    Text { text: "⚔"; font-size: 13px; color: root.kalyana_sub_tab == 0 ? #38bdf8 : #64748b; vertical-alignment: center; }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        Text { text: "PRAVAHA FORGE"; font-size: 10px; font-weight: 800; color: root.kalyana_sub_tab == 0 ? #ffffff : #94a3b8; }
                                        Text { text: "प्रवाह सम्पादन"; font-size: 8px; font-weight: 700; color: #38bdf8; }
                                    }
                                }
                            }

                            Rectangle {
                                width: 220px;
                                height: 36px;
                                background: root.kalyana_sub_tab == 1 ? #eab30833 : #0a101b99;
                                border-radius: 6px;
                                border-width: 1.5px;
                                border-color: root.kalyana_sub_tab == 1 ? #eab308 : #1e293b;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.kalyana_sub_tab = 1; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;
                                    Text { text: "⏳"; font-size: 13px; color: root.kalyana_sub_tab == 1 ? #eab308 : #64748b; vertical-alignment: center; }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        Text { text: "KALA CHAKRA SAVE DIFF"; font-size: 10px; font-weight: 800; color: root.kalyana_sub_tab == 1 ? #ffffff : #94a3b8; }
                                        Text { text: "काल चक्र दर्शन"; font-size: 8px; font-weight: 700; color: #eab308; }
                                    }
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }
                        }

                        if root.kalyana_sub_tab == 0: VerticalLayout {
                            spacing: 12px;
                            vertical-stretch: 1;

                        // Search Filter & Table Quick Actions Bar (with Gated Dynamic Filtering & Search Button)
                        HorizontalLayout {
                            spacing: 8px;

                            LineEdit {
                                text <=> root.save_table_filter;
                                placeholder-text: root.is_filter_gated ? 
                                    "Filter keys, offset, or type (Large list: press Search 🔍 or Enter)..." : 
                                    "Filter keys, offset, or type (Live filter active ⚡ or press Search)...";
                                min-width: 100px;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                height: 38px;
                                edited(val) => {
                                    if (!root.is_filter_gated) {
                                        root.filter_save_rows(val);
                                    }
                                }
                                accepted(val) => {
                                    root.filter_save_rows(val);
                                }
                            }

                            // Dynamic / Gated Status Indicator Pill
                            Rectangle {
                                width: 135px;
                                height: 38px;
                                background: root.is_filter_gated ? #854d0e25 : #15803d25;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.is_filter_gated ? #ca8a0466 : #22c55e66;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: root.is_filter_gated ? "🔒 GATED (>100)" : "⚡ LIVE FILTER";
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: root.is_filter_gated ? #facc15 : #4ade80;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            ThematicActionButton {
                                text: "SEARCH 🔍";
                                devanagari: "अन्वेषण";
                                btn_width: 105px;
                                btn_height: 38px;
                                bg_color: #0284c7;
                                hover_color: #0ea5e9;
                                sanskrit_title: "अन्वेषण // SEARCH FILTER";
                                feature_name: "Feature: Key-Value Search";
                                explanation: root.is_filter_gated ? 
                                    "Gated search mode active (> 100 rows). Click or press Enter to filter." : 
                                    "Dynamic live search active (<= 100 rows). Filtering updates dynamically on keystroke or click.";
                                clicked => {
                                    root.filter_save_rows(root.save_table_filter);
                                }
                            }

                            if root.save_table_filter != "": ThematicActionButton {
                                text: "RESET ✖";
                                devanagari: "निवारण";
                                btn_width: 85px;
                                btn_height: 38px;
                                bg_color: #334155;
                                hover_color: #475569;
                                sanskrit_title: "निवारण // RESET FILTER";
                                feature_name: "Feature: Clear Search Filter";
                                explanation: "Clears active search query and restores all extracted save rows.";
                                clicked => {
                                    root.save_table_filter = "";
                                    root.filter_save_rows("");
                                }
                            }

                            ThematicActionButton {
                                text: "APPLY ALL // Write";
                                devanagari: "सर्व संस्कार";
                                btn_width: 125px;
                                btn_height: 38px;
                                bg_color: #15803d;
                                hover_color: #16a34a;
                                sanskrit_title: "सर्व संस्कार // APPLY ALL EDITS";
                                feature_name: "Feature: Commit All Values";
                                explanation: "Applies all modified values across all key rows into the save memory buffer.";
                                clicked => {
                                    root.save_commit_feedback = "✓ Applied all " + root.save_rows.length + " extracted key-value edits into memory buffer";
                                }
                            }

                            ThematicActionButton {
                                text: "RELOAD ⟳";
                                devanagari: "पुनः प्राप्ति";
                                btn_width: 95px;
                                btn_height: 38px;
                                bg_color: #1e293b;
                                hover_color: #334155;
                                sanskrit_title: "पुनः प्राप्ति // RELOAD VESSEL";
                                feature_name: "Feature: Re-parse Save from Disk";
                                explanation: "Reloads the active save file from disk and refreshes all extracted keys.";
                                clicked => {
                                    root.save_commit_feedback = "Re-parsing save vessel from disk (स्थिति पुनः परीक्षा)...";
                                    root.reparse_save_file();
                                }
                            }
                        }

                        // Table Column Headers (with Interactive Column Resizers & Left-Anchored Stretch Justification)
                        Rectangle {
                            height: 36px;
                            background: #0d1626ee;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: #1e293b;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 0px;

                                // 1. Column: OFFSET
                                Rectangle {
                                    width: root.col_width_offset;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 8px;
                                        alignment: start;
                                        Text {
                                            text: "OFFSET";
                                            font-size: 10px;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            color: #38bdf8;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Resizer 1 (Offset -> Key)
                                Rectangle {
                                    width: 8px;
                                    background: transparent;
                                    Rectangle {
                                        width: 2px;
                                        height: 18px;
                                        background: resizer_1.has_hover ? #38bdf8 : #33415588;
                                        border-radius: 1px;
                                    }
                                    resizer_1 := TouchArea {
                                        mouse-cursor: col-resize;
                                        moved => {
                                            root.col_width_offset = max(70px, min(320px, root.col_width_offset + (self.mouse-x - self.pressed-x)));
                                        }
                                    }
                                }

                                // 2. Column: KEY IDENTIFIER
                                Rectangle {
                                    width: root.col_width_key;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: start;
                                        Text {
                                            text: "KEY IDENTIFIER (लक्षण)";
                                            font-size: 10px;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            color: #f8fafc;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Resizer 2 (Key -> Type)
                                Rectangle {
                                    width: 8px;
                                    background: transparent;
                                    Rectangle {
                                        width: 2px;
                                        height: 18px;
                                        background: resizer_2.has_hover ? #38bdf8 : #33415588;
                                        border-radius: 1px;
                                    }
                                    resizer_2 := TouchArea {
                                        mouse-cursor: col-resize;
                                        moved => {
                                            root.col_width_key = max(100px, min(480px, root.col_width_key + (self.mouse-x - self.pressed-x)));
                                        }
                                    }
                                }

                                // 3. Column: TYPE
                                Rectangle {
                                    width: root.col_width_type;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        alignment: center;
                                        Text {
                                            text: "TYPE (रूप)";
                                            font-size: 10px;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            color: #eab308;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Resizer 3 (Type -> Conf)
                                Rectangle {
                                    width: 8px;
                                    background: transparent;
                                    Rectangle {
                                        width: 2px;
                                        height: 18px;
                                        background: resizer_3.has_hover ? #38bdf8 : #33415588;
                                        border-radius: 1px;
                                    }
                                    resizer_3 := TouchArea {
                                        mouse-cursor: col-resize;
                                        moved => {
                                            root.col_width_type = max(70px, min(260px, root.col_width_type + (self.mouse-x - self.pressed-x)));
                                        }
                                    }
                                }

                                // 4. Column: CONFIDENCE
                                Rectangle {
                                    width: root.col_width_conf;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        alignment: center;
                                        Text {
                                            text: "CONFIDENCE";
                                            font-size: 10px;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            color: #4ade80;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Resizer 4 (Conf -> Hex)
                                Rectangle {
                                    width: 8px;
                                    background: transparent;
                                    Rectangle {
                                        width: 2px;
                                        height: 18px;
                                        background: resizer_4.has_hover ? #38bdf8 : #33415588;
                                        border-radius: 1px;
                                    }
                                    resizer_4 := TouchArea {
                                        mouse-cursor: col-resize;
                                        moved => {
                                            root.col_width_conf = max(70px, min(240px, root.col_width_conf + (self.mouse-x - self.pressed-x)));
                                        }
                                    }
                                }

                                // 5. Column: HEX DUMP
                                Rectangle {
                                    width: root.col_width_hex;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        alignment: center;
                                        Text {
                                            text: "HEX DUMP";
                                            font-size: 10px;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            color: #94a3b8;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Resizer 5 (Hex -> Value)
                                Rectangle {
                                    width: 8px;
                                    background: transparent;
                                    Rectangle {
                                        width: 2px;
                                        height: 18px;
                                        background: resizer_5.has_hover ? #38bdf8 : #33415588;
                                        border-radius: 1px;
                                    }
                                    resizer_5 := TouchArea {
                                        mouse-cursor: col-resize;
                                        moved => {
                                            root.col_width_hex = max(65px, min(220px, root.col_width_hex + (self.mouse-x - self.pressed-x)));
                                        }
                                    }
                                }

                                // 6. Column: PRE-LOADED VALUE (Stretching)
                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 90px;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        alignment: start;
                                        Text {
                                            text: "VALUE (तत्त्व)";
                                            font-size: 10px;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            color: #38bdf8;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // 7. Column: ACTION
                                Rectangle {
                                    width: 76px;
                                    clip: true;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "ACTION";
                                            font-size: 10px;
                                            font-weight: 800;
                                            letter-spacing: 0.5px;
                                            color: #cbd5e1;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Table Rows (Scrollable list of extracted key-value records)
                        ScrollView {
                            vertical-stretch: 1;
                            min-height: 250px;
                            VerticalLayout {
                                width: 100%;
                                padding-left: 0px;
                                padding-right: 0px;
                                padding-top: 2px;
                                padding-bottom: 2px;
                                spacing: 4px;

                                for row[idx] in root.save_rows: SaveKeyValueRow {
                                    col_offset_w: root.col_width_offset;
                                    col_key_w: root.col_width_key;
                                    col_type_w: root.col_width_type;
                                    col_conf_w: root.col_width_conf;
                                    col_hex_w: root.col_width_hex;
                                    offset_str: row.offset;
                                    key_name: row.key;
                                    type_str: row.type_name;
                                    conf_str: row.conf;
                                    hex_str: row.hex;
                                    val_str: row.val;
                                    is_even: Math.mod(idx, 2) == 0;
                                    write_clicked(val) => {
                                        root.save_commit_feedback = "Modified " + row.key + " = '" + val + "' • Safe commit armed";
                                        root.write_save_field(row.key, val);
                                    }
                                }
                            }
                        }
                        } // end if root.kalyana_sub_tab == 0

                        if root.kalyana_sub_tab == 1: VerticalLayout {
                            spacing: 12px;
                            vertical-stretch: 1;

                            // Kala Chakra Quick Actions & Comparison Vessels Info Bar
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    Rectangle {
                                        height: 38px;
                                        background: #0d1b2a99;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #38bdf844;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 6px;
                                            alignment: center;
                                            Text { text: "📁 A:"; font-size: 11px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                                            Text { text: LiveDiff.file_a; font-size: 11px; font-weight: 700; color: #f1f5f9; vertical-alignment: center; }
                                            Text { text: "➔"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                            Text { text: "📁 B:"; font-size: 11px; font-weight: 800; color: #eab308; vertical-alignment: center; }
                                            Text { text: LiveDiff.file_b; font-size: 11px; font-weight: 700; color: #f1f5f9; vertical-alignment: center; }
                                        }
                                    }

                                    Rectangle {
                                        height: 38px;
                                        background: #15803d25;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #22c55e66;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            alignment: center;
                                            Text {
                                                text: "" + LiveDiff.total_mutations + " MUTATIONS ISOLATED";
                                                font-size: 10px;
                                                font-weight: 800;
                                                color: #4ade80;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;

                                    ThematicActionButton {
                                        text: "COMPARE .BAK ⟳";
                                        devanagari: "पूर्व तुलना";
                                        btn_width: 155px;
                                        btn_height: 38px;
                                        bg_color: #1e3a5f;
                                        hover_color: #0284c7;
                                        sanskrit_title: "काल चक्र पूर्व तुलना // COMPARE WITH BACKUP";
                                        feature_name: "Feature: Compare Active Save with .sharabha.bak";
                                        explanation: "Automatically compares the active game save with its Sthiti Kavacha backup.";
                                        clicked => {
                                            root.save_commit_feedback = "Kala Chakra: Comparing active save with Sthiti Kavacha backup (.bak)...";
                                            root.diff_saves_backup();
                                        }
                                    }

                                    ThematicActionButton {
                                        text: "SELECT 2 SAVES";
                                        devanagari: "द्वय चयन";
                                        btn_width: 145px;
                                        btn_height: 38px;
                                        bg_color: #1e293b;
                                        hover_color: #334155;
                                        sanskrit_title: "द्वय पात्र परीक्षा // SELECT TWO VESSELS";
                                        feature_name: "Feature: Compare Any Two Game Saves";
                                        explanation: "Select Baseline Save A and Evolved Save B for side-by-side binary and property diffing.";
                                        clicked => {
                                            root.save_commit_feedback = "Kala Chakra: Opening save vessel selector dialog...";
                                            root.diff_saves_dialog();
                                        }
                                    }
                                }
                            }

                            // Kala Chakra Table Column Headers
                            Rectangle {
                                height: 36px;
                                background: #0d1626ee;
                                border-radius: 5px;
                                border-width: 1px;
                                border-color: #1e293b;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;

                                    Text { text: "OFFSET"; width: 100px; font-size: 10px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                                    Text { text: "FIELD / KEY (लक्षण)"; width: 170px; font-size: 10px; font-weight: 800; color: #f8fafc; vertical-alignment: center; }
                                    Text { text: "TYPE"; width: 90px; font-size: 10px; font-weight: 800; color: #eab308; vertical-alignment: center; }
                                    Text { text: "BASELINE (पूर्व)"; width: 120px; font-size: 10px; font-weight: 800; color: #94a3b8; vertical-alignment: center; }
                                    Text { text: "➔"; width: 20px; font-size: 10px; color: #64748b; vertical-alignment: center; horizontal-alignment: center; }
                                    Text { text: "EVOLVED (पश्चात्)"; width: 120px; font-size: 10px; font-weight: 800; color: #facc15; vertical-alignment: center; }
                                    Text { text: "DELTA (परिवर्तन)"; width: 100px; font-size: 10px; font-weight: 800; color: #4ade80; vertical-alignment: center; }
                                    Text { text: "CONFIDENCE"; width: 130px; font-size: 10px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                                    Text { text: "PROMOTE"; width: 80px; font-size: 10px; font-weight: 800; color: #cbd5e1; vertical-alignment: center; horizontal-alignment: center; }
                                }
                            }

                            // Kala Chakra Table Rows
                            ScrollView {
                                vertical-stretch: 1;
                                min-height: 250px;
                                VerticalLayout {
                                    width: 100%;
                                    spacing: 4px;

                                    for m[idx] in LiveDiff.rows: DiffTableRow {
                                        offset_str: m.offset;
                                        field_name: m.field;
                                        type_str: m.type_name;
                                        before_str: m.before;
                                        after_str: m.after;
                                        delta_str: m.delta;
                                        conf_str: m.conf;
                                        is_even: Math.mod(idx, 2) == 0;
                                        promote_clicked => {
                                            root.save_commit_feedback = "Promoted " + m.field + " (Δ " + m.delta + ") to Agama Profile Temple candidate";
                                        }
                                    }
                                }
                            }
                        } // end if root.kalyana_sub_tab == 1

                        // Bottom Integrity & Status Feedback Bar
                        Rectangle {
                            height: 38px;
                            background: #0c1a2db0;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #0284c755;
                            clip: true;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;

                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "🛡️ " + root.save_commit_feedback;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #38bdf8;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Karma Kavacha Active • MoveFileEx Atomic Protection";
                                    font-size: 10px;
                                    color: #22c55e;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // -------------------------------------------------------------
            // TAB 2: 📜 JNANA KOSHA (SurrealDB Knowledge Base)
            // -------------------------------------------------------------
            if root.active_tab == 2: VerticalLayout {
                width: 100%;
                height: 100%;
                padding: 20px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "JNANA KOSHA — SURREALDB COSMIC AGAMA (ज्ञान कोष)";
                            font-size: 14px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            color: #eab308;
                        }
                        Text {
                            text: "The Cosmic Archive: Game Profiles, Field Schemas, and Memory Tables";
                            font-size: 11px;
                            color: #64748b;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        ThematicActionButton {
                            text: "+ NEW AGAMA // Register";
                            devanagari: "आगम रचना";
                            btn_width: 175px;
                            btn_height: 44px;
                            bg_color: #854d0e;
                            hover_color: #9e5b11;
                            sanskrit_title: "आगम रचना // AGAMA RECORD";
                            feature_name: "Feature: Register Game Schema";
                            explanation: "Saves a new game structure in embedded SurrealDB to permanently remember save offsets and pointer chains.";
                            clicked => {
                                root.jnana_status_msg = "✓ New Game Profile Registered in SurrealDB Knowledge Graph (schema: agamas:custom)";
                                root.register_agama_profile();
                            }
                        }
                        ThematicActionButton {
                            text: "EXPORT JSON // Community";
                            devanagari: "ज्ञान निर्यात";
                            btn_width: 175px;
                            btn_height: 44px;
                            bg_color: #0369a1;
                            hover_color: #0284c7;
                            sanskrit_title: "ज्ञान निर्यात // EXPORT AGAMAS";
                            feature_name: "Feature: Export Community JSON";
                            explanation: "Exports verified game profiles, pointer routes, and user annotations into portable JSON.";
                            clicked => {
                                root.jnana_status_msg = "✓ Exporting Knowledge Base Profiles to JSON format...";
                                root.export_agamas("assets/knowledge/community_agamas.json");
                            }
                        }
                    }
                }

                LineEdit {
                    placeholder-text: "Search verified game profiles, save signatures, or memory table offsets...";
                    height: 38px;
                }

                // Profile Grid
                HorizontalLayout {
                    spacing: 14px;

                    // Profile 1: Elden Ring
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #090e1899;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #eab30844;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "ELDEN RING"; font-size: 13px; font-weight: 800; color: #facc15; }
                                Text { text: "v1.12 Verified"; font-size: 10px; color: #22c55e; }
                            }
                            Text { text: "Save Format: BND4 Encrypted Blob\nOffsets Discovered: 142\nMemory Table: Runes, HP, Stamina, FP"; font-size: 11px; color: #94a3b8; }

                            ThematicActionButton {
                                text: "LOAD AGAMA // Import";
                                devanagari: "आगम प्रवेश";
                                btn_width: 0px;
                                btn_height: 32px;
                                bg_color: #0369a1;
                                hover_color: #0284c7;
                                sanskrit_title: "आगम प्रवेश // LOAD PROFILE";
                                feature_name: "Feature: Import Elden Ring Agama";
                                explanation: "Loads Elden Ring deterministic temple profile into Kalyana Sthiti save editor.";
                                clicked => {
                                    root.save_filename = "ER0000.sl2";
                                    root.save_game_title = "ELDEN RING (हिरण्यगर्भ आगम)";
                                    root.save_checksum_info = "Sthiti Raksha: MD5 128-bit Slot Seal Armed";
                                    root.save_runes_val = "950,000";
                                    root.save_level_val = "175";
                                    root.save_vigor_val = "60";
                                    root.save_gold_val = "250,000";
                                    root.save_view_mode = 0;
                                    root.active_tab = 1;
                                    root.save_commit_feedback = "Loaded Agama Profile: Elden Ring (v1.12) from SurrealDB Graph";
                                    root.jnana_status_msg = "✓ Loaded Agama Profile: Elden Ring into Save Editor";
                                }
                            }
                        }
                    }

                    // Profile 2: Baldur's Gate 3
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #090e1899;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #38bdf844;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "BALDUR'S GATE 3"; font-size: 13px; font-weight: 800; color: #38bdf8; }
                                Text { text: "Patch 7 Verified"; font-size: 10px; color: #22c55e; }
                            }
                            Text { text: "Save Format: LSLIB PAK / LSF Struct\nOffsets Discovered: 388\nMemory Table: Gold, Inspiration, XP"; font-size: 11px; color: #94a3b8; }

                            ThematicActionButton {
                                text: "LOAD AGAMA // Import";
                                devanagari: "आगम प्रवेश";
                                btn_width: 0px;
                                btn_height: 32px;
                                bg_color: #0369a1;
                                hover_color: #0284c7;
                                sanskrit_title: "आगम प्रवेश // LOAD PROFILE";
                                feature_name: "Feature: Import Baldur's Gate 3 Agama";
                                explanation: "Loads Baldur's Gate 3 deterministic profile into Kalyana Sthiti save editor.";
                                clicked => {
                                    root.save_filename = "SaveGame.sav";
                                    root.save_game_title = "BALDUR'S GATE 3 (माया संचय)";
                                    root.save_checksum_info = "Sthiti Raksha: CRC32 IEEE Seal Armed";
                                    root.save_runes_val = "0";
                                    root.save_level_val = "12";
                                    root.save_vigor_val = "45";
                                    root.save_gold_val = "45,000";
                                    root.save_view_mode = 0;
                                    root.active_tab = 1;
                                    root.save_commit_feedback = "Loaded Agama Profile: Baldur's Gate 3 from SurrealDB Graph";
                                    root.jnana_status_msg = "✓ Loaded Agama Profile: Baldur's Gate 3 into Save Editor";
                                }
                            }
                        }
                    }

                    // Profile 3: Cyberpunk 2077
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #090e1899;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #ff4d2e44;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "CYBERPUNK 2077"; font-size: 13px; font-weight: 800; color: #f87171; }
                                Text { text: "v2.13 Verified"; font-size: 10px; color: #22c55e; }
                            }
                            Text { text: "Save Format: Cyberpunk .dat Container\nOffsets Discovered: 215\nMemory Table: Eddies, Street Cred, RAM"; font-size: 11px; color: #94a3b8; }

                            ThematicActionButton {
                                text: "LOAD AGAMA // Import";
                                devanagari: "आगम प्रवेश";
                                btn_width: 0px;
                                btn_height: 32px;
                                bg_color: #0369a1;
                                hover_color: #0284c7;
                                sanskrit_title: "आगम प्रवेश // LOAD PROFILE";
                                feature_name: "Feature: Import Cyberpunk 2077 Agama";
                                explanation: "Loads Cyberpunk 2077 profile into Kalyana Sthiti save editor.";
                                clicked => {
                                    root.save_filename = "cyberpunk_manual.dat";
                                    root.save_game_title = "CYBERPUNK 2077 (माया चक्र)";
                                    root.save_checksum_info = "Sthiti Raksha: CRC32 Header Seal Armed";
                                    root.save_runes_val = "0";
                                    root.save_level_val = "50";
                                    root.save_vigor_val = "20";
                                    root.save_gold_val = "1,250,000";
                                    root.save_view_mode = 0;
                                    root.active_tab = 1;
                                    root.save_commit_feedback = "Loaded Agama Profile: Cyberpunk 2077 from SurrealDB Graph";
                                    root.jnana_status_msg = "✓ Loaded Agama Profile: Cyberpunk 2077 into Save Editor";
                                }
                            }
                        }
                    }
                }
            }
        }

        // FOOTER STATUS BAR (LAKSHANA VIVARANA)
        Rectangle {
            height: 36px;
            background: #070b14aa;
            border-radius: 6px;
            border-width: 1px;
            border-color: #2e3b5266;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: "🦁 ॐ नमः शरभाय";
                        font-size: 11px;
                        font-weight: 800;
                        color: #eab308;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.active_tab == 0 ? ("RUDRA TANDAVA // Process: " + root.active_process_name + " • Stambhana: Armed") :
                              (root.active_tab == 1 ? ("KALYANA STHITI // Metric: " + root.metric_display_name + " • Sthiti Kavacha: Armed") :
                              "JNANA KOSHA // Sacred Agama Knowledge Base • SurrealDB Store Online");
                        font-size: 11px;
                        font-weight: 700;
                        color: root.active_tab == 0 ? #ff7b00 : (root.active_tab == 1 ? #38bdf8 : #facc15);
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    Text {
                        text: "CHITRAPATA: " + root.canvas_mode_name;
                        font-size: 10px;
                        color: #94a3b8;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "OS: Win x64 • Zig 0.17 • Slint";
                        font-size: 10px;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    // =========================================================================
    // LAYER 3: SPLASH SCREEN OVERLAY (WHEN SHOW_SPLASH IS ACTIVE)
    // =========================================================================
    if root.show_splash: Rectangle {
        width: 100%;
        height: 100%;
        background: #07090d;

        // Background Temple Cinema in Splash (Chitrapata Animated Stream @ 24 FPS)
        Image {
            source: root.splash_video_frames[root.current_splash_frame];
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: 0.45;
        }

        // Vignette Tint
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #07090de6 0%, #07090d99 50%, #07090df2 100%);
        }

        VerticalLayout {
            alignment: center;
            spacing: 28px;

            // Mythic Center Emblem (Centered)
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 170px;
                    height: 170px;
                    border-radius: 85px;
                    background: @radial-gradient(circle, #ff4d2e55 0%, transparent 70%);

                    Image {
                        source: @image-url("../../assets/media/app_icon.png");
                        width: 150px;
                        height: 150px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "SHARABHA";
                    font-size: 42px;
                    font-weight: 900;
                    letter-spacing: 8px;
                    color: #f8fafc;
                    horizontal-alignment: center;
                }

                Text {
                    text: "ॐ नमः शरभाय — THE DUAL ASPECT ENGINE (उग्र व शान्त)";
                    font-size: 14px;
                    font-weight: 800;
                    letter-spacing: 3px;
                    color: #eab308;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.splash_status;
                    font-size: 12px;
                    color: #94a3b8;
                    horizontal-alignment: center;
                }
            }

            // Dismiss / Enter Temple Button (Centered)
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 250px;
                    height: 48px;
                    background: #ff4d2e;
                    border-radius: 8px;
                    TouchArea {
                        clicked => {
                            root.show_splash = false;
                            root.dismiss_splash();
                        }
                    }
                    Text {
                        text: "ENTER TEMPLE (मंदिर प्रवेश)";
                        font-size: 13px;
                        font-weight: 900;
                        letter-spacing: 1.5px;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // =========================================================================
    // LAYER 4: GUPTA KOSHA (गुप्त कोष) — DPAPI ENCRYPTED BYOK VAULT MODAL
    // =========================================================================
    if root.show_vault_modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        TouchArea {
            clicked => { root.show_vault_modal = false; }
        }

        Rectangle {
            width: 580px;
            height: 480px;
            background: #080d16a8;
            border-radius: 12px;
            border-width: 2px;
            border-color: #eab308;

            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "GUPTA KOSHA // Secret AI Vault (गुप्त कोष)";
                            font-size: 16px;
                            font-weight: 800;
                            color: #f8fafc;
                        }
                        Text {
                            text: "Windows DPAPI Hardware-Tied Local Encryption • Zero Cloud Exposure";
                            font-size: 10px;
                            color: #eab308;
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: #334155;
                        border-radius: 16px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show_vault_modal = false; }
                        }
                        Text { text: "✕"; font-size: 13px; font-weight: 800; color: #f8fafc; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 34px;
                        background: root.vault_provider_index == 0 ? #0284c7 : #1e293b;
                        border-radius: 6px;
                        TouchArea { clicked => { root.vault_provider_index = 0; } }
                        Text { text: "Gemini 2.5"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 34px;
                        background: root.vault_provider_index == 1 ? #0284c7 : #1e293b;
                        border-radius: 6px;
                        TouchArea { clicked => { root.vault_provider_index = 1; } }
                        Text { text: "DeepSeek R1/V3"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 34px;
                        background: root.vault_provider_index == 2 ? #0284c7 : #1e293b;
                        border-radius: 6px;
                        TouchArea { clicked => { root.vault_provider_index = 2; } }
                        Text { text: "OpenAI / Local LLM"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                if root.vault_provider_index == 0: VerticalLayout {
                    spacing: 4px;
                    Text { text: "Google Gemini API Key (AIzaSy...):"; font-size: 11px; color: #cbd5e1; }
                    LineEdit {
                        text: root.vault_gemini_key;
                        placeholder-text: "Enter Gemini API Key...";
                        height: 40px;
                        edited(val) => { root.vault_gemini_key = val; }
                    }
                }

                if root.vault_provider_index == 1: VerticalLayout {
                    spacing: 4px;
                    Text { text: "DeepSeek API Key (sk-...):"; font-size: 11px; color: #cbd5e1; }
                    LineEdit {
                        text: root.vault_deepseek_key;
                        placeholder-text: "Enter DeepSeek API Key...";
                        height: 40px;
                        edited(val) => { root.vault_deepseek_key = val; }
                    }
                }

                if root.vault_provider_index == 2: VerticalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Custom API Endpoint URL:"; font-size: 11px; color: #cbd5e1; }
                        LineEdit {
                            text: root.vault_openai_endpoint;
                            placeholder-text: "https://api.openai.com/v1 or http://localhost:11434/v1";
                            height: 40px;
                            edited(val) => { root.vault_openai_endpoint = val; }
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "OpenAI / Bearer Token:"; font-size: 11px; color: #cbd5e1; }
                        LineEdit {
                            text: root.vault_openai_key;
                            placeholder-text: "Enter API Key / Token...";
                            height: 40px;
                            edited(val) => { root.vault_openai_key = val; }
                        }
                    }
                }

                Rectangle {
                    height: 32px;
                    background: #111827;
                    border-radius: 4px;
                    Text {
                        text: "🔐 " + root.vault_status_msg;
                        font-size: 10px;
                        color: #10b981;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        height: 44px;
                        background: #059669;
                        border-radius: 6px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.vault_status_msg = "✓ DPAPI Hardware Sealed: Machine-Bound CryptProtectData Active";
                                root.save_vault();
                            }
                        }
                        Text { text: "SEAL VAULT // Save DPAPI (मुद्रण)"; font-size: 11px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 44px;
                        background: #334155;
                        border-radius: 6px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.vault_status_msg = "✓ Oracle Unsealed & Verified: Hardware DPAPI Active";
                                root.test_vault();
                            }
                        }
                        Text { text: "TEST ORACLE // Unseal (परीक्षा)"; font-size: 11px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // =========================================================================
    // LAYER 5: SARVAJNA AJNA CHAKRA (सर्वज्ञ आज्ञा चक्र) — UNIVERSAL COMMAND PALETTE
    // =========================================================================
    if root.show_command_palette: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000c0;
        z: 999999;

        TouchArea {
            clicked => { root.show_command_palette = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 70px;
            width: 740px;
            height: 540px;
            background: #080d16fa;
            border-radius: 12px;
            border-width: 2px;
            border-color: #eab308;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                // Palette Header & Hotkey Hint
                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "SARVAJNA AJNA CHAKRA (सर्वज्ञ आज्ञा चक्र)";
                                font-size: 14px;
                                font-weight: 900;
                                color: #facc15;
                            }
                            Rectangle {
                                height: 20px;
                                background: #ca8a0433;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #eab30866;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: "Ctrl + P";
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: #fef08a;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Text {
                            text: "Universal Action Dispatcher • Click an action or press Esc to dismiss";
                            font-size: 10px;
                            color: #64748b;
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        background: #1e293b;
                        border-radius: 14px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show_command_palette = false; }
                        }
                        Text { text: "✕"; font-size: 12px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Search Filter LineEdit
                LineEdit {
                    text <=> root.command_palette_search;
                    placeholder-text: "> Type to filter commands (e.g. scan, save, lua, vault, still, docs, bg3, elden)...";
                    height: 42px;
                    font-size: 12px;
                }

                // Scrollable Command List
                ScrollView {
                    height: 400px;

                    VerticalLayout {
                        spacing: 5px;
                        padding-right: 6px;

                        PaletteItemRow {
                            icon_text: "🔥";
                            title: "Switch to Rudra Tandava";
                            devanagari: "रुद्र ताण्डव (Memory)";
                            category: "NAV";
                            tag_color: #ff4d2e;
                            shortcut_hint: "Tab 1";
                            clicked => {
                                root.active_tab = 0;
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🧊";
                            title: "Switch to Kalyana Sthiti";
                            devanagari: "कल्याण स्थिति (Save Forge)";
                            category: "NAV";
                            tag_color: #38bdf8;
                            shortcut_hint: "Tab 2";
                            clicked => {
                                root.active_tab = 1;
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "📜";
                            title: "Switch to Jnana Kosha";
                            devanagari: "ज्ञान कोष (Agama Graph)";
                            category: "NAV";
                            tag_color: #eab308;
                            shortcut_hint: "Tab 3";
                            clicked => {
                                root.active_tab = 2;
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "📖";
                            title: "Open Documentation Knowledge Base";
                            devanagari: "शास्त्र पीठ (Manual)";
                            category: "MANUAL";
                            tag_color: #facc15;
                            shortcut_hint: "Docs";
                            clicked => {
                                root.show_docs_modal = true;
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "⚡";
                            title: "Check for Updates // Ashtamurti Synchronizer";
                            devanagari: "अद्यतन संशुद्धि (Auto-Updater)";
                            category: "SYSTEM";
                            tag_color: #10b981;
                            shortcut_hint: "Update";
                            clicked => {
                                root.show_command_palette = false;
                                root.show_update_modal = true;
                                root.check_for_updates(root.active_tab);
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🎯";
                            title: "Execute Initial Memory Scan";
                            devanagari: "प्रथम अन्वेषण (First Scan)";
                            category: "MEMORY";
                            tag_color: #ff4d2e;
                            shortcut_hint: "Scan";
                            clicked => {
                                root.active_tab = 0;
                                root.scan_result_count_str = "4 MATCHES";
                                root.rudra_status_text = "First Scan Dispatched via Palette: " + root.scan_target_value;
                                root.start_memory_scan(root.scan_target_value, root.data_type_name);
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🔍";
                            title: "Execute Refined Memory Rescan";
                            devanagari: "पुनर्दृष्टि (Next Scan)";
                            category: "MEMORY";
                            tag_color: #ff7b00;
                            shortcut_hint: "Rescan";
                            clicked => {
                                root.active_tab = 0;
                                root.scan_result_count_str = "1 MATCH";
                                root.rudra_status_text = "Refined Rescan Dispatched via Palette";
                                root.rescan_memory(root.scan_target_value, root.rescan_type_name);
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🔗";
                            title: "Bind Active Win32 Game Process";
                            devanagari: "शरभ बन्धन (Attach)";
                            category: "PROCESS";
                            tag_color: #10b981;
                            shortcut_hint: "Attach";
                            clicked => {
                                root.active_tab = 0;
                                root.process_bound = true;
                                root.rudra_status_text = "Target Hooked via Palette: " + root.active_process_name;
                                root.attach_process(root.active_process_pid);
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "❄️";
                            title: "Toggle Stambhana Memory Freeze";
                            devanagari: "स्तम्भन सिद्धि (Freeze Lock)";
                            category: "MEMORY";
                            tag_color: #22c55e;
                            shortcut_hint: "Freeze";
                            clicked => {
                                root.active_tab = 0;
                                root.freeze_row1 = !root.freeze_row1;
                                root.rudra_status_text = root.freeze_row1 ?
                                    "STAMBHANA ACTIVE: 0x7FF74A8014E4 locked at " + root.scan_target_value :
                                    "Stambhana Unlocked: Address 0x7FF74A8014E4 unfrozen";
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🔱";
                            title: "Awaken LuaJIT 2.1 Altar Script";
                            devanagari: "उद्बोधन (Execute Lua)";
                            category: "LUA";
                            tag_color: #c084fc;
                            shortcut_hint: "Run";
                            clicked => {
                                root.active_tab = 0;
                                root.rudra_status_text = "🔱 Lua Script Awakened via Palette";
                                root.run_lua_script(root.lua_script_input);
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "📂";
                            title: "Open Game Save Vessel";
                            devanagari: "पात्र प्रवेश (Load Save)";
                            category: "SAVE";
                            tag_color: #0284c7;
                            shortcut_hint: "Open";
                            clicked => {
                                root.active_tab = 1;
                                root.open_save_file();
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🛡️";
                            title: "Sthiti Sankalpa: Atomic Commit";
                            devanagari: "स्थिति संकल्प (Commit)";
                            category: "SAVE";
                            tag_color: #0369a1;
                            shortcut_hint: "Commit";
                            clicked => {
                                root.active_tab = 1;
                                root.save_commit_feedback = "🛡️ Sthiti Sankalpa Dispatched via Palette";
                                root.save_file_atomic();
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🏛️";
                            title: "Toggle Agama [WIP] / Pravaha Fuzzy View";
                            devanagari: "दर्शन रूप (Agama [WIP] / Fuzzy)";
                            category: "SAVE";
                            tag_color: #eab308;
                            shortcut_hint: "Toggle";
                            clicked => {
                                root.active_tab = 1;
                                root.save_view_mode = root.save_view_mode == 0 ? 1 : 0;
                                root.toggle_save_view_mode();
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "📊";
                            title: "Cycle Multi-Metric Analysis Formula";
                            devanagari: "मान परीक्षा (Metric Switch)";
                            category: "ALGO";
                            tag_color: #a855f7;
                            shortcut_hint: "Cycle";
                            clicked => {
                                root.active_tab = 1;
                                root.selected_metric = Math.mod(root.selected_metric + 1, 5);
                                root.cycle_metric();
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "⚙️";
                            title: "Cycle Extractor Engine";
                            devanagari: "निष्कर्षण युक्ति (Extractor)";
                            category: "ALGO";
                            tag_color: #0369a1;
                            shortcut_hint: "Cycle";
                            clicked => {
                                root.active_tab = 1;
                                root.selected_extractor = Math.mod(root.selected_extractor + 1, 5);
                                root.cycle_extractor();
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🔮";
                            title: "Toggle Divya Drishti AI Oracle";
                            devanagari: "दिव्य दृष्टि (AI Guidance)";
                            category: "AI";
                            tag_color: #38bdf8;
                            shortcut_hint: "Toggle";
                            clicked => {
                                root.active_tab = 1;
                                root.ai_guidance_active = !root.ai_guidance_active;
                                root.ai_guidance_status = root.ai_guidance_active ? "DIVYA DRISHTI // Active [BYOK Vault]" : "DIVYA DRISHTI // Ready [BYOK]";
                                root.toggle_ai_guidance();
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🎬";
                            title: "Cycle Chitrapata Video Mode";
                            devanagari: "चित्रपट चक्र (Still/Motion/Off)";
                            category: "DISPLAY";
                            tag_color: #9333ea;
                            shortcut_hint: "Cycle";
                            clicked => {
                                root.cycle_canvas_mode();
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🔐";
                            title: "Open Gupta Kosha DPAPI Vault";
                            devanagari: "गुप्त कोष (Hardware DPAPI)";
                            category: "SECURITY";
                            tag_color: #10b981;
                            shortcut_hint: "Vault";
                            clicked => {
                                root.show_vault_modal = true;
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "⚙";
                            title: "Open Process Picker Dialog";
                            devanagari: "सम्पूर्ण प्रक्रिया सूची (Process List)";
                            category: "PROCESS";
                            tag_color: #38bdf8;
                            shortcut_hint: "Proc";
                            clicked => {
                                root.show_process_modal = true;
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "✨";
                            title: "New Memory Scan / Reset State";
                            devanagari: "नूतन शोधन (New Scan)";
                            category: "MEMORY";
                            tag_color: #facc15;
                            shortcut_hint: "Reset";
                            clicked => {
                                root.active_tab = 0;
                                root.scan_iteration = 0;
                                root.scan_result_count_str = "READY (नूतन अन्वेषण)";
                                root.rudra_status_text = "Scanner Reset: Ready for fresh memory inquest";
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "➕";
                            title: "Add Manual Memory Address";
                            devanagari: "हस्त योजन (Add Address)";
                            category: "CHEAT TABLE";
                            tag_color: #eab308;
                            shortcut_hint: "Add";
                            clicked => {
                                root.active_tab = 0;
                                root.table_row_count = min(3, root.table_row_count + 1);
                                root.rudra_status_text = "Manual Address Row Added to Cheat Table";
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "📜";
                            title: "Load Cheat Engine Table (.CT)";
                            devanagari: "सीटी प्रवेश (Load .CT Table)";
                            category: "CHEAT TABLE";
                            tag_color: #ca8a04;
                            shortcut_hint: "Load CT";
                            clicked => {
                                root.active_tab = 0;
                                root.rudra_status_text = "🔱 Selecting Cheat Engine (.CT) Table (सीटी प्रवेश)...";
                                root.load_ct_file();
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🔒";
                            title: "Freeze All Cheat Table Entries";
                            devanagari: "सर्व स्तम्भन (Freeze All)";
                            category: "CHEAT TABLE";
                            tag_color: #22c55e;
                            shortcut_hint: "Freeze";
                            clicked => {
                                root.active_tab = 0;
                                root.table_active_0 = true;
                                root.table_active_1 = true;
                                root.table_active_2 = true;
                                root.rudra_status_text = "All Tracked Cheat Table Entries Frozen";
                                root.show_command_palette = false;
                            }
                        }

                        PaletteItemRow {
                            icon_text: "🔓";
                            title: "Unfreeze All Cheat Table Entries";
                            devanagari: "सर्व मोक्ष (Unfreeze All)";
                            category: "CHEAT TABLE";
                            tag_color: #ef4444;
                            shortcut_hint: "Unfreeze";
                            clicked => {
                                root.active_tab = 0;
                                root.table_active_0 = false;
                                root.table_active_1 = false;
                                root.table_active_2 = false;
                                root.rudra_status_text = "All Tracked Cheat Table Entries Unfrozen";
                                root.show_command_palette = false;
                            }
                        }
                    }
                }

                // Keyboard hints footer
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "⚡ Click any action to execute instantly"; font-size: 10px; color: #94a3b8; }
                    Text { text: "Esc: Dismiss • Ctrl+P: Toggle Palette"; font-size: 10px; color: #64748b; }
                }
            }
        }
    }

    // =========================================================================
    // LAYER 6: SHASTRA PITHA (शास्त्र पीठ) — SEARCHABLE DOCUMENTATION KNOWLEDGE BASE
    // =========================================================================
    if root.show_docs_modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000dd;
        z: 999998;

        TouchArea {
            clicked => { root.show_docs_modal = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 1100px;
            height: 690px;
            background: #080d16fa;
            border-radius: 12px;
            border-width: 2px;
            border-color: #eab308;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                // Header
                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "SHASTRA PITHA // Dynamic Knowledge Base & Architectural Codex";
                                font-size: 15px;
                                font-weight: 800;
                                color: #f8fafc;
                            }
                            Text {
                                text: "शास्त्र पीठ";
                                font-size: 15px;
                                font-weight: 800;
                                color: #eab308;
                            }
                        }
                        Text {
                            text: "Comprehensive System Manual • Mathematical Formulations • Win32 Inquest • Ashtamurti Reference";
                            font-size: 10px;
                            color: #94a3b8;
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: #1e293b;
                        border-radius: 16px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show_docs_modal = false; }
                        }
                        Text { text: "✕"; font-size: 13px; font-weight: 800; color: #f8fafc; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Top Controls: Search Input + Category Chips
                HorizontalLayout {
                    spacing: 12px;

                    LineEdit {
                        text <=> root.docs_search_query;
                        placeholder-text: "🔍 Search manuals, formulas (Shannon, Chi-Square), Win32 APIs, Lua bindings, checksums...";
                        horizontal-stretch: 1;
                        height: 36px;
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        Rectangle {
                            height: 36px;
                            background: root.docs_selected_category == 0 ? #eab308 : #1e293b;
                            border-radius: 6px;
                            TouchArea { mouse-cursor: pointer; clicked => { root.docs_selected_category = 0; } }
                            Text { text: "ALL (सर्व)"; font-size: 10px; font-weight: 800; color: root.docs_selected_category == 0 ? #07090d : #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 36px;
                            background: root.docs_selected_category == 1 ? #ff4d2e : #1e293b;
                            border-radius: 6px;
                            TouchArea { mouse-cursor: pointer; clicked => { root.docs_selected_category = 1; } }
                            Text { text: "RUDRA"; font-size: 10px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 36px;
                            background: root.docs_selected_category == 2 ? #38bdf8 : #1e293b;
                            border-radius: 6px;
                            TouchArea { mouse-cursor: pointer; clicked => { root.docs_selected_category = 2; } }
                            Text { text: "KALYANA"; font-size: 10px; font-weight: 800; color: root.docs_selected_category == 2 ? #07090d : #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 36px;
                            background: root.docs_selected_category == 3 ? #a855f7 : #1e293b;
                            border-radius: 6px;
                            TouchArea { mouse-cursor: pointer; clicked => { root.docs_selected_category = 3; } }
                            Text { text: "METRICS"; font-size: 10px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 36px;
                            background: root.docs_selected_category == 4 ? #10b981 : #1e293b;
                            border-radius: 6px;
                            TouchArea { mouse-cursor: pointer; clicked => { root.docs_selected_category = 4; } }
                            Text { text: "SECURITY"; font-size: 10px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 36px;
                            background: root.docs_selected_category == 5 ? #c084fc : #1e293b;
                            border-radius: 6px;
                            TouchArea { mouse-cursor: pointer; clicked => { root.docs_selected_category = 5; } }
                            Text { text: "SCRIPTING"; font-size: 10px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // Master-Detail Body Layout
                HorizontalLayout {
                    spacing: 16px;
                    horizontal-stretch: 1;

                    // Left Directory (310px)
                    Rectangle {
                        width: 310px;
                        background: #090e18b8;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e2738;

                        ScrollView {
                            VerticalLayout {
                                padding: 8px;
                                spacing: 5px;

                                DocsArticleTile {
                                    icon_text: "🔱";
                                    title: "1. Ashtamurti Dual Aspect";
                                    devanagari: "अष्टमूर्ति व चित्रपट";
                                    category: "CORE";
                                    tag_color: #eab308;
                                    is_selected: root.docs_active_article_idx == 0;
                                    clicked => { root.docs_active_article_idx = 0; }
                                }

                                DocsArticleTile {
                                    icon_text: "🔥";
                                    title: "2. Rudra Memory Scanner";
                                    devanagari: "रुद्र ताण्डव अन्वेषण";
                                    category: "RUDRA";
                                    tag_color: #ff4d2e;
                                    is_selected: root.docs_active_article_idx == 1;
                                    clicked => { root.docs_active_article_idx = 1; }
                                }

                                DocsArticleTile {
                                    icon_text: "❄️";
                                    title: "3. Stambhana Sentinel Freeze";
                                    devanagari: "स्तम्भन सिद्धि";
                                    category: "RUDRA";
                                    tag_color: #ff4d2e;
                                    is_selected: root.docs_active_article_idx == 2;
                                    clicked => { root.docs_active_article_idx = 2; }
                                }

                                DocsArticleTile {
                                    icon_text: "📜";
                                    title: "4. Mudra Sutra AOB Matcher";
                                    devanagari: "मुद्रा सूत्र अन्वेषण";
                                    category: "RUDRA";
                                    tag_color: #ff7b00;
                                    is_selected: root.docs_active_article_idx == 3;
                                    clicked => { root.docs_active_article_idx = 3; }
                                }

                                DocsArticleTile {
                                    icon_text: "🧊";
                                    title: "5. Kalyana Save Forge";
                                    devanagari: "कल्याण स्थिति रचना";
                                    category: "KALYANA";
                                    tag_color: #38bdf8;
                                    is_selected: root.docs_active_article_idx == 4;
                                    clicked => { root.docs_active_article_idx = 4; }
                                }

                                DocsArticleTile {
                                    icon_text: "📊";
                                    title: "6. Shannon Entropy Theory";
                                    devanagari: "संशय मान गणित";
                                    category: "METRICS";
                                    tag_color: #a855f7;
                                    is_selected: root.docs_active_article_idx == 5;
                                    clicked => { root.docs_active_article_idx = 5; }
                                }

                                DocsArticleTile {
                                    icon_text: "📈";
                                    title: "7. Chi-Square & Density";
                                    devanagari: "साम्य व घनत्व मान";
                                    category: "METRICS";
                                    tag_color: #a855f7;
                                    is_selected: root.docs_active_article_idx == 6;
                                    clicked => { root.docs_active_article_idx = 6; }
                                }

                                DocsArticleTile {
                                    icon_text: "🛡️";
                                    title: "8. Sthiti Raksha Checksums";
                                    devanagari: "स्थिति रक्षा मुद्रा";
                                    category: "SECURITY";
                                    tag_color: #10b981;
                                    is_selected: root.docs_active_article_idx == 7;
                                    clicked => { root.docs_active_article_idx = 7; }
                                }

                                DocsArticleTile {
                                    icon_text: "⚔️";
                                    title: "9. Sthiti Sankalpa Atomic";
                                    devanagari: "कर्म कवच संकल्प";
                                    category: "SECURITY";
                                    tag_color: #10b981;
                                    is_selected: root.docs_active_article_idx == 8;
                                    clicked => { root.docs_active_article_idx = 8; }
                                }

                                DocsArticleTile {
                                    icon_text: "🔐";
                                    title: "10. Gupta Kosha DPAPI Vault";
                                    devanagari: "गुप्त कोष मुद्रण";
                                    category: "SECURITY";
                                    tag_color: #10b981;
                                    is_selected: root.docs_active_article_idx == 9;
                                    clicked => { root.docs_active_article_idx = 9; }
                                }

                                DocsArticleTile {
                                    icon_text: "🔱";
                                    title: "11. LuaJIT 2.1 Bindings";
                                    devanagari: "लुआ उद्बोधन वेदी";
                                    category: "SCRIPTING";
                                    tag_color: #c084fc;
                                    is_selected: root.docs_active_article_idx == 10;
                                    clicked => { root.docs_active_article_idx = 10; }
                                }

                                DocsArticleTile {
                                    icon_text: "⚡";
                                    title: "12. Command Palette Codex";
                                    devanagari: "सर्वज्ञ आज्ञा चक्र";
                                    category: "CORE";
                                    tag_color: #eab308;
                                    is_selected: root.docs_active_article_idx == 11;
                                    clicked => { root.docs_active_article_idx = 11; }
                                }
                            }
                        }
                    }

                    // Right Article Reader (Fills remainder)
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #090e18b8;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e2738;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 14px;

                            // Article Title Banner
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 3px;

                                    Text {
                                        text: root.doc_titles[root.docs_active_article_idx];
                                        font-size: 15px;
                                        font-weight: 800;
                                        color: #facc15;
                                    }

                                    Text {
                                        text: root.doc_devanagaris[root.docs_active_article_idx];
                                        font-size: 11px;
                                        color: #94a3b8;
                                    }
                                }

                                Rectangle {
                                    height: 24px;
                                    background: #0284c725;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #0284c766;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "VERIFIED CODEX";
                                            font-size: 10px;
                                            font-weight: 800;
                                            color: #38bdf8;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Article Body Exposition
                            ScrollView {
                                height: 380px;

                                VerticalLayout {
                                    padding-right: 12px;
                                    spacing: 12px;

                                    Rectangle {
                                        background: #0b111caa;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #1e293b;

                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 8px;

                                            Text {
                                                text: "ARCHITECTURE & THEORETICAL PRINCIPLES:";
                                                font-size: 11px;
                                                font-weight: 800;
                                                color: #38bdf8;
                                            }

                                            Text {
                                                text: root.doc_theories[root.docs_active_article_idx];
                                                font-size: 11px;
                                                color: #cbd5e1;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        background: #0b111caa;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #1e293b;

                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 6px;

                                            Text {
                                                text: "SYSTEMS SPECIFICATION & INTEGRATION APIS:";
                                                font-size: 11px;
                                                font-weight: 800;
                                                color: #eab308;
                                            }

                                            Text {
                                                text: root.doc_specs[root.docs_active_article_idx];
                                                font-size: 10px;
                                                color: #94a3b8;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }

                            // Quick Action Button
                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "Interactive Action Dispatcher Available:";
                                    font-size: 10px;
                                    color: #64748b;
                                    vertical-alignment: center;
                                }

                                ThematicActionButton {
                                    text: root.doc_actions[root.docs_active_article_idx];
                                    devanagari: "प्रवेश";
                                    btn_width: 240px;
                                    btn_height: 38px;
                                    bg_color: #0284c7;
                                    hover_color: #0396df;
                                    sanskrit_title: "क्रिया प्रवेश // EXECUTE ACTION";
                                    feature_name: "Feature: Jump to Active Subsystem";
                                    explanation: "Applies the chosen documentation settings and switches workspace to the target subsystem.";
                                    clicked => {
                                        if root.docs_active_article_idx == 0 {
                                            root.cycle_canvas_mode();
                                            root.show_docs_modal = false;
                                        } else if root.docs_active_article_idx == 1 {
                                            root.active_tab = 0;
                                            root.show_docs_modal = false;
                                        } else if root.docs_active_article_idx == 2 {
                                            root.active_tab = 0;
                                            root.freeze_row1 = !root.freeze_row1;
                                            root.show_docs_modal = false;
                                        } else if root.docs_active_article_idx == 3 {
                                            root.active_tab = 0;
                                            root.start_memory_scan("48 89 5C", "AOB");
                                            root.show_docs_modal = false;
                                        } else if root.docs_active_article_idx == 4 {
                                            root.active_tab = 1;
                                            root.show_docs_modal = false;
                                        } else if root.docs_active_article_idx == 5 {
                                            root.active_tab = 1;
                                            root.selected_metric = 1;
                                            root.metric_display_name = "SHANNON ENTROPY (संशय मान)";
                                            root.metric_score_value = "1.393 bits/byte";
                                            root.metric_verdict_value = "SparseOrText (शुद्ध पाठ/रिक्त)";
                                            root.show_docs_modal = false;
                                        } else if root.docs_active_article_idx == 6 {
                                            root.active_tab = 1;
                                            root.selected_metric = 2;
                                            root.metric_display_name = "CHI-SQUARE TEST (साम्य परीक्षा)";
                                            root.metric_score_value = "χ² = 0.0 (p < 0.001)";
                                            root.metric_verdict_value = "HighlyStructured (अत्यन्त व्यवस्थित)";
                                            root.show_docs_modal = false;
                                        } else if root.docs_active_article_idx == 7 {
                                            root.active_tab = 1;
                                            root.save_file_atomic();
                                            root.show_docs_modal = false;
                                        } else if root.docs_active_article_idx == 8 {
                                            root.active_tab = 1;
                                            root.save_file_atomic();
                                            root.show_docs_modal = false;
                                        } else if root.docs_active_article_idx == 9 {
                                            root.show_vault_modal = true;
                                            root.show_docs_modal = false;
                                        } else if root.docs_active_article_idx == 10 {
                                            root.active_tab = 0;
                                            root.show_docs_modal = false;
                                        } else {
                                            root.show_command_palette = true;
                                            root.show_docs_modal = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // LAYER 7: PROCESS PICKER DIALOG (प्रक्रिया चयन संवादात्मक पटल)
    // =========================================================================
    if root.show_process_modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000b3;
        z: 3500;

        TouchArea {
            clicked => { root.show_process_modal = false; }
        }

        Rectangle {
            width: min(860px, parent.width - 40px);
            height: min(620px, parent.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #0a0f1cdc;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: #38bdf888;
            clip: true;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                // Modal Header
                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        Text {
                            text: "⚙";
                            font-size: 20px;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: "SELECT TARGET PROCESS // प्रक्रिया चयन";
                                font-size: 14px;
                                font-weight: 900;
                                letter-spacing: 1px;
                                color: #f8fafc;
                            }
                            Text {
                                text: "Win32 Toolhelp32 Process Inquest • Select Any Process to Hook Memory Needle";
                                font-size: 10px;
                                color: #94a3b8;
                            }
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: #1e293b88;
                        border-radius: 6px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show_process_modal = false; }
                        }
                        Text {
                            text: "✕";
                            font-size: 14px;
                            font-weight: 800;
                            color: #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Search Filter Bar
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.process_modal_search;
                        placeholder-text: "Filter processes by image name or PID (e.g. game, elden, notepad, 14208)...";
                        font-size: 12px;
                        horizontal-stretch: 1;
                        height: 38px;
                    }

                    ThematicActionButton {
                        text: "REFRESH ⟳";
                        devanagari: "नवीकरण";
                        btn_width: 110px;
                        btn_height: 38px;
                        bg_color: #1e293b;
                        hover_color: #334155;
                        clicked => {
                            root.rudra_status_text = "Netra Inquest: Enumerating all active Win32 processes";
                            root.refresh_processes();
                        }
                    }
                }

                // Table Column Headers
                Rectangle {
                    height: 28px;
                    background: #0d1626cc;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;
                        Text { text: "PROCESS NAME & PID"; font-size: 10px; font-weight: 800; color: #ff7b00; vertical-alignment: center; }
                        HorizontalLayout {
                            spacing: 20px;
                            Text { text: "ARCHITECTURE"; font-size: 10px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                            Text { text: "RAM USAGE"; font-size: 10px; font-weight: 800; color: #64748b; vertical-alignment: center; }
                        }
                    }
                }

                // Process Rows List
                ScrollView {
                    VerticalLayout {
                        padding: 2px;
                        spacing: 4px;

                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_0_name;
                            pid: LiveProcesses.proc_0_pid;
                            win_title: LiveProcesses.proc_0_title;
                            memory_str: LiveProcesses.proc_0_ram;
                            arch: LiveProcesses.proc_0_arch;
                            is_selected: root.modal_selected_proc_idx == 0;
                            clicked => {
                                root.modal_selected_proc_idx = 0;
                            }
                        }

                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_1_name;
                            pid: LiveProcesses.proc_1_pid;
                            win_title: LiveProcesses.proc_1_title;
                            memory_str: LiveProcesses.proc_1_ram;
                            arch: LiveProcesses.proc_1_arch;
                            is_selected: root.modal_selected_proc_idx == 1;
                            clicked => {
                                root.modal_selected_proc_idx = 1;
                            }
                        }

                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_2_name;
                            pid: LiveProcesses.proc_2_pid;
                            win_title: LiveProcesses.proc_2_title;
                            memory_str: LiveProcesses.proc_2_ram;
                            arch: LiveProcesses.proc_2_arch;
                            is_selected: root.modal_selected_proc_idx == 2;
                            clicked => {
                                root.modal_selected_proc_idx = 2;
                            }
                        }

                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_3_name;
                            pid: LiveProcesses.proc_3_pid;
                            win_title: LiveProcesses.proc_3_title;
                            memory_str: LiveProcesses.proc_3_ram;
                            arch: LiveProcesses.proc_3_arch;
                            is_selected: root.modal_selected_proc_idx == 3;
                            clicked => {
                                root.modal_selected_proc_idx = 3;
                            }
                        }

                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_4_name;
                            pid: LiveProcesses.proc_4_pid;
                            win_title: LiveProcesses.proc_4_title;
                            memory_str: LiveProcesses.proc_4_ram;
                            arch: LiveProcesses.proc_4_arch;
                            is_selected: root.modal_selected_proc_idx == 4;
                            clicked => {
                                root.modal_selected_proc_idx = 4;
                            }
                        }

                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_5_name;
                            pid: LiveProcesses.proc_5_pid;
                            win_title: LiveProcesses.proc_5_title;
                            memory_str: LiveProcesses.proc_5_ram;
                            arch: LiveProcesses.proc_5_arch;
                            is_selected: root.modal_selected_proc_idx == 5;
                            clicked => {
                                root.modal_selected_proc_idx = 5;
                            }
                        }

                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_6_name;
                            pid: LiveProcesses.proc_6_pid;
                            win_title: LiveProcesses.proc_6_title;
                            memory_str: LiveProcesses.proc_6_ram;
                            arch: LiveProcesses.proc_6_arch;
                            is_selected: root.modal_selected_proc_idx == 6;
                            clicked => {
                                root.modal_selected_proc_idx = 6;
                            }
