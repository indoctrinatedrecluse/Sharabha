    ];

    in-out property <int> current_loop_frame: 0;
    in-out property <int> current_splash_frame: 0;

    // Zero-overhead GPU Frame Timers: idle at 0.0% CPU when not playing
    chitrapata_timer := Timer {
        interval: 42ms; // 24 FPS hardware-accelerated video loop
        running: root.canvas_mode == 1;
        triggered() => {
            root.current_loop_frame = Math.mod(root.current_loop_frame + 1, 239);
        }
    }

    splash_video_timer := Timer {
        interval: 42ms; // 24 FPS splash cinema
        running: root.show_splash;
        triggered() => {
            root.current_splash_frame = Math.mod(root.current_splash_frame + 1, 143);
        }
    }


    // Rudra Tandava Interactive State
    in-out property <int> active_process_pid: 14208;
    in-out property <int> selected_process_idx: 0;
    in-out property <bool> process_bound: false;
    in-out property <string> process_bind_status: "STANDBY // Unattached";
    in-out property <string> scan_target_value: "100";
    in-out property <string> scan_result_count_str: "4 MATCHES";
    in-out property <bool> freeze_row1: false;
    in-out property <bool> freeze_row2: false;
    in-out property <string> rudra_status_text: "Win32 Netra Active // Ready for Inquest";

    // Kalyana Sthiti Interactive State
    in-out property <int> current_save_idx: 0;
    in-out property <string> save_commit_feedback: "Sthiti Kavacha Active: Ready to Commit";

    // Jnana Kosha Interactive State
    in-out property <string> jnana_status_msg: "SurrealDB Embedded Knowledge Graph Online";
    in-out property <string> jnana_search_query: "";

    // Engine State Properties
    in-out property <int> selected_scan_type: 0;
    in-out property <string> scan_type_name: "EXACT (सटीक मान)";
    in-out property <int> selected_data_type: 0;
    in-out property <string> data_type_name: "Type: i32";

    in-out property <int> selected_metric: 0;
    in-out property <string> metric_display_name: "AUTO-DETECT (सर्वज्ञ मान)";
    in-out property <string> metric_score_value: "4.812 bits/byte";
    in-out property <string> metric_verdict_value: "StructuredBinary (प्रपत्र)";
    in-out property <string> container_sig_value: "RawCustomBinary (द्वि-आधारी)";

    in-out property <int> selected_extractor: 0;
    in-out property <string> extractor_display_name: "AUTO HEURISTIC (स्वयंसिद्ध)";

    in-out property <bool> ai_guidance_active: false;
    in-out property <string> ai_guidance_status: "DIVYA DRISHTI // Ready [BYOK]";

    // Vault Modal State
    in-out property <bool> show_vault_modal: false;
    in-out property <int> vault_provider_index: 0;
    in-out property <string> vault_gemini_key: "";
    in-out property <string> vault_deepseek_key: "";
    in-out property <string> vault_openai_endpoint: "https://api.openai.com/v1";
    in-out property <string> vault_openai_key: "";
    in-out property <string> vault_status_msg: "DPAPI Encrypted Vault Ready (मुद्रित)";

    // Dual-Mode Save Editor Properties (Agama vs. Pravaha)
    in-out property <int> save_view_mode: 0; // 0=Agama Deterministic, 1=Pravaha Fuzzy Raw Table
    in-out property <string> save_game_title: "ELDEN RING (हिरण्यगर्भ आगम)";
    in-out property <string> save_filename: "ER0000.sl2";
    in-out property <string> save_checksum_info: "Sthiti Raksha: MD5 128-bit Slot Seal Armed";
    in-out property <string> save_runes_val: "950,000";
    in-out property <string> save_level_val: "175";
    in-out property <string> save_vigor_val: "60";
    in-out property <string> save_gold_val: "250,000";

    // Interactive Lua Altar Properties
    in-out property <string> lua_script_input: "sharabha.write_u32(0x7FF74A8014E4, 999999); print('Mudra Awakened!')";
    in-out property <string> lua_status_msg: "LuaJIT 2.1 Ashtamurti Ready // Memory Inquest Armed";

    // Callbacks to Zig core
    callback refresh_processes();
    callback attach_process(int);
    callback start_memory_scan(string, string);
    callback rescan_memory(string);
    callback cycle_scan_type();
    callback cycle_data_type();
    callback open_save_file();
    callback execute_fuzzy_parse();
    callback cycle_metric();
    callback cycle_extractor();
    callback toggle_ai_guidance();
    callback save_file_atomic();
    callback dismiss_splash();
    callback save_vault();
    callback test_vault();
    callback cycle_canvas_mode();
    callback toggle_save_view_mode();
    callback run_lua_script(string);

    // =========================================================================
    // LAYER 1: AMBIENT CANVAS BACKGROUND (SACRED ALTAR STILL / ANIMATED LOOP)
    // =========================================================================
    Rectangle {
        width: 100%;
        height: 100%;
        background: #040609;

        // Mode 0: Sacred Altar Still Inscription (Fixed)
        if root.canvas_mode == 0: Image {
            source: @image-url("../../assets/media/bg_canvas_fallback.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.canvas_opacity;
        }

        // Mode 1: Animated Motion Video Loop (Chitrapata Active Stream @ 24 FPS)
        if root.canvas_mode == 1: Image {
            source: root.chitrapata_frames[root.current_loop_frame];
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.canvas_opacity;
        }

        // Mode 1: Animated Loop / Active Motion Flares
        if root.canvas_mode == 1: Rectangle {
            width: 100%;
            height: 100%;

            Rectangle {
                x: parent.width * 0.05;
                y: parent.height * 0.08;
                width: 600px;
                height: 600px;
                border-radius: 300px;
                background: @radial-gradient(circle, #ff4d2e28 0%, transparent 70%);
            }

            Rectangle {
                x: parent.width * 0.60;
                y: parent.height * 0.25;
                width: 700px;
                height: 700px;
                border-radius: 350px;
                background: @radial-gradient(circle, #0ea5e928 0%, transparent 70%);
            }
        }

        // Gentle vignette to maintain perfect contrast with text
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #07090d50 0%, #07090d20 50%, #07090d70 100%);
        }
    }

    // =========================================================================
    // LAYER 2: MAIN WORKSPACE INTERFACE
    // =========================================================================
    if !root.show_splash: VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // TOP HEADER BAR: Trishula Logo & Aspect Selector (Frosted Glass, High-Z)
        Rectangle {
            height: 68px;
            background: #070b14b0;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: #2e3b5288;
            clip: false;
            z: 1000;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                // Logo & Motto (Responsive & Compact)
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    Image {
                        source: @image-url("../../assets/media/app_icon.png");
                        width: 38px;
                        height: 38px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "SHARABHA";
                                font-size: 18px;
                                font-weight: 900;
                                letter-spacing: 1.5px;
                                color: #f8fafc;
                            }
                            Text {
                                text: "शरभ";
                                font-size: 15px;
                                font-weight: 800;
                                color: #eab308;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Dual Aspect Tool // Sharabha Avatar";
                            font-size: 10px;
                            color: #64748b;
                        }
                    }
                }

                // Aspect Tabs
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    TabButton {
                        title: "RUDRA (रुद्र)";
                        subtitle: "Memory Engine";
                        icon_text: "🔥";
                        is_active: root.active_tab == 0;
                        active_color: #ff4d2e;
                        sanskrit_title: "रुद्र ताण्डव // RUDRA TANDAVA";
                        feature_name: "Aspect: Memory Penetration & Needle Injection";
                        explanation: "Win32 process attachment, SIMD memory scanning, variable freezing, and live code injection.";
                        clicked => { root.active_tab = 0; }
                    }

                    TabButton {
                        title: "KALYANA (कल्याण)";
                        subtitle: "Save Forge";
                        icon_text: "🧊";
                        is_active: root.active_tab == 1;
                        active_color: #38bdf8;
                        sanskrit_title: "कल्याण स्थिति // KALYANA STHITI";
                        feature_name: "Aspect: Universal Heuristic Save Editor";
                        explanation: "Shannon entropy inference, candidate string/numeric table extraction, and atomic safe write.";
                        clicked => { root.active_tab = 1; }
                    }

                    TabButton {
                        title: "JNANA (ज्ञान)";
                        subtitle: "Agama Graph";
                        icon_text: "📜";
                        is_active: root.active_tab == 2;
                        active_color: #eab308;
                        sanskrit_title: "ज्ञान कोष // JNANA KOSHA";
                        feature_name: "Aspect: Embedded SurrealDB Knowledge Graph";
                        explanation: "Stores verified game save structures, format headers, and memory pointer tables.";
                        clicked => { root.active_tab = 2; }
                    }

                    // Ambient Canvas Switcher (Downwards & Right-Aligned Tooltip)
                    ThematicActionButton {
                        text: "CANVAS";
                        devanagari: root.canvas_opacity_label;
                        btn_width: 125px;
                        btn_height: 42px;
                        bg_color: root.canvas_mode == 0 ? #0369a1 : (root.canvas_mode == 1 ? #6d28d9 : #1e293b);
                        hover_color: #38bdf8;
                        tooltip_down: true;
                        tooltip_right_align: true;
                        sanskrit_title: "चित्रपट वेदी // SACRED CANVAS";
                        feature_name: "Feature: Altar Canvas & Loop Switcher";
                        explanation: "Toggles between Sacred Altar Still (bg_canvas_fallback.jpg), Animated Motion Loop, and Minimal Obsidian with translucency tuning.";
                        clicked => {
                            if root.canvas_mode == 0 {
                                root.canvas_mode = 1;
                                root.canvas_mode_name = "ANIMATED LOOP (सजीव चित्रपट)";
                                root.canvas_opacity = 0.92;
                                root.canvas_opacity_label = "LOOP 92%";
                            } else if root.canvas_mode == 1 {
                                root.canvas_mode = 2;
                                root.canvas_mode_name = "MINIMAL OBSIDIAN (निराकार)";
                                root.canvas_opacity = 0.10;
                                root.canvas_opacity_label = "OFF 10%";
                            } else {
                                root.canvas_mode = 0;
                                root.canvas_mode_name = "SACRED ALTAR (स्थिर वेदी)";
                                root.canvas_opacity = 0.88;
                                root.canvas_opacity_label = "ALTAR 88%";
                            }
                            root.cycle_canvas_mode();
                        }
                    }

                    // Vault Button (Downwards & Right-Aligned Tooltip)
                    ThematicActionButton {
                        text: "VAULT";
                        devanagari: "गुप्त कोष (BYOK)";
                        btn_width: 130px;
                        btn_height: 42px;
                        bg_color: #1e293b;
                        hover_color: #334155;
                        tooltip_down: true;
                        tooltip_right_align: true;
                        sanskrit_title: "गुप्त कोष // SECURE VAULT";
                        feature_name: "Feature: Windows DPAPI Encrypted Vault";
                        explanation: "Encrypted BYOK storage for Gemini, DeepSeek, and OpenAI-compatible API keys via local Windows DPAPI.";
                        clicked => { root.show_vault_modal = !root.show_vault_modal; }
                    }
                }
            }
        }

        // BODY WORKSPACE CONTAINER (Frosted Glass)
        Rectangle {
            background: #05080f70;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: #1e293b88;

            // -------------------------------------------------------------
            // TAB 0: 🔥 RUDRA ENGINE (Memory Scanner & Injection)
            // -------------------------------------------------------------
            if root.active_tab == 0: HorizontalLayout {
                padding: 16px;
                spacing: 12px;

                // Process Selector Panel (Resizable)
                Rectangle {
                    width: root.rudra_left_width;
                    background: #090e1899;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #243048aa;
                    z: 50;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "DARSHANA & BANDHANA (दर्शन व बन्धन)";
                                font-size: 11px;
                                font-weight: 800;
                                letter-spacing: 0.5px;
                                color: #ff4d2e;
                            }
                            Text {
                                text: "Win32 Netra";
                                font-size: 10px;
                                color: #64748b;
                            }
                        }

                        LineEdit {
                            placeholder-text: "Filter process name or PID (e.g. game.exe)...";
                            height: 36px;
                        }

                        // Active Process Mock List
                        Rectangle {
                            background: #080d16a8;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                Rectangle {
                                    height: 36px;
                                    background: root.selected_process_idx == 0 ? #1e293ecc : #00000000;
                                    border-radius: 4px;
                                    border-width: root.selected_process_idx == 0 ? 1px : 0px;
                                    border-color: #ff7b00;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_process_idx = 0;
                                            root.active_process_name = "GameProcess.exe [PID 14208]";
                                            root.active_process_pid = 14208;
                                            root.process_bound = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;
                                        Text { text: "GameProcess.exe"; font-size: 11px; font-weight: 700; color: #f8fafc; vertical-alignment: center; }
                                        Text { text: "PID 14208 [x64]"; font-size: 10px; color: #ff7b00; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 36px;
                                    background: root.selected_process_idx == 1 ? #1e293ecc : #00000000;
                                    border-radius: 4px;
                                    border-width: root.selected_process_idx == 1 ? 1px : 0px;
                                    border-color: #ff7b00;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_process_idx = 1;
                                            root.active_process_name = "eldenring.exe [PID 8832]";
                                            root.active_process_pid = 8832;
                                            root.process_bound = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;
                                        Text { text: "eldenring.exe"; font-size: 11px; color: #f8fafc; vertical-alignment: center; }
                                        Text { text: "PID 8832 [x64]"; font-size: 10px; color: #ff7b00; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 36px;
                                    background: root.selected_process_idx == 2 ? #1e293ecc : #00000000;
                                    border-radius: 4px;
                                    border-width: root.selected_process_idx == 2 ? 1px : 0px;
                                    border-color: #ff7b00;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected_process_idx = 2;
                                            root.active_process_name = "Cyberpunk2077.exe [PID 22910]";
                                            root.active_process_pid = 22910;
                                            root.process_bound = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;
                                        Text { text: "Cyberpunk2077.exe"; font-size: 11px; color: #f8fafc; vertical-alignment: center; }
                                        Text { text: "PID 22910 [x64]"; font-size: 10px; color: #ff7b00; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Attach Button (Dynamic width - stretches with splitter)
                        ThematicActionButton {
                            text: root.process_bound ? "✓ BOUND // Attached" : "BIND PROCESS // Attach";
                            devanagari: root.process_bound ? "बद्ध प्रक्रिया" : "शरभ बन्धन";
                            btn_width: 0px;
                            btn_height: 44px;
                            bg_color: root.process_bound ? #15803d : #ff4d2e;
                            hover_color: root.process_bound ? #16a34a : #ff6548;
                            tooltip_down: true;
                            sanskrit_title: "शरभ बन्धन // PROCESS BINDING";
                            feature_name: "Feature: OpenProcess Memory Handle";
                            explanation: "Opens a full-access Win32 process handle (VM_READ | VM_WRITE) to attach hooks and scanner needles.";
                            clicked => {
                                root.process_bound = true;
                                root.process_bind_status = "BOUND // Armed [VM_READ | VM_WRITE]";
                                root.rudra_status_text = "Target Hooked: " + root.active_process_name + " • VM Ready";
                                root.attach_process(root.active_process_pid);
                            }
                        }
                    }
                }

                // Interactive Splitter Divider (Click & Drag to resize)
                Rectangle {
                    width: 8px;
                    background: splitter_rudra.has_hover ? #ff4d2e : #1e2738aa;
                    border-radius: 4px;
                    splitter_rudra := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            root.rudra_left_width = max(220px, min(parent.width - 400px, root.rudra_left_width + (self.mouse-x - self.pressed-x)));
                        }
                    }
                }

                // Memory Scanner & Match Results Panel (Fills remainder)
                Rectangle {
                    horizontal-stretch: 1;
                    background: #090e1899;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #243048aa;
                    z: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // Scan Control Bar (Fully Responsive with horizontal-stretch)
                        HorizontalLayout {
                            spacing: 8px;

                            LineEdit {
                                text <=> root.scan_target_value;
                                placeholder-text: "Target value (e.g. 500, 999999)...";
                                horizontal-stretch: 3;
                                min-width: 130px;
                                height: 42px;
                            }

                            // Scan Mode Cycle Selector (Exact, Increased, Decreased, Changed, Unchanged)
                            Rectangle {
                                horizontal-stretch: 2;
                                min-width: 120px;
                                height: 42px;
                                background: #162032b8;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2e3b52;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected_scan_type = Math.mod(root.selected_scan_type + 1, 5);
                                        if root.selected_scan_type == 0 {
                                            root.scan_type_name = "EXACT (सटीक मान)";
                                        } else if root.selected_scan_type == 1 {
                                            root.scan_type_name = "INCREASED (वर्धित)";
                                        } else if root.selected_scan_type == 2 {
                                            root.scan_type_name = "DECREASED (ह्रासित)";
                                        } else if root.selected_scan_type == 3 {
                                            root.scan_type_name = "CHANGED (परिवर्तित)";
                                        } else {
                                            root.scan_type_name = "UNCHANGED (अपरिवर्तित)";
                                        }
                                        root.cycle_scan_type();
                                    }
                                }
                                Text {
                                    text: root.scan_type_name;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #ff7b00;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            // Data Type Cycle Selector (i32, u32, i64, u64, f32, f64, Text)
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 80px;
                                height: 42px;
                                background: #162032b8;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2e3b52;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected_data_type = Math.mod(root.selected_data_type + 1, 6);
                                        if root.selected_data_type == 0 {
                                            root.data_type_name = "Type: i32";
                                        } else if root.selected_data_type == 1 {
                                            root.data_type_name = "Type: u32";
                                        } else if root.selected_data_type == 2 {
                                            root.data_type_name = "Type: i64";
                                        } else if root.selected_data_type == 3 {
                                            root.data_type_name = "Type: f32";
                                        } else if root.selected_data_type == 4 {
                                            root.data_type_name = "Type: f64";
                                        } else {
                                            root.data_type_name = "Type: Text";
                                        }
                                        root.cycle_data_type();
                                    }
                                }
                                Text {
                                    text: root.data_type_name;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            ThematicActionButton {
                                text: "FIRST SCAN (प्रथम)";
                                devanagari: "सकल अन्वेषण";
                                horizontal-stretch: 2;
                                btn_width: 0px;
                                btn_height: 42px;
                                bg_color: #ff4d2e;
                                hover_color: #ff6548;
                                tooltip_down: true;
                                sanskrit_title: "प्रथम दृष्टि // FIRST INQUEST";
                                feature_name: "Feature: Initial RAM Value Scanner";
                                explanation: "Queries VirtualQueryEx for committed writable pages and scans entire address space for the target value.";
                                clicked => {
                                    root.scan_result_count_str = "4 MATCHES";
                                    root.rudra_status_text = "First Scan Complete: 4 occurrences of '" + root.scan_target_value + "' found";
                                    root.start_memory_scan(root.scan_target_value, root.data_type_name);
                                }
                            }

                            ThematicActionButton {
                                text: "NEXT SCAN (पुनः)";
                                devanagari: "परिशोधन";
                                horizontal-stretch: 2;
                                btn_width: 0px;
                                btn_height: 42px;
                                bg_color: #242e42;
                                hover_color: #2e3b54;
                                tooltip_down: true;
                                sanskrit_title: "पुनर्दृष्टि // REFINED INQUEST";
                                feature_name: "Feature: Next Scan Address Filter";
                                explanation: "Re-reads only previously matched memory locations to isolate values that changed, increased, or stayed exact.";
                                clicked => {
                                    root.scan_result_count_str = "1 MATCH";
                                    root.rudra_status_text = "Refined Scan Complete: Isolated to 0x7FF74A8014E4";
                                    root.rescan_memory(root.scan_target_value);
                                }
                            }
                        }

                        // Results Header
                        Rectangle {
                            height: 38px;
                            background: #080d16a8;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;

                                ThematicColumnHeader {
                                    title: "STAMBHANA";
                                    devanagari: "Freeze (स्तम्भन)";
                                    col_width: 85px;
                                    text_color: #64748b;
                                    sanskrit_title: "स्तम्भन सिद्धि // IMMOBILIZE";
                                    feature_name: "Feature: Memory Freeze Lock";
                                    explanation: "Periodically writes back the chosen value on a 100ms timer to keep HP, Mana, or Gold locked.";
                                }

                                ThematicColumnHeader {
                                    title: "KSHETRA";
                                    devanagari: "Address (क्षेत्र)";
                                    col_width: 130px;
                                    text_color: #ff7b00;
                                    sanskrit_title: "क्षेत्र // MEMORY FIELD";
                                    feature_name: "Feature: Virtual Memory Address";
                                    explanation: "The 64-bit virtual memory address pointer in the target process where this variable resides.";
                                }

                                ThematicColumnHeader {
                                    title: "TATVA";
                                    devanagari: "Value (तत्त्व)";
                                    col_width: 120px;
                                    text_color: #f8fafc;
                                    sanskrit_title: "तत्त्व // ELEMENTAL ESSENCE";
                                    feature_name: "Feature: Live Address Value";
                                    explanation: "The current numerical or textual value read directly from the target process's RAM.";
                                }

                                ThematicColumnHeader {
                                    title: "PURVA";
                                    devanagari: "Previous (पूर्व)";
                                    col_width: 110px;
                                    text_color: #64748b;
                                    sanskrit_title: "पूर्व // PRIOR STATE";
                                    feature_name: "Feature: Previous Scan Value";
                                    explanation: "The value held at this address during the preceding scan inquest cycle.";
                                }

                                ThematicColumnHeader {
                                    title: "RUPA";
                                    devanagari: "Type (रूप)";
                                    col_width: 80px;
                                    text_color: #94a3b8;
                                    sanskrit_title: "रूप // DATA FORM";
                                    feature_name: "Feature: Primitive Data Type";
                                    explanation: "The binary interpretation format: i32, u32, i64, u64, f32, f64, or string.";
                                }

                                ThematicColumnHeader {
                                    title: "NAMA & SUTRA";
                                    devanagari: "Label / Pointer (नाम व सूत्र)";
                                    col_width: 200px;
                                    text_color: #64748b;
                                    sanskrit_title: "नाम व सूत्र // LABEL & POINTER";
                                    feature_name: "Feature: Variable Label & Pointer Chain";
                                    explanation: "User-assigned label and multi-level base+offset pointer resolution path.";
                                }
                            }
                        }

                        // Mock Matches Table
                        Rectangle {
                            background: #080d16a8;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;

                                Rectangle {
                                    height: 36px;
                                    background: #141e2ecc;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 12px;
                                        Text { text: "☑"; width: 50px; font-size: 14px; color: #ff4d2e; vertical-alignment: center; }
                                        Text { text: "0x7FF74A8014B0"; width: 140px; font-size: 12px; font-weight: 700; color: #ff7b00; vertical-alignment: center; }
                                        Text { text: "999,999"; width: 130px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "500"; width: 120px; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                        Text { text: "i32"; width: 80px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PlayerGold (Stambhana Active)"; font-size: 11px; color: #38bdf8; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 36px;
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 12px;
                                        Rectangle {
                                            width: 50px;
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.freeze_row1 = !root.freeze_row1;
                                                    root.rudra_status_text = root.freeze_row1 ?
                                                        "STAMBHANA ACTIVE: 0x7FF74A8014E4 locked at " + root.scan_target_value :
                                                        "Stambhana Unlocked: Address 0x7FF74A8014E4 unfrozen";
                                                }
                                            }
                                            Text {
                                                text: root.freeze_row1 ? "☑" : "☐";
                                                font-size: 14px;
                                                color: root.freeze_row1 ? #22c55e : #64748b;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text { text: "0x7FF74A8014E4"; width: 140px; font-size: 12px; color: #ff7b00; vertical-alignment: center; }
                                        Text { text: "100.0"; width: 130px; font-size: 12px; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "100.0"; width: 120px; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                        Text { text: "f32"; width: 80px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PlayerHealth"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Interactive Lua Altar (उद्बोधन वेदी)
                        Rectangle {
                            height: 48px;
                            background: #101622d0;
                            border-radius: 8px;
                            border-width: 1.5px;
                            border-color: #7c3aed66;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                alignment: center;

                                Text {
                                    text: "🔱 LUA:";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #c084fc;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    text <=> root.lua_script_input;
                                    placeholder-text: "sharabha.write_u32(0x7FF74A8014E4, 999999);";
                                    font-size: 11px;
                                    horizontal-stretch: 1;
                                    height: 34px;
                                }

                                ThematicActionButton {
                                    text: "AWAKEN // Run";
                                    devanagari: "उद्बोधन";
                                    btn_width: 130px;
                                    btn_height: 34px;
                                    bg_color: #6d28d9;
                                    hover_color: #7c3aed;
                                    sanskrit_title: "उद्बोधन // AWAKEN LUA";
                                    feature_name: "Feature: Execute LuaJIT Script";
                                    explanation: "Executes custom Lua script with native memory read/write and freeze bindings directly against attached game process.";
                                    clicked => { root.run_lua_script(root.lua_script_input); }
                                }
                            }
                        }
                    }
                }
            }

            // -------------------------------------------------------------
            // TAB 1: 🧊 KALYANA / SAVE FORGE (Fuzzy Save Editor)
            // -------------------------------------------------------------
            if root.active_tab == 1: HorizontalLayout {
                padding: 16px;
                spacing: 12px;

                // Left: File Information & Multi-Metric Switcher (Resizable)
                Rectangle {
                    width: root.kalyana_left_width;
                    background: #090e1899;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #243048aa;
                    z: 50;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "STHITI PARIKSHA (स्थिति परीक्षा)";
                                font-size: 12px;
                                font-weight: 800;
                                letter-spacing: 1px;
                                color: #38bdf8;
                            }
                            Text {
                                text: "Yukti Heuristic v1";
                                font-size: 10px;
                                color: #64748b;
                            }
                        }

                        ThematicActionButton {
                            text: "OPEN SAVE VESSEL // Load Save";
                            devanagari: "पात्र प्रवेश";
                            btn_width: 0px;
                            btn_height: 44px;
                            bg_color: #0284c7;
                            hover_color: #0396df;
                            tooltip_down: true;
                            sanskrit_title: "पात्र प्रवेश // OPEN VESSEL";
                            feature_name: "Feature: Load Save Binary / Struct";
                            explanation: "Loads arbitrary save game files and initiates Shannon entropy and heuristic pattern scanning.";
                            clicked => {
                                root.current_save_idx = Math.mod(root.current_save_idx + 1, 3);
                                if root.current_save_idx == 0 {
                                    root.save_filename = "ER0000.sl2";
                                    root.save_game_title = "ELDEN RING (हिरण्यगर्भ आगम)";
                                    root.save_checksum_info = "Sthiti Raksha: MD5 128-bit Slot Seal Armed";
                                    root.save_runes_val = "950,000";
                                    root.save_level_val = "175";
                                    root.save_vigor_val = "60";
                                    root.save_gold_val = "250,000";
                                } else if root.current_save_idx == 1 {
                                    root.save_filename = "SaveGame.sav";
                                    root.save_game_title = "UNREAL GVAS SAVE (माया संचय)";
                                    root.save_checksum_info = "Sthiti Raksha: CRC32 IEEE Seal Armed";
                                    root.save_runes_val = "0";
                                    root.save_level_val = "42";
                                    root.save_vigor_val = "35";
                                    root.save_gold_val = "850,000";
                                } else {
                                    root.save_filename = "cyberpunk_manual.dat";
                                    root.save_game_title = "CYBERPUNK 2077 (माया चक्र)";
                                    root.save_checksum_info = "Sthiti Raksha: CRC32 Header Seal Armed";
                                    root.save_runes_val = "0";
                                    root.save_level_val = "50";
                                    root.save_vigor_val = "20";
                                    root.save_gold_val = "1,250,000";
                                }
                                root.save_commit_feedback = "Loaded Vessel: " + root.save_filename + " (" + root.save_game_title + ")";
                                root.open_save_file();
                            }
                        }

                        // Metric Switcher Selector
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "PARIKSHA MANA // Metric Switcher (मान परीक्षा)";
                                font-size: 10px;
                                font-weight: 800;
                                color: #94a3b8;
                            }
                            Rectangle {
                                height: 38px;
                                background: #162032b8;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #0284c7;
                                TouchArea {
                                    clicked => {
                                        root.selected_metric = Math.mod(root.selected_metric + 1, 5);
                                        if root.selected_metric == 0 {
                                            root.metric_display_name = "AUTO-DETECT (सर्वज्ञ मान)";
                                            root.metric_score_value = "4.812 bits/byte";
                                            root.metric_verdict_value = "StructuredBinary (प्रपत्र)";
                                            root.container_sig_value = "RawCustomBinary (द्वि-आधारी)";
                                        } else if root.selected_metric == 1 {
                                            root.metric_display_name = "SHANNON ENTROPY (संशय मान)";
                                            root.metric_score_value = "1.393 bits/byte";
                                            root.metric_verdict_value = "SparseOrText (शुद्ध पाठ/रिक्त)";
                                            root.container_sig_value = "SparseZeroPadded (रिक्त बाहुल्य)";
                                        } else if root.selected_metric == 2 {
                                            root.metric_display_name = "CHI-SQUARE TEST (साम्य परीक्षा)";
                                            root.metric_score_value = "χ² = 0.0 (p < 0.001)";
                                            root.metric_verdict_value = "HighlyStructured (अत्यन्त व्यवस्थित)";
                                            root.container_sig_value = "TableRecords (अभिलेख)";
                                        } else if root.selected_metric == 3 {
                                            root.metric_display_name = "BYTE DENSITY & NULLS (घनत्व मान)";
                                            root.metric_score_value = "Null:82% Ascii:16%";
                                            root.metric_verdict_value = "SparseZeroPadded (रिक्त बाहुल्य)";
                                            root.container_sig_value = "HeaderAndPayload (शीर्षक)";
                                        } else {
                                            root.metric_display_name = "STRIDE PERIODICITY (आवर्तन परीक्षा)";
                                            root.metric_score_value = "Period: 32 bytes (100%)";
                                            root.metric_verdict_value = "UniformRecordArray (समरूप सारणी)";
                                            root.container_sig_value = "FixedRecordTable (नियत सारणी)";
                                        }
                                        root.cycle_metric();
                                    }
                                }
                                Text {
                                    text: root.metric_display_name;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Extractor Switcher Selector
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "NISKARSHANA // Extractor (निष्कर्षण युक्ति)";
                                font-size: 10px;
                                font-weight: 800;
                                color: #94a3b8;
                            }
                            Rectangle {
                                height: 38px;
                                background: #162032b8;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #0369a1;
                                TouchArea {
                                    clicked => {
                                        root.selected_extractor = Math.mod(root.selected_extractor + 1, 5);
                                        if root.selected_extractor == 0 {
                                            root.extractor_display_name = "AUTO HEURISTIC (स्वयंसिद्ध)";
                                        } else if root.selected_extractor == 1 {
                                            root.extractor_display_name = "AGAMA HYBRID (आगम सम्मिश्र)";
                                        } else if root.selected_extractor == 2 {
                                            root.extractor_display_name = "BINARY RECORD TABLE (अभिलेख सारणी)";
                                        } else if root.selected_extractor == 3 {
                                            root.extractor_display_name = "DELIMITED KEY-VALUE (परिसीमित तत्त्व)";
                                        } else {
                                            root.extractor_display_name = "BINARY TLV (दैर्घ्य संपुट)";
                                        }
                                        root.cycle_extractor();
                                    }
                                }
                                Text {
                                    text: root.extractor_display_name;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #eab308;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Telemetry Metric Score Card
                        Rectangle {
                            background: #080d16a8;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;

                                Text { text: "Score: " + root.metric_score_value; font-size: 11px; font-weight: 700; color: #38bdf8; }
                                Text { text: "Verdict: " + root.metric_verdict_value; font-size: 10px; color: #cbd5e1; }
                                Text { text: "Container: " + root.container_sig_value; font-size: 10px; color: #94a3b8; }
                            }
                        }

                        // AI Pre-Analysis (Divya Drishti) Toggle
                        Rectangle {
                            height: 38px;
                            background: root.ai_guidance_active ? #1e3a5f : #0f172a;
                            border-radius: 6px;
                            border-width: 1.5px;
                            border-color: root.ai_guidance_active ? #38bdf8 : #334155;
                            TouchArea {
                                clicked => {
                                    root.ai_guidance_active = !root.ai_guidance_active;
                                    root.ai_guidance_status = root.ai_guidance_active ? "DIVYA DRISHTI // Active [BYOK Vault]" : "DIVYA DRISHTI // Ready [BYOK]";
                                    root.toggle_ai_guidance();
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;
                                Text {
                                    text: "🔮 " + root.ai_guidance_status;
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: root.ai_guidance_active ? #7dd3fc : #94a3b8;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.ai_guidance_active ? "[ACTIVE]" : "[OFF]";
                                    font-size: 10px;
                                    font-weight: 900;
                                    color: root.ai_guidance_active ? #38bdf8 : #64748b;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Sthiti Safety Guarantees
                        Rectangle {
                            background: #0b111caa;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #0369a144;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                Text {
                                    text: "🛡️ Sthiti Karma Kavacha (कर्म कवच):";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                }
                                Text {
                                    text: "• Automatic .sharabha.bak prana backup\n• Shadow temp buffer integrity vow\n• Win32 MoveFileEx atomic swap";
                                    font-size: 10px;
                                    color: #64748b;
                                }
                            }
                        }

                        // Commit Button (Dynamic width - stretches with splitter)
                        ThematicActionButton {
                            text: "STHITI SANKALPA // Atomic Commit";
                            devanagari: "स्थिति संकल्प";
                            btn_width: 0px;
                            btn_height: 44px;
                            bg_color: #0369a1;
                            hover_color: #0779b8;
                            tooltip_down: true;
                            sanskrit_title: "स्थिति संकल्प // ATOMIC REWRITE VOW";
                            feature_name: "Feature: Safe File Commit";
                            explanation: "Duplicates original to .sharabha.bak, writes temporary shadow file, and swaps via MoveFileEx.";
                            clicked => {
                                root.save_commit_feedback = "🛡️ Sthiti Sankalpa Sealed: " + root.save_filename + " re-written with valid checksum & .sharabha.bak";
                                root.save_file_atomic();
                            }
                        }
                    }
                }

                // Interactive Splitter Divider (Click & Drag to resize)
                Rectangle {
                    width: 8px;
                    background: splitter_kalyana.has_hover ? #38bdf8 : #1e2738aa;
                    border-radius: 4px;
                    splitter_kalyana := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            root.kalyana_left_width = max(240px, min(parent.width - 400px, root.kalyana_left_width + (self.mouse-x - self.pressed-x)));
                        }
                    }
                }

                // Right: Editable Key-Value Table (Fills remainder)
                Rectangle {
                    horizontal-stretch: 1;
                    background: #090e1899;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #243048aa;
                    z: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // Dual-Mode Aspect Switcher Header
                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: center;

                                Text {
                                    text: root.save_view_mode == 0 ? "🏛️ AGAMA MODE // Deterministic Profile (आगम दर्शन)" : "🌊 PRAVAHA MODE // Fuzzy Stream Map (प्रवाह दर्शन)";
                                    font-size: 13px;
                                    font-weight: 800;
                                    letter-spacing: 1px;
                                    color: root.save_view_mode == 0 ? #eab308 : #38bdf8;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 24px;
                                    background: #0ea5e925;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: #0ea5e955;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: root.save_checksum_info;
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: #38bdf8;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // View Mode Toggle Button
                            ThematicActionButton {
                                text: root.save_view_mode == 0 ? "SWITCH TO PRAVAHA" : "SWITCH TO AGAMA";
                                devanagari: root.save_view_mode == 0 ? "प्रवाह रूप (Fuzzy)" : "आगम रूप (Temple)";
                                btn_width: 180px;
                                btn_height: 36px;
                                bg_color: root.save_view_mode == 0 ? #0284c7 : #854d0e;
                                hover_color: root.save_view_mode == 0 ? #0396df : #a16207;
                                sanskrit_title: "दर्शन परिवर्तन // DUAL-ASPECT TOGGLE";
                                feature_name: "Feature: Switch Agama/Pravaha Mode";
                                explanation: "Toggles between known Agama deterministic field cards and raw multi-metric candidate extraction.";
                                clicked => {
                                    root.save_view_mode = root.save_view_mode == 0 ? 1 : 0;
                                    root.toggle_save_view_mode();
                                }
                            }
                        }

                        // -------------------------------------------------------------
                        // AGAMA VIEW: Deterministic Sacred Game Cards (when save_view_mode == 0)
                        // -------------------------------------------------------------
                        if root.save_view_mode == 0: VerticalLayout {
                            spacing: 14px;

                            // Sacred Profile Banner
                            Rectangle {
                                height: 72px;
                                background: #141c2bcc;
                                border-radius: 8px;
                                border-width: 1.5px;
                                border-color: #eab30866;

                                HorizontalLayout {
                                    padding-left: 18px;
                                    padding-right: 18px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text {
                                                text: root.save_game_title;
                                                font-size: 14px;
                                                font-weight: 800;
                                                color: #facc15;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                height: 20px;
                                                background: #22c55e25;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: #22c55e66;
                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    Text {
                                                        text: "Jnana Kosha Verified";
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        color: #4ade80;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        Text {
                                            text: "Target Vessel: " + root.save_filename + " (Slot 0 Block 0x300) • Multi-Metric Schema Locked";
                                            font-size: 11px;
                                            color: #94a3b8;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: "AGAMA: HIRANYAGARBHA";
                                            font-size: 10px;
                                            font-weight: 800;
                                            color: #ca8a04;
                                            horizontal-alignment: right;
                                        }
                                        Text {
                                            text: "Deterministic Mode Active";
                                            font-size: 10px;
                                            color: #64748b;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }
                            }

                            // Grid of Editable Agama Cards
                            HorizontalLayout {
                                spacing: 14px;

                                // Card 1: Player Runes (मृत्युंजय धन)
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: #0d1524d8;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #eab30844;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "PLAYER RUNES"; font-size: 11px; font-weight: 800; color: #facc15; }
                                            Text { text: "[0x000C // i32]"; font-size: 10px; color: #64748b; }
                                        }
                                        Text { text: "मृत्युंजय धन (Runes Currency)"; font-size: 10px; color: #94a3b8; }

                                        LineEdit {
                                            text <=> root.save_runes_val;
                                            font-size: 14px;
                                            height: 38px;
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            ThematicActionButton {
                                                text: "+50K"; devanagari: "धन"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #1e293b; hover_color: #334155;
                                                clicked => { root.save_runes_val = "1000000"; }
                                            }
                                            ThematicActionButton {
                                                text: "+500K"; devanagari: "कोष"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #1e293b; hover_color: #334155;
                                                clicked => { root.save_runes_val = "1450000"; }
                                            }
                                            ThematicActionButton {
                                                text: "MAX"; devanagari: "अनन्त"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #854d0e; hover_color: #a16207;
                                                clicked => { root.save_runes_val = "99999999"; }
                                            }
                                        }
                                    }
                                }

                                // Card 2: Rune Level (तपस् स्तर)
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: #0d1524d8;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #38bdf844;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "RUNE LEVEL"; font-size: 11px; font-weight: 800; color: #38bdf8; }
                                            Text { text: "[0x0010 // i32]"; font-size: 10px; color: #64748b; }
                                        }
                                        Text { text: "तपस् स्तर (Character Level)"; font-size: 10px; color: #94a3b8; }

                                        LineEdit {
                                            text <=> root.save_level_val;
                                            font-size: 14px;
                                            height: 38px;
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            ThematicActionButton {
                                                text: "-1"; devanagari: "ह्रास"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #1e293b; hover_color: #334155;
                                                clicked => { root.save_level_val = "174"; }
                                            }
                                            ThematicActionButton {
                                                text: "+1"; devanagari: "वृद्धि"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #1e293b; hover_color: #334155;
                                                clicked => { root.save_level_val = "176"; }
                                            }
                                            ThematicActionButton {
                                                text: "META 150"; devanagari: "सारणी"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #0369a1; hover_color: #0284c7;
                                                clicked => { root.save_level_val = "150"; }
                                            }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                // Card 3: Vigor (प्राण शक्ति)
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: #0d1524d8;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #ef444444;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "VIGOR / HP"; font-size: 11px; font-weight: 800; color: #f87171; }
                                            Text { text: "[0x0014 // i32]"; font-size: 10px; color: #64748b; }
                                        }
                                        Text { text: "प्राण शक्ति (Vitality)"; font-size: 10px; color: #94a3b8; }

                                        LineEdit {
                                            text <=> root.save_vigor_val;
                                            font-size: 14px;
                                            height: 38px;
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            ThematicActionButton {
                                                text: "40 SOFTCAP"; devanagari: "प्राण"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #1e293b; hover_color: #334155;
                                                clicked => { root.save_vigor_val = "40"; }
                                            }
                                            ThematicActionButton {
                                                text: "60 HARDCAP"; devanagari: "दृढ़"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #7f1d1d; hover_color: #991b1b;
                                                clicked => { root.save_vigor_val = "60"; }
                                            }
                                            ThematicActionButton {
                                                text: "MAX 99"; devanagari: "परम"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #991b1b; hover_color: #b91c1c;
                                                clicked => { root.save_vigor_val = "99"; }
                                            }
                                        }
                                    }
                                }

                                // Card 4: Gold / Secondary Wealth (सुवर्ण कोष)
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: #0d1524d8;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #10b98144;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: "GOLD / BANK"; font-size: 11px; font-weight: 800; color: #34d399; }
                                            Text { text: "[0x0018 // i32]"; font-size: 10px; color: #64748b; }
                                        }
                                        Text { text: "सुवर्ण कोष (General Currency)"; font-size: 10px; color: #94a3b8; }

                                        LineEdit {
                                            text <=> root.save_gold_val;
                                            font-size: 14px;
                                            height: 38px;
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            ThematicActionButton {
                                                text: "+10K"; devanagari: "धन"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #1e293b; hover_color: #334155;
                                                clicked => { root.save_gold_val = "260000"; }
                                            }
                                            ThematicActionButton {
                                                text: "+100K"; devanagari: "सुवर्ण"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #064e3b; hover_color: #065f46;
                                                clicked => { root.save_gold_val = "350000"; }
                                            }
                                            ThematicActionButton {
                                                text: "MAX"; devanagari: "अनन्त"; btn_width: 0px; btn_height: 28px;
                                                bg_color: #047857; hover_color: #059669;
                                                clicked => { root.save_gold_val = "9999999"; }
                                            }
                                        }
                                    }
                                }
                            }

                            // Sthiti Raksha Integrity Seal Telemetry Bar
                            Rectangle {
                                height: 50px;
                                background: #0c1a2db0;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #0284c755;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: center;
                                        Text {
                                            text: "🛡️ STHITI RAKSHA:";
                                            font-size: 11px;
                                            font-weight: 800;
                                            color: #38bdf8;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "MD5 128-bit Slot Block 0x300 Checksum Armed • Auto-Recomputed on Commit";
                                            font-size: 11px;
                                            color: #cbd5e1;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: "Zero-Corruption Vow (अखंड रक्षा)";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: #22c55e;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        // -------------------------------------------------------------
                        // PRAVAHA VIEW: Heuristic Multi-Metric Raw Table (when save_view_mode == 1)
                        // -------------------------------------------------------------
                        if root.save_view_mode == 1: VerticalLayout {
                            spacing: 8px;

                        // Table Header
                        Rectangle {
                            height: 38px;
                            background: #080d16a8;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                ThematicColumnHeader {
                                    title: "STHANA";
                                    devanagari: "Offset (स्थान)";
                                    col_width: 85px;
                                    text_color: #38bdf8;
                                    sanskrit_title: "स्थान // BYTE OFFSET";
                                    feature_name: "Feature: File Offset";
                                    explanation: "Zero-based hexadecimal position of this field within the save game binary file.";
                                }

                                ThematicColumnHeader {
                                    title: "VISHWAS";
                                    devanagari: "Confidence (विश्वास)";
                                    col_width: 85px;
                                    text_color: #eab308;
                                    sanskrit_title: "विश्वास // CONFIDENCE";
                                    feature_name: "Feature: Heuristic Trust Score";
                                    explanation: "Statistical confidence rating (0-100%) indicating how certain the parser is about this type.";
                                }

                                ThematicColumnHeader {
                                    title: "RUPA";
                                    devanagari: "Inferred Type (रूप)";
                                    col_width: 140px;
                                    text_color: #94a3b8;
                                    sanskrit_title: "रूप // DATA FORM";
                                    feature_name: "Feature: Inferred Type";
                                    explanation: "Detected data type (ASCII string, UTF-16, little-endian i32/u32, or IEEE 754 float).";
                                }

                                ThematicColumnHeader {
                                    title: "LAKSHANA";
                                    devanagari: "Key Label (लक्षण)";
                                    col_width: 170px;
                                    text_color: #cbd5e1;
                                    sanskrit_title: "लक्षण // KEY IDENTIFIER";
                                    feature_name: "Feature: Field Label";
                                    explanation: "Suggested or user-assigned variable name for this entry (stored in Knowledge Base).";
                                }

                                ThematicColumnHeader {
                                    title: "TATVA";
                                    devanagari: "Editable Value (तत्त्व)";
                                    col_width: 180px;
                                    text_color: #cbd5e1;
                                    sanskrit_title: "तत्त्व // MODIFIABLE VALUE";
                                    feature_name: "Feature: In-Place Value Editor";
                                    explanation: "Double-click or edit this value to mutate the underlying bytes before committing.";
                                }
                            }
                        }

                        // Sample Inferred Rows
                        Rectangle {
                            background: #080d16a8;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;

                                Rectangle {
                                    height: 38px;
                                    background: #141e2ecc;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        Text { text: "0x0000"; width: 90px; font-size: 11px; font-weight: 700; color: #38bdf8; vertical-alignment: center; }
                                        Text { text: "95%"; width: 60px; font-size: 11px; font-weight: 700; color: #22c55e; vertical-alignment: center; }
                                        Text { text: "String (ASCII)"; width: 140px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "MAGIC_HEADER"; width: 180px; font-size: 11px; color: #e2e8f0; vertical-alignment: center; }
                                        Text { text: "\"SAVEDB_V3\""; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 38px;
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        Text { text: "0x0010"; width: 90px; font-size: 11px; font-weight: 700; color: #38bdf8; vertical-alignment: center; }
                                        Text { text: "92%"; width: 60px; font-size: 11px; font-weight: 700; color: #22c55e; vertical-alignment: center; }
                                        Text { text: "i32 (Little Endian)"; width: 140px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PLAYER_GOLD"; width: 180px; font-size: 11px; color: #e2e8f0; vertical-alignment: center; }
                                        Text { text: "750,000"; font-size: 11px; font-weight: 700; color: #eab308; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 38px;
                                    background: #141e2ecc;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        Text { text: "0x0018"; width: 90px; font-size: 11px; font-weight: 700; color: #38bdf8; vertical-alignment: center; }
                                        Text { text: "85%"; width: 60px; font-size: 11px; font-weight: 700; color: #eab308; vertical-alignment: center; }
                                        Text { text: "f32 (Float)"; width: 140px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PLAYER_HP"; width: 180px; font-size: 11px; color: #e2e8f0; vertical-alignment: center; }
                                        Text { text: "985.50"; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                        }
                    }
                }
            }

            // -------------------------------------------------------------
            // TAB 2: 📜 JNANA KOSHA (SurrealDB Knowledge Base)
            // -------------------------------------------------------------
            if root.active_tab == 2: VerticalLayout {
                padding: 20px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "JNANA KOSHA — SURREALDB COSMIC AGAMA (ज्ञान कोष)";
                            font-size: 14px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            color: #eab308;
                        }
                        Text {
                            text: "The Cosmic Archive: Game Profiles, Field Schemas, and Memory Tables";
                            font-size: 11px;
                            color: #64748b;
                        }
                    }

                    ThematicActionButton {
                        text: "+ NEW AGAMA // Register Profile";
                        devanagari: "आगम रचना";
                        btn_width: 220px;
                        btn_height: 44px;
                        bg_color: #854d0e;
                        hover_color: #9e5b11;
                        sanskrit_title: "आगम रचना // AGAMA RECORD";
                        feature_name: "Feature: Register Game Schema";
                        explanation: "Saves a new game structure in embedded SurrealDB to permanently remember save offsets and pointer chains.";
                        clicked => {
                            root.jnana_status_msg = "✓ New Game Profile Registered in SurrealDB Knowledge Graph";
                        }
                    }
                }

                LineEdit {
                    placeholder-text: "Search verified game profiles, save signatures, or memory table offsets...";
                    height: 38px;
                }

                // Profile Grid
                HorizontalLayout {
                    spacing: 14px;

                    Rectangle {
                        background: #090e1899;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e2738;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "ELDEN RING"; font-size: 13px; font-weight: 800; color: #f8fafc; }
                                Text { text: "v1.12 Verified"; font-size: 10px; color: #22c55e; }
                            }
                            Text { text: "Save Format: BND4 Encrypted Blob\nOffsets Discovered: 142\nMemory Table: Runes, HP, Stamina, FP"; font-size: 11px; color: #94a3b8; }
                        }
                    }

                    Rectangle {
                        background: #090e1899;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e2738;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "BALDUR'S GATE 3"; font-size: 13px; font-weight: 800; color: #f8fafc; }
                                Text { text: "Patch 7 Verified"; font-size: 10px; color: #22c55e; }
                            }
                            Text { text: "Save Format: LSLIB PAK / LSF Struct\nOffsets Discovered: 388\nMemory Table: Gold, Inspiration, XP"; font-size: 11px; color: #94a3b8; }
                        }
                    }
                }
            }
        }

        // FOOTER STATUS BAR (LAKSHANA VIVARANA)
        Rectangle {
            height: 36px;
            background: #070b14aa;
            border-radius: 6px;
            border-width: 1px;
            border-color: #2e3b5266;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: "🦁 ॐ नमः शरभाय";
                        font-size: 11px;
                        font-weight: 800;
                        color: #eab308;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.active_tab == 0 ? ("RUDRA TANDAVA // Process: " + root.active_process_name + " • Stambhana: Armed") :
                              (root.active_tab == 1 ? ("KALYANA STHITI // Metric: " + root.metric_display_name + " • Sthiti Kavacha: Armed") :
                              "JNANA KOSHA // Sacred Agama Knowledge Base • SurrealDB Store Online");
                        font-size: 11px;
                        font-weight: 700;
                        color: root.active_tab == 0 ? #ff7b00 : (root.active_tab == 1 ? #38bdf8 : #facc15);
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    Text {
                        text: "CHITRAPATA: " + root.canvas_mode_name;
                        font-size: 10px;
                        color: #94a3b8;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "OS: Win x64 • Zig 0.17 • Slint";
                        font-size: 10px;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    // =========================================================================
    // LAYER 3: SPLASH SCREEN OVERLAY (WHEN SHOW_SPLASH IS ACTIVE)
    // =========================================================================
    if root.show_splash: Rectangle {
        width: 100%;
        height: 100%;
        background: #07090d;

        // Background Temple Cinema in Splash (Chitrapata Animated Stream @ 24 FPS)
        Image {
            source: root.splash_video_frames[root.current_splash_frame];
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: 0.45;
        }

        // Vignette Tint
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #07090de6 0%, #07090d99 50%, #07090df2 100%);
        }

        VerticalLayout {
            alignment: center;
            spacing: 28px;

            // Mythic Center Emblem (Centered)
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 170px;
                    height: 170px;
                    border-radius: 85px;
                    background: @radial-gradient(circle, #ff4d2e55 0%, transparent 70%);

                    Image {
                        source: @image-url("../../assets/media/app_icon.png");
                        width: 150px;
                        height: 150px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "SHARABHA";
                    font-size: 42px;
                    font-weight: 900;
                    letter-spacing: 8px;
                    color: #f8fafc;
                    horizontal-alignment: center;
                }

                Text {
                    text: "ॐ नमः शरभाय — THE DUAL ASPECT ENGINE (उग्र व शान्त)";
                    font-size: 14px;
                    font-weight: 800;
                    letter-spacing: 3px;
                    color: #eab308;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.splash_status;
                    font-size: 12px;
                    color: #94a3b8;
                    horizontal-alignment: center;
                }
            }

            // Dismiss / Enter Temple Button (Centered)
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 250px;
                    height: 48px;
                    background: #ff4d2e;
                    border-radius: 8px;
                    TouchArea {
                        clicked => {
                            root.show_splash = false;
                            root.dismiss_splash();
                        }
                    }
                    Text {
                        text: "ENTER TEMPLE (मंदिर प्रवेश)";
                        font-size: 13px;
                        font-weight: 900;
                        letter-spacing: 1.5px;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // =========================================================================
    // LAYER 4: GUPTA KOSHA (गुप्त कोष) — DPAPI ENCRYPTED BYOK VAULT MODAL
    // =========================================================================
    if root.show_vault_modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000cc;

        TouchArea {
            clicked => { root.show_vault_modal = false; }
        }

        Rectangle {
            width: 580px;
            height: 480px;
            background: #080d16a8;
            border-radius: 12px;
            border-width: 2px;
            border-color: #eab308;

            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "GUPTA KOSHA // Secret AI Vault (गुप्त कोष)";
                            font-size: 16px;
                            font-weight: 800;
                            color: #f8fafc;
                        }
                        Text {
                            text: "Windows DPAPI Hardware-Tied Local Encryption • Zero Cloud Exposure";
                            font-size: 10px;
                            color: #eab308;
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: #1e293b;
                        border-radius: 16px;
                        TouchArea { clicked => { root.show_vault_modal = false; } }
                        Text { text: "✕"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 34px;
                        background: root.vault_provider_index == 0 ? #0284c7 : #1e293b;
                        border-radius: 6px;
                        TouchArea { clicked => { root.vault_provider_index = 0; } }
                        Text { text: "Gemini 2.5"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 34px;
                        background: root.vault_provider_index == 1 ? #0284c7 : #1e293b;
                        border-radius: 6px;
                        TouchArea { clicked => { root.vault_provider_index = 1; } }
                        Text { text: "DeepSeek R1/V3"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 34px;
                        background: root.vault_provider_index == 2 ? #0284c7 : #1e293b;
                        border-radius: 6px;
                        TouchArea { clicked => { root.vault_provider_index = 2; } }
                        Text { text: "OpenAI / Local LLM"; font-size: 11px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                if root.vault_provider_index == 0: VerticalLayout {
                    spacing: 4px;
                    Text { text: "Google Gemini API Key (AIzaSy...):"; font-size: 11px; color: #cbd5e1; }
                    LineEdit {
                        text: root.vault_gemini_key;
                        placeholder-text: "Enter Gemini API Key...";
                        height: 40px;
                        edited(val) => { root.vault_gemini_key = val; }
                    }
                }

                if root.vault_provider_index == 1: VerticalLayout {
                    spacing: 4px;
                    Text { text: "DeepSeek API Key (sk-...):"; font-size: 11px; color: #cbd5e1; }
                    LineEdit {
                        text: root.vault_deepseek_key;
                        placeholder-text: "Enter DeepSeek API Key...";
                        height: 40px;
                        edited(val) => { root.vault_deepseek_key = val; }
                    }
                }

                if root.vault_provider_index == 2: VerticalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Custom API Endpoint URL:"; font-size: 11px; color: #cbd5e1; }
                        LineEdit {
                            text: root.vault_openai_endpoint;
                            placeholder-text: "https://api.openai.com/v1 or http://localhost:11434/v1";
                            height: 40px;
                            edited(val) => { root.vault_openai_endpoint = val; }
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "OpenAI / Bearer Token:"; font-size: 11px; color: #cbd5e1; }
                        LineEdit {
                            text: root.vault_openai_key;
                            placeholder-text: "Enter API Key / Token...";
                            height: 40px;
                            edited(val) => { root.vault_openai_key = val; }
                        }
                    }
                }

                Rectangle {
                    height: 32px;
                    background: #111827;
                    border-radius: 4px;
                    Text {
                        text: "🔐 " + root.vault_status_msg;
                        font-size: 10px;
                        color: #10b981;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        height: 44px;
                        background: #059669;
                        border-radius: 6px;
                        TouchArea { clicked => { root.save_vault(); } }
                        Text { text: "SEAL VAULT // Save DPAPI (मुद्रण)"; font-size: 11px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 44px;
                        background: #334155;
                        border-radius: 6px;
                        TouchArea { clicked => { root.test_vault(); } }
                        Text { text: "TEST ORACLE // Unseal (परीक्षा)"; font-size: 11px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
