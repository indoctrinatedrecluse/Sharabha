                        source: @image-url("../../assets/media/app_icon.png");
                        width: 44px;
                        height: 44px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "SHARABHA";
                                font-size: 21px;
