import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, ListView } from "std-widgets.slint";

/* ==========================================================================
   SHARABHA THEME — Shaivite Mysticism & Systems Duality
   - Bhasma (Ash Charcoal): #07090d, #0d1117, #151a23
   - Rudra Agni (Third-Eye Ember): #ff4d2e, #ff7b00
   - Shanti Ganga (Celestial Cyan): #38bdf8, #0ea5e9
   - Trishula Suvarna (Sacred Bronze/Gold): #eab308, #ca8a04
   - Translucent Glass: rgba(13, 17, 24, 0.88)
   ========================================================================== */

export struct ProcessUiEntry {
    pid: int,
    name: string,
    arch: string,
}

export struct MemoryScanResult {
    address: string,
    value: string,
    previous: string,
    val_type: string,
    is_frozen: bool,
}

export struct SaveFieldEntry {
    offset: string,
    label: string,
    inferred_type: string,
    value: string,
    confidence: int,
}

/* ==========================================================================
   THEMATIC ACTION BUTTON WITH DUAL ENGLISH-SANSKRIT & HOVER EXPLANATION
   ========================================================================== */
export component ThematicActionButton inherits Rectangle {
    in property <string> text;
    in property <string> devanagari: "";
    in property <color> bg_color: #ff4d2e;
    in property <color> hover_color: #ff684a;
    in property <string> sanskrit_title: "";
    in property <string> feature_name: "";
    in property <string> explanation: "";
    in property <length> btn_width: 155px;
    in property <length> btn_height: 42px;
    in property <bool> tooltip_down: false;
    in property <bool> tooltip_right_align: false;

    callback clicked();

    preferred-width: root.btn_width > 0px ? root.btn_width : 155px;
    horizontal-stretch: root.btn_width > 0px ? 0 : 1;
    height: btn_height;
    background: touch.has_hover ? hover_color : bg_color;
    border-radius: 6px;
    clip: false;

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    VerticalLayout {
        alignment: center;
        spacing: 1px;
        padding-left: 6px;
        padding-right: 6px;

        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: #ffffff;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.devanagari != "": Text {
            text: root.devanagari;
            font-size: 9px;
            font-weight: 700;
            color: #fef08a;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    // High-Z Floating Description Card on Hover
    if touch.has_hover && root.feature_name != "": Rectangle {
        x: root.tooltip_right_align ? (parent.width - self.width) : (root.tooltip_down ? 0px : (parent.width - self.width) / 2);
        y: root.tooltip_down ? (parent.height + 8px) : (-self.height - 8px);
        width: 320px;
        height: 86px;
        background: #090c12fc;
        border-radius: 8px;
        border-width: 1.5px;
        border-color: #eab308;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000;
        z: 99999;

        VerticalLayout {
            padding: 10px;
            spacing: 3px;
            alignment: center;

            Text {
                text: root.sanskrit_title;
                font-size: 11px;
                font-weight: 800;
                color: #eab308;
                wrap: word-wrap;
            }

            Text {
                text: root.feature_name;
                font-size: 11px;
                font-weight: 700;
                color: #38bdf8;
                wrap: word-wrap;
            }

            Text {
                text: root.explanation;
                font-size: 10px;
                color: #cbd5e1;
                wrap: word-wrap;
            }
        }
    }
}

/* ==========================================================================
   THEMATIC COLUMN HEADER WITH DUAL ENGLISH-SANSKRIT & HOVER EXPLANATION
   ========================================================================== */
export component ThematicColumnHeader inherits Rectangle {
    in property <string> title;
    in property <string> devanagari: "";
    in property <length> col_width: 100px;
    in property <color> text_color: #64748b;
    in property <string> sanskrit_title: "";
    in property <string> feature_name: "";
    in property <string> explanation: "";

    width: col_width;
    height: 100%;

    touch := TouchArea {}

    VerticalLayout {
        alignment: center;
        spacing: 1px;
        padding-left: 4px;
        padding-right: 4px;

        Text {
            text: root.title;
            font-size: 10px;
            font-weight: 800;
            color: touch.has_hover ? #eab308 : root.text_color;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        if root.devanagari != "": Text {
            text: root.devanagari;
            font-size: 8px;
            font-weight: 700;
            color: touch.has_hover ? #fef08a : #475569;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }

    // Opaque Floating Tooltip
    if touch.has_hover && root.feature_name != "": Rectangle {
        x: 0px;
        y: -self.height - 8px;
        width: 290px;
        height: 76px;
        background: #080d16a8;
        border-radius: 6px;
        border-width: 1.5px;
        border-color: #eab308;
        drop-shadow-blur: 14px;
        drop-shadow-color: #000000;
        z: 1000;

        VerticalLayout {
            padding: 8px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.sanskrit_title;
                font-size: 10px;
                font-weight: 800;
                color: #eab308;
            }

            Text {
                text: root.feature_name;
                font-size: 10px;
                font-weight: 700;
                color: #ffffff;
            }

            Text {
                text: root.explanation;
                font-size: 9px;
                color: #94a3b8;
                wrap: word-wrap;
            }
        }
    }
}

export component TabButton inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon_text;
    in property <bool> is_active;
    in property <color> active_color: #ff4d2e;
    in property <string> sanskrit_title: "";
    in property <string> feature_name: "";
    in property <string> explanation: "";

    callback clicked();

    height: 60px;
    background: is_active ? #181f2c : (touch.has_hover ? #121722 : transparent);
    border-radius: 8px;
    border-width: is_active ? 1.5px : 0px;
    border-color: is_active ? active_color : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: center;

        Text {
            text: root.icon_text;
            font-size: 22px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 800;
                letter-spacing: 0.5px;
                color: is_active ? #ffffff : #94a3b8;
            }

            Text {
                text: root.subtitle;
                font-size: 10px;
                font-weight: 600;
                color: is_active ? active_color : #64748b;
            }
        }
    }

    // Opaque Floating Description Card on Hover
    if touch.has_hover && root.feature_name != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height + 8px;
        width: 320px;
        height: 78px;
        background: #080d16a8;
        border-radius: 8px;
        border-width: 1.5px;
        border-color: root.active_color;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000;
        z: 1000;

        VerticalLayout {
            padding: 10px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.sanskrit_title;
                font-size: 11px;
                font-weight: 800;
                color: root.active_color;
            }

            Text {
                text: root.feature_name;
                font-size: 11px;
                font-weight: 700;
                color: #f8fafc;
            }

            Text {
                text: root.explanation;
                font-size: 10px;
                color: #94a3b8;
                wrap: word-wrap;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "SHARABHA — The Dual Aspect Engine (शरभ)";
    min-width: 1180px;
    min-height: 760px;
    default-font-family: "Segoe UI, sans-serif";
    background: #07090d;

    // Splash State
    in-out property <bool> show_splash: false;
    in-out property <string> splash_status: "Awakening the Ashtamurti & Invoking Sharabha (अष्टमूर्ति)...";

    // Active Tab: 0 = Rudra (Memory), 1 = Kalyana (Save Forge), 2 = Jnana (Knowledge Base)
    in-out property <int> active_tab: 0;

    // Resizable Panes Dimensions (Interactive Drag Splitters)
    in-out property <string> active_process_name: "GameProcess.exe [PID 14208]";
    in-out property <length> rudra_left_width: 320px;
    in-out property <length> kalyana_left_width: 350px;
    in-out property <length> jnana_left_width: 320px;

    // Ambient Altar Canvas & Video Controller (Chitrapata)
    in-out property <int> canvas_mode: 0; // 0=Sacred Altar (Still), 1=Animated Loop (Motion), 2=Obsidian (Off)
    in-out property <string> canvas_mode_name: "SACRED ALTAR (स्थिर वेदी)";
    in-out property <float> canvas_opacity: 0.88; // Default 72% so art shines brightly through frosted glass!
    in-out property <string> canvas_opacity_label: "ALTAR 88%";

    // Engine State Properties
    in-out property <int> selected_scan_type: 0;
    in-out property <string> scan_type_name: "EXACT (सटीक मान)";
    in-out property <int> selected_data_type: 0;
    in-out property <string> data_type_name: "Type: i32";

    in-out property <int> selected_metric: 0;
    in-out property <string> metric_display_name: "AUTO-DETECT (सर्वज्ञ मान)";
    in-out property <string> metric_score_value: "4.812 bits/byte";
    in-out property <string> metric_verdict_value: "StructuredBinary (प्रपत्र)";
    in-out property <string> container_sig_value: "RawCustomBinary (द्वि-आधारी)";

    in-out property <int> selected_extractor: 0;
    in-out property <string> extractor_display_name: "AUTO HEURISTIC (स्वयंसिद्ध)";

    in-out property <bool> ai_guidance_active: false;
    in-out property <string> ai_guidance_status: "DIVYA DRISHTI // Ready [BYOK]";

    // Vault Modal State
    in-out property <bool> show_vault_modal: false;
    in-out property <int> vault_provider_index: 0;
    in-out property <string> vault_gemini_key: "";
    in-out property <string> vault_deepseek_key: "";
    in-out property <string> vault_openai_endpoint: "https://api.openai.com/v1";
    in-out property <string> vault_openai_key: "";
    in-out property <string> vault_status_msg: "DPAPI Encrypted Vault Ready (मुद्रित)";

    // Callbacks to Zig core
    callback refresh_processes();
    callback attach_process(int);
    callback start_memory_scan(string, string);
    callback rescan_memory(string);
    callback cycle_scan_type();
    callback cycle_data_type();
    callback open_save_file();
    callback execute_fuzzy_parse();
    callback cycle_metric();
    callback cycle_extractor();
    callback toggle_ai_guidance();
    callback save_file_atomic();
    callback dismiss_splash();
    callback save_vault();
    callback test_vault();
    callback cycle_canvas_mode();

    // =========================================================================
    // LAYER 1: AMBIENT CANVAS BACKGROUND (SACRED ALTAR STILL / ANIMATED LOOP)
    // =========================================================================
    Rectangle {
        width: 100%;
        height: 100%;
        background: #040609;

        // Mode 0 & Mode 1: Sacred Altar Image (High visibility through frosted glass)
        if root.canvas_mode == 0 || root.canvas_mode == 1: Image {
            source: @image-url("../../assets/media/bg_canvas_fallback.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.canvas_opacity;
        }

        // Mode 1: Animated Loop / Active Motion Flares
        if root.canvas_mode == 1: Rectangle {
            width: 100%;
            height: 100%;

            Rectangle {
                x: parent.width * 0.05;
                y: parent.height * 0.08;
                width: 600px;
                height: 600px;
                border-radius: 300px;
                background: @radial-gradient(circle, #ff4d2e28 0%, transparent 70%);
            }

            Rectangle {
                x: parent.width * 0.60;
                y: parent.height * 0.25;
                width: 700px;
                height: 700px;
                border-radius: 350px;
                background: @radial-gradient(circle, #0ea5e928 0%, transparent 70%);
            }
        }

        // Gentle vignette to maintain perfect contrast with text
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #07090d50 0%, #07090d20 50%, #07090d70 100%);
        }
    }

    // =========================================================================
    // LAYER 2: MAIN WORKSPACE INTERFACE
    // =========================================================================
    if !root.show_splash: VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // TOP HEADER BAR: Trishula Logo & Aspect Selector (Frosted Glass, High-Z)
        Rectangle {
            height: 68px;
            background: #070b14b0;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: #2e3b5288;
            clip: false;
            z: 1000;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                // Logo & Motto (Responsive & Compact)
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    Image {
                        source: @image-url("../../assets/media/app_icon.png");
                        width: 38px;
                        height: 38px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "SHARABHA";
                                font-size: 18px;
                                font-weight: 900;
                                letter-spacing: 1.5px;
                                color: #f8fafc;
                            }
                            Text {
                                text: "शरभ";
                                font-size: 15px;
                                font-weight: 800;
                                color: #eab308;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Dual Aspect Tool // Sharabha Avatar";
                            font-size: 10px;
                            color: #64748b;
                        }
                    }
                }

                // Aspect Tabs
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    TabButton {
                        title: "RUDRA (रुद्र)";
                        subtitle: "Memory Engine";
                        icon_text: "🔥";
                        is_active: root.active_tab == 0;
                        active_color: #ff4d2e;
                        sanskrit_title: "रुद्र ताण्डव // RUDRA TANDAVA";
                        feature_name: "Aspect: Memory Penetration & Needle Injection";
                        explanation: "Win32 process attachment, SIMD memory scanning, variable freezing, and live code injection.";
                        clicked => { root.active_tab = 0; }
                    }

                    TabButton {
                        title: "KALYANA (कल्याण)";
                        subtitle: "Save Forge";
                        icon_text: "🧊";
                        is_active: root.active_tab == 1;
                        active_color: #38bdf8;
                        sanskrit_title: "कल्याण स्थिति // KALYANA STHITI";
                        feature_name: "Aspect: Universal Heuristic Save Editor";
                        explanation: "Shannon entropy inference, candidate string/numeric table extraction, and atomic safe write.";
                        clicked => { root.active_tab = 1; }
                    }

                    TabButton {
                        title: "JNANA (ज्ञान)";
                        subtitle: "Agama Graph";
                        icon_text: "📜";
                        is_active: root.active_tab == 2;
                        active_color: #eab308;
                        sanskrit_title: "ज्ञान कोष // JNANA KOSHA";
                        feature_name: "Aspect: Embedded SurrealDB Knowledge Graph";
                        explanation: "Stores verified game save structures, format headers, and memory pointer tables.";
                        clicked => { root.active_tab = 2; }
                    }

                    // Ambient Canvas Switcher (Downwards & Right-Aligned Tooltip)
                    ThematicActionButton {
                        text: "CANVAS";
                        devanagari: root.canvas_opacity_label;
                        btn_width: 125px;
                        btn_height: 42px;
                        bg_color: root.canvas_mode == 0 ? #0369a1 : (root.canvas_mode == 1 ? #6d28d9 : #1e293b);
                        hover_color: #38bdf8;
                        tooltip_down: true;
                        tooltip_right_align: true;
                        sanskrit_title: "चित्रपट वेदी // SACRED CANVAS";
                        feature_name: "Feature: Altar Canvas & Loop Switcher";
                        explanation: "Toggles between Sacred Altar Still (bg_canvas_fallback.jpg), Animated Motion Loop, and Minimal Obsidian with translucency tuning.";
                        clicked => {
                            if root.canvas_mode == 0 {
                                root.canvas_mode = 1;
                                root.canvas_mode_name = "ANIMATED LOOP (सजीव चित्रपट)";
                                root.canvas_opacity = 0.92;
                                root.canvas_opacity_label = "LOOP 92%";
                            } else if root.canvas_mode == 1 {
                                root.canvas_mode = 2;
                                root.canvas_mode_name = "MINIMAL OBSIDIAN (निराकार)";
                                root.canvas_opacity = 0.10;
                                root.canvas_opacity_label = "OFF 10%";
                            } else {
                                root.canvas_mode = 0;
                                root.canvas_mode_name = "SACRED ALTAR (स्थिर वेदी)";
                                root.canvas_opacity = 0.88;
                                root.canvas_opacity_label = "ALTAR 88%";
                            }
                            root.cycle_canvas_mode();
                        }
                    }

                    // Vault Button (Downwards & Right-Aligned Tooltip)
                    ThematicActionButton {
                        text: "VAULT";
                        devanagari: "गुप्त कोष (BYOK)";
                        btn_width: 130px;
                        btn_height: 42px;
                        bg_color: #1e293b;
                        hover_color: #334155;
                        tooltip_down: true;
                        tooltip_right_align: true;
                        sanskrit_title: "गुप्त कोष // SECURE VAULT";
                        feature_name: "Feature: Windows DPAPI Encrypted Vault";
                        explanation: "Encrypted BYOK storage for Gemini, DeepSeek, and OpenAI-compatible API keys via local Windows DPAPI.";
                        clicked => { root.show_vault_modal = !root.show_vault_modal; }
                    }
                }
            }
        }

        // BODY WORKSPACE CONTAINER (Frosted Glass)
        Rectangle {
            background: #05080f70;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: #1e293b88;

            // -------------------------------------------------------------
            // TAB 0: 🔥 RUDRA ENGINE (Memory Scanner & Injection)
            // -------------------------------------------------------------
            if root.active_tab == 0: HorizontalLayout {
                padding: 16px;
                spacing: 12px;

                // Process Selector Panel (Resizable)
                Rectangle {
                    width: root.rudra_left_width;
                    background: #090e1899;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #243048aa;
                    z: 50;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "DARSHANA & BANDHANA (दर्शन व बन्धन)";
                                font-size: 11px;
                                font-weight: 800;
                                letter-spacing: 0.5px;
                                color: #ff4d2e;
                            }
                            Text {
                                text: "Win32 Netra";
                                font-size: 10px;
                                color: #64748b;
                            }
                        }

                        LineEdit {
                            placeholder-text: "Filter process name or PID (e.g. game.exe)...";
                            height: 36px;
                        }

                        // Active Process Mock List
                        Rectangle {
                            background: #080d16a8;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                Rectangle {
                                    height: 36px;
                                    background: #1e293ecc;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;
                                        Text { text: "GameProcess.exe"; font-size: 11px; font-weight: 700; color: #f8fafc; vertical-alignment: center; }
                                        Text { text: "PID 14208 [x64]"; font-size: 10px; color: #ff7b00; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 36px;
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;
                                        Text { text: "eldenring.exe"; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PID 8832 [x64]"; font-size: 10px; color: #64748b; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 36px;
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: space-between;
                                        Text { text: "Cyberpunk2077.exe"; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PID 22910 [x64]"; font-size: 10px; color: #64748b; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Attach Button (Dynamic width - stretches with splitter)
                        ThematicActionButton {
                            text: "BIND PROCESS // Attach";
                            devanagari: "शरभ बन्धन";
                            btn_width: 0px;
                            btn_height: 44px;
                            bg_color: #ff4d2e;
                            hover_color: #ff6548;
                            tooltip_down: true;
                            sanskrit_title: "शरभ बन्धन // PROCESS BINDING";
                            feature_name: "Feature: OpenProcess Memory Handle";
                            explanation: "Opens a full-access Win32 process handle (VM_READ | VM_WRITE) to attach hooks and scanner needles.";
                            clicked => { root.attach_process(14208); }
                        }
                    }
                }

                // Interactive Splitter Divider (Click & Drag to resize)
                Rectangle {
                    width: 8px;
                    background: splitter_rudra.has_hover ? #ff4d2e : #1e2738aa;
                    border-radius: 4px;
                    splitter_rudra := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            root.rudra_left_width = max(220px, min(parent.width - 400px, root.rudra_left_width + (self.mouse-x - self.pressed-x)));
                        }
                    }
                }

                // Memory Scanner & Match Results Panel (Fills remainder)
                Rectangle {
                    horizontal-stretch: 1;
                    background: #090e1899;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #243048aa;
                    z: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // Scan Control Bar (Fully Responsive with horizontal-stretch)
                        HorizontalLayout {
                            spacing: 8px;

                            LineEdit {
                                placeholder-text: "Target value (e.g. 500, 999999)...";
                                horizontal-stretch: 3;
                                min-width: 130px;
                                height: 42px;
                            }

                            // Scan Mode Cycle Selector (Exact, Increased, Decreased, Changed, Unchanged)
                            Rectangle {
                                horizontal-stretch: 2;
                                min-width: 120px;
                                height: 42px;
                                background: #162032b8;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2e3b52;
                                TouchArea {
                                    clicked => { root.cycle_scan_type(); }
                                    mouse-cursor: pointer;
                                }
                                Text {
                                    text: root.scan_type_name;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #ff7b00;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            // Data Type Cycle Selector (i32, u32, i64, u64, f32, f64, Text)
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 80px;
                                height: 42px;
                                background: #162032b8;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2e3b52;
                                TouchArea {
                                    clicked => { root.cycle_data_type(); }
                                    mouse-cursor: pointer;
                                }
                                Text {
                                    text: root.data_type_name;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            ThematicActionButton {
                                text: "FIRST SCAN (प्रथम)";
                                devanagari: "सकल अन्वेषण";
                                horizontal-stretch: 2;
                                btn_width: 0px;
                                btn_height: 42px;
                                bg_color: #ff4d2e;
                                hover_color: #ff6548;
                                tooltip_down: true;
                                sanskrit_title: "प्रथम दृष्टि // FIRST INQUEST";
                                feature_name: "Feature: Initial RAM Value Scanner";
                                explanation: "Queries VirtualQueryEx for committed writable pages and scans entire address space for the target value.";
                                clicked => { root.start_memory_scan("100", "i32"); }
                            }

                            ThematicActionButton {
                                text: "NEXT SCAN (पुनः)";
                                devanagari: "परिशोधन";
                                horizontal-stretch: 2;
                                btn_width: 0px;
                                btn_height: 42px;
                                bg_color: #242e42;
                                hover_color: #2e3b54;
                                tooltip_down: true;
                                sanskrit_title: "पुनर्दृष्टि // REFINED INQUEST";
                                feature_name: "Feature: Next Scan Address Filter";
                                explanation: "Re-reads only previously matched memory locations to isolate values that changed, increased, or stayed exact.";
                                clicked => { root.rescan_memory("100"); }
                            }
                        }

                        // Results Header
                        Rectangle {
                            height: 38px;
                            background: #080d16a8;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;

                                ThematicColumnHeader {
                                    title: "STAMBHANA";
                                    devanagari: "Freeze (स्तम्भन)";
                                    col_width: 85px;
                                    text_color: #64748b;
                                    sanskrit_title: "स्तम्भन सिद्धि // IMMOBILIZE";
                                    feature_name: "Feature: Memory Freeze Lock";
                                    explanation: "Periodically writes back the chosen value on a 100ms timer to keep HP, Mana, or Gold locked.";
                                }

                                ThematicColumnHeader {
                                    title: "KSHETRA";
                                    devanagari: "Address (क्षेत्र)";
                                    col_width: 130px;
                                    text_color: #ff7b00;
                                    sanskrit_title: "क्षेत्र // MEMORY FIELD";
                                    feature_name: "Feature: Virtual Memory Address";
                                    explanation: "The 64-bit virtual memory address pointer in the target process where this variable resides.";
                                }

                                ThematicColumnHeader {
                                    title: "TATVA";
                                    devanagari: "Value (तत्त्व)";
                                    col_width: 120px;
                                    text_color: #f8fafc;
                                    sanskrit_title: "तत्त्व // ELEMENTAL ESSENCE";
                                    feature_name: "Feature: Live Address Value";
                                    explanation: "The current numerical or textual value read directly from the target process's RAM.";
                                }

                                ThematicColumnHeader {
                                    title: "PURVA";
                                    devanagari: "Previous (पूर्व)";
                                    col_width: 110px;
                                    text_color: #64748b;
                                    sanskrit_title: "पूर्व // PRIOR STATE";
                                    feature_name: "Feature: Previous Scan Value";
                                    explanation: "The value held at this address during the preceding scan inquest cycle.";
                                }

                                ThematicColumnHeader {
                                    title: "RUPA";
                                    devanagari: "Type (रूप)";
                                    col_width: 80px;
                                    text_color: #94a3b8;
                                    sanskrit_title: "रूप // DATA FORM";
                                    feature_name: "Feature: Primitive Data Type";
                                    explanation: "The binary interpretation format: i32, u32, i64, u64, f32, f64, or string.";
                                }

                                ThematicColumnHeader {
                                    title: "NAMA & SUTRA";
                                    devanagari: "Label / Pointer (नाम व सूत्र)";
                                    col_width: 200px;
                                    text_color: #64748b;
                                    sanskrit_title: "नाम व सूत्र // LABEL & POINTER";
                                    feature_name: "Feature: Variable Label & Pointer Chain";
                                    explanation: "User-assigned label and multi-level base+offset pointer resolution path.";
                                }
                            }
                        }

                        // Mock Matches Table
                        Rectangle {
                            background: #080d16a8;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;

                                Rectangle {
                                    height: 36px;
                                    background: #141e2ecc;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 12px;
                                        Text { text: "☑"; width: 50px; font-size: 14px; color: #ff4d2e; vertical-alignment: center; }
                                        Text { text: "0x7FF74A8014B0"; width: 140px; font-size: 12px; font-weight: 700; color: #ff7b00; vertical-alignment: center; }
                                        Text { text: "999,999"; width: 130px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "500"; width: 120px; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                        Text { text: "i32"; width: 80px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PlayerGold (Stambhana Active)"; font-size: 11px; color: #38bdf8; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 36px;
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 12px;
                                        Text { text: "☐"; width: 50px; font-size: 14px; color: #64748b; vertical-alignment: center; }
                                        Text { text: "0x7FF74A8014E4"; width: 140px; font-size: 12px; color: #ff7b00; vertical-alignment: center; }
                                        Text { text: "100.0"; width: 130px; font-size: 12px; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "100.0"; width: 120px; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                        Text { text: "f32"; width: 80px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PlayerHealth"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Bottom Lua Console Bar
                        Rectangle {
                            height: 40px;
                            background: #101622b0;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #222c3e;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
