                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_7_name;
                            pid: LiveProcesses.proc_7_pid;
                            win_title: LiveProcesses.proc_7_title;
                            memory_str: LiveProcesses.proc_7_ram;
                            arch: LiveProcesses.proc_7_arch;
                            is_selected: root.modal_selected_proc_idx == 7;
                            clicked => {
                                root.modal_selected_proc_idx = 7;
                            }
                        }

                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_8_name;
                            pid: LiveProcesses.proc_8_pid;
                            win_title: LiveProcesses.proc_8_title;
                            memory_str: LiveProcesses.proc_8_ram;
                            arch: LiveProcesses.proc_8_arch;
                            is_selected: root.modal_selected_proc_idx == 8;
                            clicked => {
                                root.modal_selected_proc_idx = 8;
                            }
                        }

                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_9_name;
                            pid: LiveProcesses.proc_9_pid;
                            win_title: LiveProcesses.proc_9_title;
                            memory_str: LiveProcesses.proc_9_ram;
                            arch: LiveProcesses.proc_9_arch;
                            is_selected: root.modal_selected_proc_idx == 9;
                            clicked => {
                                root.modal_selected_proc_idx = 9;
                            }
                        }

                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_10_name;
                            pid: LiveProcesses.proc_10_pid;
                            win_title: LiveProcesses.proc_10_title;
                            memory_str: LiveProcesses.proc_10_ram;
                            arch: LiveProcesses.proc_10_arch;
                            is_selected: root.modal_selected_proc_idx == 10;
                            clicked => {
                                root.modal_selected_proc_idx = 10;
                            }
                        }

                        ProcessPickerRow {
                            proc_name: LiveProcesses.proc_11_name;
                            pid: LiveProcesses.proc_11_pid;
                            win_title: LiveProcesses.proc_11_title;
                            memory_str: LiveProcesses.proc_11_ram;
                            arch: LiveProcesses.proc_11_arch;
                            is_selected: root.modal_selected_proc_idx == 11;
                            clicked => {
                                root.modal_selected_proc_idx = 11;
                            }
                        }
                    }
                }

                // Modal Footer Actions
                Rectangle {
                    height: 52px;
                    background: #090e18a8;
                    border-radius: 8px;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.modal_selected_proc_idx == 0 ? "Target Selected: " + LiveProcesses.proc_0_name + " [PID " + LiveProcesses.proc_0_pid + "]" :
                                      (root.modal_selected_proc_idx == 1 ? "Target Selected: " + LiveProcesses.proc_1_name + " [PID " + LiveProcesses.proc_1_pid + "]" :
                                      (root.modal_selected_proc_idx == 2 ? "Target Selected: " + LiveProcesses.proc_2_name + " [PID " + LiveProcesses.proc_2_pid + "]" :
                                      (root.modal_selected_proc_idx == 3 ? "Target Selected: " + LiveProcesses.proc_3_name + " [PID " + LiveProcesses.proc_3_pid + "]" :
                                      (root.modal_selected_proc_idx == 4 ? "Target Selected: " + LiveProcesses.proc_4_name + " [PID " + LiveProcesses.proc_4_pid + "]" :
                                      (root.modal_selected_proc_idx == 5 ? "Target Selected: " + LiveProcesses.proc_5_name + " [PID " + LiveProcesses.proc_5_pid + "]" :
                                      (root.modal_selected_proc_idx == 6 ? "Target Selected: " + LiveProcesses.proc_6_name + " [PID " + LiveProcesses.proc_6_pid + "]" :
                                      (root.modal_selected_proc_idx == 7 ? "Target Selected: " + LiveProcesses.proc_7_name + " [PID " + LiveProcesses.proc_7_pid + "]" :
                                      (root.modal_selected_proc_idx == 8 ? "Target Selected: " + LiveProcesses.proc_8_name + " [PID " + LiveProcesses.proc_8_pid + "]" :
                                      (root.modal_selected_proc_idx == 9 ? "Target Selected: " + LiveProcesses.proc_9_name + " [PID " + LiveProcesses.proc_9_pid + "]" :
                                      (root.modal_selected_proc_idx == 10 ? "Target Selected: " + LiveProcesses.proc_10_name + " [PID " + LiveProcesses.proc_10_pid + "]" :
                                      "Target Selected: " + LiveProcesses.proc_11_name + " [PID " + LiveProcesses.proc_11_pid + "]"))))))))));
                                font-size: 11px;
                                font-weight: 700;
                                color: #38bdf8;
                            }
                            Text {
                                text: "Will acquire OpenProcess handle with VM_READ | VM_WRITE access rights.";
                                font-size: 9px;
                                color: #64748b;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            ThematicActionButton {
                                text: "CANCEL";
                                devanagari: "निरसन";
                                btn_width: 90px;
                                btn_height: 36px;
                                bg_color: #1e293b;
                                hover_color: #334155;
                                clicked => {
                                    root.show_process_modal = false;
                                }
                            }

                            ThematicActionButton {
                                text: "ATTACH PROCESS // Bind";
                                devanagari: "शरभ बन्धन";
                                btn_width: 170px;
                                btn_height: 36px;
                                bg_color: #15803d;
                                hover_color: #16a34a;
                                clicked => {
                                    if root.modal_selected_proc_idx == 0 {
                                        root.active_process_name = LiveProcesses.proc_0_name + " [PID " + LiveProcesses.proc_0_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_0_pid;
                                    } else if root.modal_selected_proc_idx == 1 {
                                        root.active_process_name = LiveProcesses.proc_1_name + " [PID " + LiveProcesses.proc_1_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_1_pid;
                                    } else if root.modal_selected_proc_idx == 2 {
                                        root.active_process_name = LiveProcesses.proc_2_name + " [PID " + LiveProcesses.proc_2_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_2_pid;
                                    } else if root.modal_selected_proc_idx == 3 {
                                        root.active_process_name = LiveProcesses.proc_3_name + " [PID " + LiveProcesses.proc_3_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_3_pid;
                                    } else if root.modal_selected_proc_idx == 4 {
                                        root.active_process_name = LiveProcesses.proc_4_name + " [PID " + LiveProcesses.proc_4_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_4_pid;
                                    } else if root.modal_selected_proc_idx == 5 {
                                        root.active_process_name = LiveProcesses.proc_5_name + " [PID " + LiveProcesses.proc_5_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_5_pid;
                                    } else if root.modal_selected_proc_idx == 6 {
                                        root.active_process_name = LiveProcesses.proc_6_name + " [PID " + LiveProcesses.proc_6_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_6_pid;
                                    } else if root.modal_selected_proc_idx == 7 {
                                        root.active_process_name = LiveProcesses.proc_7_name + " [PID " + LiveProcesses.proc_7_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_7_pid;
                                    } else if root.modal_selected_proc_idx == 8 {
                                        root.active_process_name = LiveProcesses.proc_8_name + " [PID " + LiveProcesses.proc_8_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_8_pid;
                                    } else if root.modal_selected_proc_idx == 9 {
                                        root.active_process_name = LiveProcesses.proc_9_name + " [PID " + LiveProcesses.proc_9_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_9_pid;
                                    } else if root.modal_selected_proc_idx == 10 {
                                        root.active_process_name = LiveProcesses.proc_10_name + " [PID " + LiveProcesses.proc_10_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_10_pid;
                                    } else {
                                        root.active_process_name = LiveProcesses.proc_11_name + " [PID " + LiveProcesses.proc_11_pid + "]";
                                        root.active_process_pid = LiveProcesses.proc_11_pid;
                                    }
                                    root.process_bound = true;
                                    root.process_bind_status = "BOUND // Armed [VM_READ | VM_WRITE]";
                                    root.rudra_status_text = "Target Hooked: " + root.active_process_name + " • VM Ready";
                                    root.attach_process(root.active_process_pid);
                                    root.show_process_modal = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // LAYER 8: ASHTAMURTI AUTO-UPDATER & CONSECRATION MODAL (अद्यतन संशुद्धि)
    // =========================================================================
    if root.show_update_modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000e6;
        z: 999999;

        TouchArea {
            clicked => {
                if !UpdaterState.is_downloading {
                    root.show_update_modal = false;
                    root.dismiss_update_modal(root.active_tab);
                }
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 860px;
            height: 600px;
            background: #080d16fa;
            border-radius: 12px;
            border-width: 2px;
            border-color: #ca8a04;
            drop-shadow-blur: 36px;
            drop-shadow-color: #000000;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Header
                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: center;

                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 22px;
                            background: #ca8a0422;
                            border-width: 1px;
                            border-color: #ca8a0466;

                            Text {
                                text: "⚡";
                                font-size: 20px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "ASHTAMURTI AUTO-UPDATER // Sacred Release Synchronizer";
                                    font-size: 15px;
                                    font-weight: 800;
                                    color: #f8fafc;
                                }
                                Text {
                                    text: "अद्यतन संशुद्धि";
                                    font-size: 15px;
                                    font-weight: 800;
                                    color: #eab308;
                                }
                            }

                            Text {
                                text: "Sanctified Release Inquest • GitHub Release Telemetry • Seamless Hot Upgrade Handover";
                                font-size: 10px;
                                color: #94a3b8;
                            }
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: #1e293b;
                        border-radius: 16px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if !UpdaterState.is_downloading {
                                    root.show_update_modal = false;
                                    root.dismiss_update_modal(root.active_tab);
                                }
                            }
                        }
                        Text {
                            text: "✕";
                            font-size: 13px;
                            font-weight: 800;
                            color: #f8fafc;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Version Comparison Strip
                Rectangle {
                    height: 52px;
                    background: #0d1524a8;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #1e293b;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;

                            Rectangle {
                                height: 26px;
                                background: #0284c726;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #0284c766;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "CURRENT VESSEL (वर्तमान): " + UpdaterState.current_version;
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #38bdf8;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: "➔";
                                font-size: 14px;
                                font-weight: 800;
                                color: #64748b;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                height: 26px;
                                background: #10b98126;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #10b98166;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "TEMPLE RELEASE (नवीन): " + UpdaterState.latest_version;
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #34d399;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            Text {
                                text: "PUBLISHED: " + UpdaterState.release_date;
                                font-size: 10px;
                                font-weight: 700;
                                color: #94a3b8;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Release Title
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "RELEASE:";
                        font-size: 11px;
                        font-weight: 800;
                        color: #eab308;
                    }
                    Text {
                        text: UpdaterState.release_title;
                        font-size: 12px;
                        font-weight: 800;
                        color: #f8fafc;
                        overflow: elide;
                    }
                }

                // Changelog Markdown Reader Box
                Rectangle {
                    vertical-stretch: 1;
                    background: #06090fa8;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #1e293b;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "SACRED CHANGELOG // परिवर्तन विवरण (Keep a Changelog)";
                                font-size: 10px;
                                font-weight: 800;
                                letter-spacing: 0.5px;
                                color: #ca8a04;
                            }
                            Text {
                                text: "Markdown Format";
                                font-size: 9px;
                                color: #64748b;
                            }
                        }

                        ScrollView {
                            height: 220px;
                            VerticalLayout {
                                padding-right: 12px;
                                Text {
                                    text: UpdaterState.release_notes;
                                    font-size: 11px;
                                    color: #cbd5e1;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Thematic Progress Bar
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: UpdaterState.status_text;
                            font-size: 11px;
                            font-weight: 700;
                            color: #f1f5f9;
                            overflow: elide;
                        }

                        Text {
                            text: (Math.round(UpdaterState.download_progress * 100)) + "%";
                            font-size: 12px;
                            font-weight: 900;
                            color: #38bdf8;
                        }
                    }

                    Rectangle {
                        height: 18px;
                        background: #0f172a;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #334155;

                        HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                width: parent.width * Math.max(0.01, Math.min(1.0, UpdaterState.download_progress));
                                height: 100%;
                                border-radius: 3px;
                                background: @linear-gradient(90deg, #ff4d2e 0%, #ca8a04 50%, #38bdf8 100%);
                            }
                        }
                    }
                }

                // Action Bar
                HorizontalLayout {
                    alignment: space-between;

                    // Close/Later Button
                    Rectangle {
                        width: 120px;
                        height: 42px;
                        background: #1e293b88;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #334155;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if !UpdaterState.is_downloading {
                                    root.show_update_modal = false;
                                    root.dismiss_update_modal(root.active_tab);
                                }
                            }
                        }
                        Text {
                            text: "LATER // पश्चात्";
                            font-size: 11px;
                            font-weight: 800;
                            color: #94a3b8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Primary Action Button
                    HorizontalLayout {
                        spacing: 12px;

                        if !UpdaterState.is_downloading && !UpdaterState.is_ready && UpdaterState.has_update: Rectangle {
                            width: 270px;
                            height: 42px;
                            background: #ca8a04;
                            border-radius: 6px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.start_update_download(root.active_tab); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text { text: "⚡"; font-size: 14px; vertical-alignment: center; }
                                Text {
                                    text: "CONSECRATE UPDATE // अद्यतन डाउनलोड";
                                    font-size: 11px;
                                    font-weight: 900;
                                    letter-spacing: 0.5px;
                                    color: #07090d;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if !UpdaterState.is_downloading && !UpdaterState.is_ready && !UpdaterState.has_update: Rectangle {
                            width: 270px;
                            height: 42px;
                            background: #0f172a;
                            border-width: 1px;
                            border-color: #334155;
                            border-radius: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text { text: "✓"; font-size: 14px; color: #38bdf8; vertical-alignment: center; }
                                Text {
                                    text: "VESSEL SANCTIFIED (UP TO DATE)";
                                    font-size: 11px;
                                    font-weight: 900;
                                    letter-spacing: 0.5px;
                                    color: #94a3b8;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if UpdaterState.is_downloading: Rectangle {
                            width: 270px;
                            height: 42px;
                            background: #334155;
                            border-radius: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text { text: "⏳"; font-size: 14px; vertical-alignment: center; }
                                Text {
                                    text: "DOWNLOADING SANCTIFIED VESSEL...";
                                    font-size: 11px;
                                    font-weight: 900;
                                    letter-spacing: 0.5px;
                                    color: #94a3b8;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if UpdaterState.is_ready: Rectangle {
                            width: 270px;
                            height: 42px;
                            background: #10b981;
                            border-radius: 6px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.install_update_and_exit(UpdaterState.setup_path); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text { text: "🔱"; font-size: 14px; vertical-alignment: center; }
                                Text {
                                    text: "INSTALL & RESTART // प्रतिष्ठापन";
                                    font-size: 11px;
                                    font-weight: 900;
                                    letter-spacing: 0.5px;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // LAYER 9: NETRA DRISHTANTA (नेत्र दृष्टान्त // FIND WHAT WRITES WATCHER)
    // =========================================================================
    if root.show_netra_modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000e6;
        z: 999999;

        TouchArea {
            clicked => {
                root.show_netra_modal = false;
            }
        }

        Rectangle {
            width: 960px;
            height: 640px;
            background: #080d16;
            border-radius: 12px;
            border-width: 1.5px;
            border-color: #ff4d2e;
            drop-shadow-blur: 40px;
            drop-shadow-color: #ff4d2e44;

            TouchArea { /* swallow clicks inside modal */ }

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                // Modal Header
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text { text: "👁️"; font-size: 20px; vertical-alignment: center; }
                            Text {
                                text: "NETRA DRISHTANTA // FIND WHAT WRITES (नेत्र दृष्टान्त)";
                                font-size: 15px;
                                font-weight: 800;
                                color: #ff4d2e;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: "Hardware Breakpoint (DR0) Active on Address: " + LiveNetra.target_address + " • Monitoring Instructions in Real-Time";
                            font-size: 11px;
                            font-weight: 600;
                            color: #94a3b8;
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        background: #1e293b;
                        border-radius: 16px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show_netra_modal = false; }
                        }
                        Text { text: "✕"; font-size: 14px; font-weight: 800; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Middle: Split into Instruction Table (Left) and Register Dump (Right)
                HorizontalLayout {
                    spacing: 14px;
                    vertical-stretch: 1;

                    // Left: Intercepted Instructions List
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #0a101d;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e293b;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "INTERCEPTED INSTRUCTIONS (" + LiveNetra.hits.length + " UNIQUE HITS)";
                                font-size: 10px;
                                font-weight: 800;
                                color: #ff7b00;
                            }

                            // Instruction Headers
                            Rectangle {
                                height: 26px;
                                background: #131c2e;
                                border-radius: 4px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text { text: "COUNT"; width: 55px; font-size: 9px; font-weight: 800; color: #ff7b00; vertical-alignment: center; }
                                    Text { text: "INSTRUCTION (RIP)"; width: 150px; font-size: 9px; font-weight: 800; color: #38bdf8; vertical-alignment: center; }
                                    Text { text: "OPCODES"; width: 90px; font-size: 9px; font-weight: 800; color: #94a3b8; vertical-alignment: center; }
                                    Text { text: "DISASSEMBLY"; horizontal-stretch: 1; font-size: 9px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                                }
                            }

                            // Instruction Rows
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 4px;
                                    for hit[idx] in LiveNetra.hits: Rectangle {
                                        height: 34px;
                                        background: root.netra_selected_hit == idx ? #1e293b : #0c1422;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: root.netra_selected_hit == idx ? #ff4d2e : #1e293b66;

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.netra_selected_hit = idx; }
                                        }

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;

                                            Text { text: "" + hit.hit_count; width: 55px; font-size: 11px; font-weight: 800; color: #ff7b00; vertical-alignment: center; }
                                            Text { text: hit.rip; width: 150px; font-size: 10px; font-family: "Consolas, monospace"; font-weight: 700; color: #38bdf8; vertical-alignment: center; }
                                            Text { text: hit.opcodes; width: 90px; font-size: 10px; font-family: "Consolas, monospace"; color: #94a3b8; vertical-alignment: center; }
                                            Text { text: hit.disasm; horizontal-stretch: 1; font-size: 11px; font-family: "Consolas, monospace"; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Right: Full 64-Bit Register Dump Box
                    Rectangle {
                        width: 360px;
                        background: #060a12;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #243048;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: "64-BIT CPU CONTEXT REGISTERS (DR0-DR7 / RAX-R15)";
                                font-size: 10px;
                                font-weight: 800;
                                color: #38bdf8;
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                background: #03060a;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #1e293b;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 6px;
                                    alignment: center;

                                    HorizontalLayout {
                                        Text { text: "RAX: "; font-size: 10px; font-weight: 800; color: #eab308; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_rax; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; horizontal-stretch: 1; }
                                        Text { text: "RBX: "; font-size: 10px; font-weight: 800; color: #eab308; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_rbx; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; }
                                    }
                                    HorizontalLayout {
                                        Text { text: "RCX: "; font-size: 10px; font-weight: 800; color: #eab308; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_rcx; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; horizontal-stretch: 1; }
                                        Text { text: "RDX: "; font-size: 10px; font-weight: 800; color: #eab308; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_rdx; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; }
                                    }
                                    HorizontalLayout {
                                        Text { text: "RSI: "; font-size: 10px; font-weight: 800; color: #38bdf8; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_rsi; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; horizontal-stretch: 1; }
                                        Text { text: "RDI: "; font-size: 10px; font-weight: 800; color: #38bdf8; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_rdi; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; }
                                    }
                                    HorizontalLayout {
                                        Text { text: "RSP: "; font-size: 10px; font-weight: 800; color: #38bdf8; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_rsp; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; horizontal-stretch: 1; }
                                        Text { text: "RBP: "; font-size: 10px; font-weight: 800; color: #38bdf8; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_rbp; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; }
                                    }
                                    HorizontalLayout {
                                        Text { text: "R8:  "; font-size: 10px; font-weight: 800; color: #4ade80; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_r8; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; horizontal-stretch: 1; }
                                        Text { text: "R9:  "; font-size: 10px; font-weight: 800; color: #4ade80; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_r9; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; }
                                    }
                                    HorizontalLayout {
                                        Text { text: "R10: "; font-size: 10px; font-weight: 800; color: #4ade80; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_r10; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; horizontal-stretch: 1; }
                                        Text { text: "R11: "; font-size: 10px; font-weight: 800; color: #4ade80; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_r11; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; }
                                    }
                                    HorizontalLayout {
                                        Text { text: "R12: "; font-size: 10px; font-weight: 800; color: #a855f7; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_r12; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; horizontal-stretch: 1; }
                                        Text { text: "R13: "; font-size: 10px; font-weight: 800; color: #a855f7; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_r13; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; }
                                    }
                                    HorizontalLayout {
                                        Text { text: "R14: "; font-size: 10px; font-weight: 800; color: #a855f7; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_r14; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; horizontal-stretch: 1; }
                                        Text { text: "R15: "; font-size: 10px; font-weight: 800; color: #a855f7; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_r15; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; }
                                    }
                                    HorizontalLayout {
                                        Text { text: "RIP: "; font-size: 10px; font-weight: 800; color: #ff4d2e; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.selected_rip; font-size: 10px; font-weight: 700; color: #ff4d2e; font-family: "Consolas, monospace"; horizontal-stretch: 1; }
                                        Text { text: "EFL: "; font-size: 10px; font-weight: 800; color: #ff7b00; font-family: "Consolas, monospace"; }
                                        Text { text: LiveNetra.reg_eflags; font-size: 10px; color: #ffffff; font-family: "Consolas, monospace"; }
                                    }
                                }
                            }
                        }
                    }
                }

                // Bottom Action Buttons
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    ThematicActionButton {
                        text: "REPLACE WITH NOP ⚡";
                        devanagari: "शून्यकरण";
                        btn_width: 170px;
                        btn_height: 38px;
                        bg_color: #991b1b;
                        hover_color: #dc2626;
                        clicked => {
                            root.rudra_status_text = "Patched RIP with NOPs (शून्यकरण): Instruction suppressed";
                        }
                    }

                    ThematicActionButton {
                        text: "DISARM WATCHER";
                        devanagari: "नेत्र विराम";
                        btn_width: 150px;
                        btn_height: 38px;
                        bg_color: #1e293b;
                        hover_color: #334155;
                        clicked => {
                            root.rudra_status_text = "Netra Drishtanta: DR0 Breakpoints Disarmed across all threads";
                            root.show_netra_modal = false;
                        }
                    }

                    ThematicActionButton {
                        text: "CLOSE ✕";
                        devanagari: "प्रस्थान";
                        btn_width: 100px;
                        btn_height: 38px;
                        bg_color: #0f172a;
                        hover_color: #1e293b;
                        clicked => {
                            root.show_netra_modal = false;
                        }
                    }
                }
            }
        }
    }
}
