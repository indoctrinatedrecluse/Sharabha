                    }
                }
            }

            // -------------------------------------------------------------
            // TAB 1: 🧊 KALYANA / SAVE FORGE (Fuzzy Save Editor)
            // -------------------------------------------------------------
            if root.active_tab == 1: HorizontalLayout {
                padding: 16px;
                spacing: 16px;

                // Left: File Information & Safety Rules
                Rectangle {
                    width: 320px;
                    background: #111622;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #1e2738;

                    VerticalLayout {
                        padding: 14px;
