                        border-radius: 6px;
                        Text {
                            text: "+ NEW GAME PROFILE";
                            font-size: 11px;
                            font-weight: 800;
                            color: #fef08a;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                LineEdit {
                    placeholder-text: "Search verified game profiles, save signatures, or memory table offsets...";
                    height: 38px;
                }

                // Profile Grid
                HorizontalLayout {
                    spacing: 14px;

                    Rectangle {
                        background: #111622;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e2738;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "ELDEN RING"; font-size: 13px; font-weight: 800; color: #f8fafc; }
                                Text { text: "v1.12 Verified"; font-size: 10px; color: #22c55e; }
                            }
                            Text { text: "Save Format: BND4 Encrypted Blob\nOffsets Discovered: 142\nMemory Table: Runes, HP, Stamina, FP"; font-size: 11px; color: #94a3b8; }
                        }
                    }

                    Rectangle {
                        background: #111622;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e2738;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "BALDUR'S GATE 3"; font-size: 13px; font-weight: 800; color: #f8fafc; }
                                Text { text: "Patch 7 Verified"; font-size: 10px; color: #22c55e; }
                            }
                            Text { text: "Save Format: LSLIB PAK / LSF Struct\nOffsets Discovered: 388\nMemory Table: Gold, Inspiration, XP"; font-size: 11px; color: #94a3b8; }
                        }
                    }
                }
            }
        }

        // FOOTER STATUS BAR
        Rectangle {
            height: 32px;
            background: #090c12ee;
            border-radius: 6px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: space-between;

                Text {
                    text: "SHARABHA // OM NAMAH SHIVAYA // ALL SUB-SYSTEMS NOMINAL";
                    font-size: 10px;
                    font-weight: 800;
                    letter-spacing: 1px;
                    color: #eab308;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    Text { text: "OS: Windows x64 Native"; font-size: 10px; color: #64748b; vertical-alignment: center; }
                    Text { text: "Core: Zig 0.17"; font-size: 10px; color: #ff4d2e; vertical-alignment: center; }
                    Text { text: "UI: Slint Declarative"; font-size: 10px; color: #38bdf8; vertical-alignment: center; }
                }
            }
        }
    }

    // =========================================================================
    // LAYER 3: SPLASH SCREEN OVERLAY (WHEN SHOW_SPLASH IS ACTIVE)
    // =========================================================================
    if root.show_splash: Rectangle {
        width: 100%;
        height: 100%;
        background: #07090d;

        // Background Temple Artwork in Splash
        Image {
            source: @image-url("../../assets/media/bg_canvas_fallback.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: 0.35;
        }

        // Vignette Tint
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #07090de6 0%, #07090d99 50%, #07090df2 100%);
        }

        VerticalLayout {
            alignment: center;
            spacing: 28px;

            // Mythic Center Emblem (Centered)
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 170px;
                    height: 170px;
                    border-radius: 85px;
                    background: @radial-gradient(circle, #ff4d2e55 0%, transparent 70%);

                    Image {
                        source: @image-url("../../assets/media/app_icon.png");
                        width: 150px;
                        height: 150px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "SHARABHA";
                    font-size: 42px;
                    font-weight: 900;
                    letter-spacing: 8px;
                    color: #f8fafc;
                    horizontal-alignment: center;
                }

                Text {
                    text: "ॐ नमः शरभाय — THE DUAL ASPECT ENGINE";
                    font-size: 14px;
                    font-weight: 800;
                    letter-spacing: 3px;
                    color: #eab308;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.splash_status;
                    font-size: 12px;
                    color: #94a3b8;
                    horizontal-alignment: center;
                }
            }

            // Dismiss / Enter Sanctum Button (Centered)
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 240px;
                    height: 48px;
                    background: #ff4d2e;
                    border-radius: 8px;
                    TouchArea {
                        clicked => {
                            root.show_splash = false;
                            root.dismiss_splash();
                        }
                    }
                    Text {
                        text: "ENTER SANCTUM";
                        font-size: 13px;
                        font-weight: 900;
                        letter-spacing: 2px;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
