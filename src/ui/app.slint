                                }

                                ThematicColumnHeader {
                                    title: "RUPA";
                                    col_width: 70px;
                                    text_color: #94a3b8;
                                    sanskrit_title: "रूप // DATA FORM";
                                    feature_name: "Feature: Primitive Data Type";
                                    explanation: "The binary interpretation format: i32, u32, i64, u64, f32, f64, or string.";
                                }

                                ThematicColumnHeader {
                                    title: "NAMA & SUTRA (नाम व सूत्र)";
                                    col_width: 220px;
                                    text_color: #64748b;
                                    sanskrit_title: "नाम व सूत्र // LABEL & POINTER";
                                    feature_name: "Feature: Variable Label & Pointer Chain";
                                    explanation: "User-assigned label and multi-level base+offset pointer resolution path.";
                                }
                            }
                        }

                        // Mock Matches Table
                        Rectangle {
                            background: #090c12;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;

                                Rectangle {
                                    height: 36px;
                                    background: #141b26;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 12px;
                                        Text { text: "☑"; width: 50px; font-size: 14px; color: #ff4d2e; vertical-alignment: center; }
                                        Text { text: "0x7FF74A8014B0"; width: 140px; font-size: 12px; font-weight: 700; color: #ff7b00; vertical-alignment: center; }
                                        Text { text: "999,999"; width: 130px; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "500"; width: 120px; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                        Text { text: "i32"; width: 80px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PlayerGold (Stambhana Active)"; font-size: 11px; color: #38bdf8; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 36px;
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 12px;
                                        Text { text: "☐"; width: 50px; font-size: 14px; color: #64748b; vertical-alignment: center; }
                                        Text { text: "0x7FF74A8014E4"; width: 140px; font-size: 12px; color: #ff7b00; vertical-alignment: center; }
                                        Text { text: "100.0"; width: 130px; font-size: 12px; color: #ffffff; vertical-alignment: center; }
                                        Text { text: "100.0"; width: 120px; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                        Text { text: "f32"; width: 80px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PlayerHealth"; font-size: 11px; color: #64748b; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Bottom Lua Console Bar
                        Rectangle {
                            height: 40px;
                            background: #151b27;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #222c3e;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
