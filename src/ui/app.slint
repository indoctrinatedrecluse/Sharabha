import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, ListView } from "std-widgets.slint";

/* ==========================================================================
   SHARABHA THEME — Shaivite Mysticism & High-Tech Systems Duality
   - Bhasma (Ash Charcoal): #0a0b0e, #14171d
   - Rudra Agni (Third-Eye Ember): #ff4d2e, #ff7b00
   - Shanti Ganga (Celestial Cyan): #38bdf8, #0ea5e9
   - Trishula Suvarna (Sacred Bronze/Gold): #eab308, #ca8a04
   - Translucent Glass Panels: rgba(18, 22, 30, 0.78)
   ========================================================================== */

export struct ProcessUiEntry {
    pid: int,
    name: string,
    architecture: string,
}

export struct MemoryScanResult {
    address: string,
    value: string,
    previous_value: string,
    val_type: string,
}

export struct SaveFieldEntry {
    offset: string,
    label: string,
    inferred_type: string,
    value: string,
    confidence: int,
}

export component TabButton inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon_text;
    in property <bool> is_active;
    in property <color> active_color: #ff4d2e;

    callback clicked();

    height: 58px;
    background: is_active ? #1e2430 : (touch.has_hover ? #161b24 : transparent);
    border-radius: 8px;
    border-width: is_active ? 1px : 0px;
    border-color: is_active ? active_color : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: center;

        Text {
            text: root.icon_text;
            font-size: 20px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 700;
                color: is_active ? #ffffff : #94a3b8;
            }

            Text {
                text: root.subtitle;
                font-size: 10px;
                color: is_active ? active_color : #64748b;
            }
        }
    }
}

