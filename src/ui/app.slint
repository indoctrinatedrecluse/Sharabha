                                    color: #64748b;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // -------------------------------------------------------------
            // TAB 1: 🧊 KALYANA / SAVE FORGE (Fuzzy Save Editor)
            // -------------------------------------------------------------
            if root.active_tab == 1: HorizontalLayout {
                padding: 16px;
                spacing: 12px;

                // Left: File Information & Multi-Metric Switcher (Resizable)
                Rectangle {
                    width: root.kalyana_left_width;
                    background: #090e1899;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #243048aa;
                    z: 50;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "STHITI PARIKSHA (स्थिति परीक्षा)";
                                font-size: 12px;
                                font-weight: 800;
                                letter-spacing: 1px;
                                color: #38bdf8;
                            }
                            Text {
                                text: "Yukti Heuristic v1";
                                font-size: 10px;
                                color: #64748b;
                            }
