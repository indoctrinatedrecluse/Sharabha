    in-out property <int> current_loop_frame: 0;
    in-out property <int> current_splash_frame: 0;

    // Zero-overhead GPU Frame Timers: idle at 0.0% CPU when not playing
    chitrapata_timer := Timer {
        interval: 42ms; // 24 FPS hardware-accelerated video loop
        running: root.canvas_mode == 1;
        triggered() => {
            root.current_loop_frame = Math.mod(root.current_loop_frame + 1, 239);
        }
    }

    splash_video_timer := Timer {
        interval: 42ms; // 24 FPS splash cinema
        running: root.show_splash;
        triggered() => {
            root.current_splash_frame = Math.mod(root.current_splash_frame + 1, 143);
            if root.current_splash_frame >= 142 {
                // Completed cinema loop, seamlessly transition into temple
                root.show_splash = false;
            }
        }
    }


    // Rudra Tandava Interactive State
    in-out property <int> active_process_pid: LiveBind.bound ? LiveBind.pid : LiveProcesses.proc_0_pid;
    in-out property <int> selected_process_idx: 0;
    in-out property <bool> process_bound: LiveBind.bound;
    in-out property <string> process_bind_status: LiveBind.bound ? ("BOUND // " + LiveBind.name) : "STANDBY // Unattached";
    in-out property <string> rudra_status_text: LiveScan.status_text;

    // Process Picker Modal (सम्पूर्ण प्रक्रिया सूची)
    in-out property <bool> show_process_modal: false;
    in-out property <string> process_modal_search: "";
    in-out property <int> modal_selected_proc_idx: 0;

    // Generic Memory Scanner State (बहु-शोधन परिशोधन)
