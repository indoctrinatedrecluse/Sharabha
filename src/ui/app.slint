            Rectangle {
                height: 20px;
                background: #0284c722;
                border-radius: 4px;
                border-width: 1px;
                border-color: #0284c755;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.arch;
                        font-size: 9px;
                        font-weight: 800;
                        color: #38bdf8;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: root.memory_str;
                font-size: 10px;
                color: #64748b;
                vertical-alignment: center;
            }
        }
