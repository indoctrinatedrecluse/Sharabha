import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, ListView } from "std-widgets.slint";
import { LiveProcesses } from "live_processes.slint";
import { LiveSave, SaveKeyValueRowData } from "live_save.slint";
import { LiveScan, ScanRowData } from "live_scan.slint";
import { LiveTable, CheatTableRowData } from "live_table.slint";
import { LiveBind } from "live_bind.slint";
import { UpdaterState } from "updater_state.slint";
import { LiveDiff, DiffRowData } from "live_diff.slint";
import { LiveNetra, NetraHitData } from "live_netra.slint";

/* ==========================================================================
   SHARABHA THEME — Shaivite Mysticism & Systems Duality
   - Bhasma (Ash Charcoal): #07090d, #0d1117, #151a23
   - Rudra Agni (Third-Eye Ember): #ff4d2e, #ff7b00
   - Shanti Ganga (Celestial Cyan): #38bdf8, #0ea5e9
   - Trishula Suvarna (Sacred Bronze/Gold): #eab308, #ca8a04
   - Translucent Glass: rgba(13, 17, 24, 0.88)
   ========================================================================== */

export struct ProcessUiEntry {
    pid: int,
    name: string,
    arch: string,
}

export struct MemoryScanResult {
    address: string,
    value: string,
    previous: string,
    val_type: string,
    is_frozen: bool,
}

export struct SaveFieldEntry {
    offset: string,
    label: string,
    inferred_type: string,
    value: string,
    confidence: int,
}

/* ==========================================================================
   THEMATIC ACTION BUTTON WITH DUAL ENGLISH-SANSKRIT & HOVER EXPLANATION
   ========================================================================== */
export component ThematicActionButton inherits Rectangle {
    in property <string> text;
    in property <string> devanagari: "";
    in property <color> bg_color: #ff4d2e;
    in property <color> hover_color: #ff684a;
    in property <string> sanskrit_title: "";
    in property <string> feature_name: "";
    in property <string> explanation: "";
    in property <length> btn_width: 155px;
    in property <length> btn_height: 42px;
    in property <bool> tooltip_down: false;
    in property <bool> tooltip_right_align: false;
    /// Single-line mode for dense toolbars (address-list actions): hides the
    /// Devanagari subtitle so a row of buttons stays inside the panel.
    in property <bool> compact: false;

    callback clicked();

    min-width: root.btn_width > 0px ? root.btn_width : 60px;
    max-width: root.btn_width > 0px ? root.btn_width : 10000px;
    preferred-width: root.btn_width > 0px ? root.btn_width : 155px;
    horizontal-stretch: root.btn_width > 0px ? 0 : 1;
    height: btn_height;
    background: touch.has_hover ? hover_color : bg_color;
    border-radius: 6px;
    clip: false;

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    VerticalLayout {
        alignment: center;
        spacing: 1px;
        padding-left: 4px;
        padding-right: 4px;

        Text {
            text: root.text;
            font-size: root.compact ? 9px : 10px;
            font-weight: 800;
            letter-spacing: root.compact ? 0px : 0.5px;
            color: #ffffff;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
            min-width: 0px;
        }

        if root.devanagari != "" && !root.compact: Text {
            text: root.devanagari;
            font-size: 9px;
            font-weight: 700;
            color: #fef08a;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
            min-width: 0px;
        }
    }

    // High-Z Floating Description Card on Hover
    if touch.has_hover && root.feature_name != "": Rectangle {
        x: root.tooltip_right_align ? (parent.width - self.width) : (root.tooltip_down ? 0px : (parent.width - self.width) / 2);
        y: root.tooltip_down ? (parent.height + 8px) : (-self.height - 8px);
        width: 320px;
        height: 86px;
        background: #090c12fc;
        border-radius: 8px;
        border-width: 1.5px;
        border-color: #eab308;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000;
        z: 99999;

        VerticalLayout {
            padding: 10px;
            spacing: 3px;
            alignment: center;

            Text {
                text: root.sanskrit_title;
                font-size: 11px;
                font-weight: 800;
                color: #eab308;
                wrap: word-wrap;
            }

            Text {
                text: root.feature_name;
                font-size: 11px;
                font-weight: 700;
                color: #38bdf8;
                wrap: word-wrap;
            }

            Text {
                text: root.explanation;
                font-size: 10px;
                color: #cbd5e1;
                wrap: word-wrap;
            }
        }
    }
}

/* ==========================================================================
   THEMATIC COLUMN HEADER WITH DUAL ENGLISH-SANSKRIT & HOVER EXPLANATION
   ========================================================================== */
/* Dense single-line variant used by the address-list toolbars. */
export component CompactActionButton inherits ThematicActionButton {
    compact: true;
    btn_height: 24px;
}

export component ThematicColumnHeader inherits Rectangle {
    in property <string> title;
    in property <string> devanagari: "";
    in property <length> col_width: 100px;
    in property <color> text_color: #64748b;
    in property <string> sanskrit_title: "";
    in property <string> feature_name: "";
    in property <string> explanation: "";

    width: col_width;
    height: 100%;

    touch := TouchArea {}

    VerticalLayout {
        alignment: center;
        spacing: 1px;
        padding-left: 4px;
        padding-right: 4px;

        Text {
            text: root.title;
            font-size: 10px;
            font-weight: 800;
            color: touch.has_hover ? #eab308 : root.text_color;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        if root.devanagari != "": Text {
            text: root.devanagari;
            font-size: 8px;
            font-weight: 700;
            color: touch.has_hover ? #fef08a : #475569;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }

    // Opaque Floating Tooltip
    if touch.has_hover && root.feature_name != "": Rectangle {
        x: 0px;
        y: -self.height - 8px;
        width: 290px;
        height: 76px;
        background: #080d16a8;
        border-radius: 6px;
        border-width: 1.5px;
        border-color: #eab308;
        drop-shadow-blur: 14px;
        drop-shadow-color: #000000;
        z: 1000;

        VerticalLayout {
            padding: 8px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.sanskrit_title;
                font-size: 10px;
                font-weight: 800;
                color: #eab308;
            }

            Text {
                text: root.feature_name;
                font-size: 10px;
                font-weight: 700;
                color: #ffffff;
            }

            Text {
                text: root.explanation;
                font-size: 9px;
                color: #94a3b8;
                wrap: word-wrap;
            }
        }
    }
}

export component TabButton inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon_text;
    in property <bool> is_active;
    in property <color> active_color: #ff4d2e;
    in property <string> sanskrit_title: "";
    in property <string> feature_name: "";
    in property <string> explanation: "";

    callback clicked();

    height: 60px;
    min-width: 132px;
    background: is_active ? #181f2c : (touch.has_hover ? #121722 : transparent);
    border-radius: 8px;
    border-width: is_active ? 1.5px : 0px;
    border-color: is_active ? active_color : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: center;

        Text {
            text: root.icon_text;
            font-size: 20px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            min-width: 0px;

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 800;
                letter-spacing: 0.5px;
                color: is_active ? #ffffff : #94a3b8;
                overflow: elide;
                min-width: 0px;
            }

            Text {
                text: root.subtitle;
                font-size: 10px;
                font-weight: 600;
                color: is_active ? active_color : #64748b;
                overflow: elide;
                min-width: 0px;
            }
        }
    }

    // Opaque Floating Description Card on Hover
    if touch.has_hover && root.feature_name != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height + 8px;
        width: 320px;
        height: 78px;
        background: #080d16a8;
        border-radius: 8px;
        border-width: 1.5px;
        border-color: root.active_color;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000;
        z: 1000;

        VerticalLayout {
            padding: 10px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.sanskrit_title;
                font-size: 11px;
                font-weight: 800;
                color: root.active_color;
            }

            Text {
                text: root.feature_name;
                font-size: 11px;
                font-weight: 700;
                color: #f8fafc;
            }

            Text {
                text: root.explanation;
                font-size: 10px;
                color: #94a3b8;
                wrap: word-wrap;
            }
        }
    }
}

export component PaletteItemRow inherits Rectangle {
    in property <string> icon_text: "⚡";
    in property <string> title: "";
    in property <string> devanagari: "";
    in property <string> category: "GENERAL";
    in property <color> tag_color: #38bdf8;
    in property <string> shortcut_hint: "";
    callback clicked();

    height: 44px;
    background: touch.has_hover ? #1a2333 : #0b111caa;
    border-radius: 6px;
    border-width: touch.has_hover ? 1px : 0px;
    border-color: root.tag_color;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            Text {
                text: root.icon_text;
                font-size: 15px;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.title;
                        font-size: 12px;
                        font-weight: 700;
                        color: touch.has_hover ? #ffffff : #f1f5f9;
                        vertical-alignment: center;
                    }
                    if root.devanagari != "": Text {
                        text: root.devanagari;
                        font-size: 10px;
                        font-weight: 700;
                        color: #facc15;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Rectangle {
                height: 20px;
                background: root.tag_color.transparentize(0.85);
                border-radius: 4px;
                border-width: 1px;
                border-color: root.tag_color.transparentize(0.5);
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.category;
                        font-size: 9px;
                        font-weight: 800;
                        color: root.tag_color;
                        vertical-alignment: center;
                    }
                }
            }

            if root.shortcut_hint != "": Text {
                text: root.shortcut_hint;
                font-size: 10px;
                color: #64748b;
                vertical-alignment: center;
            }
        }
    }
}

export component DocsArticleTile inherits Rectangle {
    in property <string> icon_text: "📜";
    in property <string> title: "";
    in property <string> devanagari: "";
