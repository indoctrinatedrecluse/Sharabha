                        ThematicActionButton {
                            text: "📂 OPEN SAVE VESSEL (पात्र)";
                            btn_width: 292px;
                            btn_height: 42px;
                            bg_color: #0284c7;
                            hover_color: #0396df;
                            sanskrit_title: "पात्र प्रवेश // OPEN VESSEL";
                            feature_name: "Feature: Load Save Binary / Struct";
                            explanation: "Loads arbitrary save game files and initiates Shannon entropy and heuristic pattern scanning.";
                            clicked => { root.open_save_file(); }
                        }

                        // File Stats Card
                        Rectangle {
                            background: #090c12;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                Text { text: "save_slot_01.sav"; font-size: 12px; font-weight: 700; color: #f8fafc; }
                                Text { text: "File Size: 24,576 bytes"; font-size: 11px; color: #94a3b8; }
                                Text { text: "Entropy: 4.812 bits/byte (Structured)"; font-size: 11px; color: #38bdf8; }
                                Text { text: "Endianness: Little Endian"; font-size: 11px; color: #64748b; }
                            }
                        }

                        // Sthiti Safety Guarantees
                        Rectangle {
                            background: #0d1522;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #0369a144;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                Text {
                                    text: "🛡️ Sthiti Karma Kavacha (कर्म कवच):";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #38bdf8;
                                }
                                Text {
                                    text: "• Automatic .sharabha.bak prana backup\n• Shadow temp buffer integrity vow\n• Win32 MoveFileEx atomic swap";
                                    font-size: 10px;
                                    color: #64748b;
                                }
                            }
                        }

                        // Commit Button
                        ThematicActionButton {
                            text: "STHITI SANKALPA & ATOMIC COMMIT";
                            btn_width: 292px;
                            btn_height: 42px;
                            bg_color: #0369a1;
                            hover_color: #0779b8;
                            sanskrit_title: "स्थिति संकल्प // ATOMIC REWRITE VOW";
                            feature_name: "Feature: Safe File Commit";
                            explanation: "Duplicates original to .sharabha.bak, writes temporary shadow file, and swaps via MoveFileEx.";
                            clicked => { root.save_file_atomic(); }
                        }
                    }
                }

                // Right: Editable Key-Value Table
                Rectangle {
                    background: #111622;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #1e2738;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "INFERRED KEY-VALUE ENTRIES (अनुमानित तत्त्व)";
                                font-size: 12px;
                                font-weight: 800;
                                letter-spacing: 1px;
                                color: #f8fafc;
                            }

                            Text {
                                text: "Yukti Confidence Scorer: Active";
                                font-size: 11px;
                                color: #38bdf8;
                            }
                        }

                        // Table Header
                        Rectangle {
                            height: 32px;
                            background: #090c12;
                            border-radius: 4px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;

                                ThematicColumnHeader {
                                    title: "OFFSET";
                                    col_width: 90px;
                                    text_color: #38bdf8;
                                    sanskrit_title: "स्थान // BYTE OFFSET";
                                    feature_name: "Feature: File Offset";
                                    explanation: "Zero-based hexadecimal position of this field within the save game binary file.";
                                }

                                ThematicColumnHeader {
                                    title: "VISHWAS";
                                    col_width: 75px;
                                    text_color: #eab308;
                                    sanskrit_title: "विश्वास // CONFIDENCE";
                                    feature_name: "Feature: Heuristic Trust Score";
                                    explanation: "Statistical confidence rating (0-100%) indicating how certain the parser is about this type.";
                                }

                                ThematicColumnHeader {
                                    title: "RUPA";
                                    col_width: 130px;
                                    text_color: #94a3b8;
                                    sanskrit_title: "रूप // DATA FORM";
                                    feature_name: "Feature: Inferred Type";
                                    explanation: "Detected data type (ASCII string, UTF-16, little-endian i32/u32, or IEEE 754 float).";
                                }

                                ThematicColumnHeader {
                                    title: "LAKSHANA / KEY";
                                    col_width: 170px;
                                    text_color: #cbd5e1;
                                    sanskrit_title: "लक्षण // KEY IDENTIFIER";
                                    feature_name: "Feature: Field Label";
                                    explanation: "Suggested or user-assigned variable name for this entry (stored in Knowledge Base).";
                                }

                                ThematicColumnHeader {
                                    title: "TATVA (EDITABLE)";
                                    col_width: 180px;
                                    text_color: #cbd5e1;
                                    sanskrit_title: "तत्त्व // MODIFIABLE VALUE";
                                    feature_name: "Feature: In-Place Value Editor";
                                    explanation: "Double-click or edit this value to mutate the underlying bytes before committing.";
                                }
                            }
                        }

                        // Sample Inferred Rows
                        Rectangle {
                            background: #090c12;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #18202e;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;

                                Rectangle {
                                    height: 38px;
                                    background: #131924;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        Text { text: "0x0000"; width: 90px; font-size: 11px; font-weight: 700; color: #38bdf8; vertical-alignment: center; }
                                        Text { text: "95%"; width: 60px; font-size: 11px; font-weight: 700; color: #22c55e; vertical-alignment: center; }
                                        Text { text: "String (ASCII)"; width: 140px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "MAGIC_HEADER"; width: 180px; font-size: 11px; color: #e2e8f0; vertical-alignment: center; }
                                        Text { text: "\"SAVEDB_V3\""; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 38px;
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        Text { text: "0x0010"; width: 90px; font-size: 11px; font-weight: 700; color: #38bdf8; vertical-alignment: center; }
                                        Text { text: "92%"; width: 60px; font-size: 11px; font-weight: 700; color: #22c55e; vertical-alignment: center; }
                                        Text { text: "i32 (Little Endian)"; width: 140px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PLAYER_GOLD"; width: 180px; font-size: 11px; color: #e2e8f0; vertical-alignment: center; }
                                        Text { text: "750,000"; font-size: 11px; font-weight: 700; color: #eab308; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 38px;
                                    background: #131924;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        Text { text: "0x0018"; width: 90px; font-size: 11px; font-weight: 700; color: #38bdf8; vertical-alignment: center; }
                                        Text { text: "85%"; width: 60px; font-size: 11px; font-weight: 700; color: #eab308; vertical-alignment: center; }
                                        Text { text: "f32 (Float)"; width: 140px; font-size: 11px; color: #94a3b8; vertical-alignment: center; }
                                        Text { text: "PLAYER_HP"; width: 180px; font-size: 11px; color: #e2e8f0; vertical-alignment: center; }
                                        Text { text: "985.50"; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -------------------------------------------------------------
            // TAB 2: 📜 JNANA KOSHA (SurrealDB Knowledge Base)
            // -------------------------------------------------------------
            if root.active_tab == 2: VerticalLayout {
                padding: 20px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "JNANA KOSHA — SURREALDB COSMIC AGAMA (ज्ञान कोष)";
                            font-size: 14px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            color: #eab308;
                        }
                        Text {
                            text: "The Cosmic Archive: Game Profiles, Field Schemas, and Memory Tables";
                            font-size: 11px;
                            color: #64748b;
                        }
                    }

                    ThematicActionButton {
                        text: "+ NEW AGAMA PROFILE";
                        btn_width: 190px;
                        btn_height: 38px;
                        bg_color: #854d0e;
                        hover_color: #9e5b11;
                        sanskrit_title: "आगम रचना // AGAMA RECORD";
                        feature_name: "Feature: Register Game Schema";
                        explanation: "Saves a new game structure in embedded SurrealDB to permanently remember save offsets and pointer chains.";
                    }
                }

                LineEdit {
                    placeholder-text: "Search verified game profiles, save signatures, or memory table offsets...";
                    height: 38px;
                }

                // Profile Grid
                HorizontalLayout {
                    spacing: 14px;

                    Rectangle {
                        background: #111622;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e2738;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "ELDEN RING"; font-size: 13px; font-weight: 800; color: #f8fafc; }
                                Text { text: "v1.12 Verified"; font-size: 10px; color: #22c55e; }
                            }
                            Text { text: "Save Format: BND4 Encrypted Blob\nOffsets Discovered: 142\nMemory Table: Runes, HP, Stamina, FP"; font-size: 11px; color: #94a3b8; }
                        }
                    }

                    Rectangle {
                        background: #111622;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #1e2738;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "BALDUR'S GATE 3"; font-size: 13px; font-weight: 800; color: #f8fafc; }
                                Text { text: "Patch 7 Verified"; font-size: 10px; color: #22c55e; }
                            }
                            Text { text: "Save Format: LSLIB PAK / LSF Struct\nOffsets Discovered: 388\nMemory Table: Gold, Inspiration, XP"; font-size: 11px; color: #94a3b8; }
                        }
                    }
                }
            }
        }

        // FOOTER STATUS BAR
        Rectangle {
            height: 32px;
            background: #090c12ee;
            border-radius: 6px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: space-between;

                Text {
                    text: "शरभेश्वर // ॐ नमः शिवाय // TRISHULA & ASHTAMURTI IN HARMONY";
                    font-size: 10px;
                    font-weight: 800;
                    letter-spacing: 1px;
                    color: #eab308;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    Text { text: "OS: Windows x64 Native"; font-size: 10px; color: #64748b; vertical-alignment: center; }
                    Text { text: "Core: Zig 0.17"; font-size: 10px; color: #ff4d2e; vertical-alignment: center; }
                    Text { text: "UI: Slint Declarative"; font-size: 10px; color: #38bdf8; vertical-alignment: center; }
                }
            }
        }
    }

    // =========================================================================
    // LAYER 3: SPLASH SCREEN OVERLAY (WHEN SHOW_SPLASH IS ACTIVE)
    // =========================================================================
    if root.show_splash: Rectangle {
        width: 100%;
        height: 100%;
        background: #07090d;

        // Background Temple Artwork in Splash
        Image {
            source: @image-url("../../assets/media/bg_canvas_fallback.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: 0.35;
        }

        // Vignette Tint
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #07090de6 0%, #07090d99 50%, #07090df2 100%);
        }

        VerticalLayout {
            alignment: center;
            spacing: 28px;

            // Mythic Center Emblem (Centered)
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 170px;
                    height: 170px;
                    border-radius: 85px;
                    background: @radial-gradient(circle, #ff4d2e55 0%, transparent 70%);

                    Image {
                        source: @image-url("../../assets/media/app_icon.png");
                        width: 150px;
                        height: 150px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "SHARABHA";
                    font-size: 42px;
                    font-weight: 900;
                    letter-spacing: 8px;
                    color: #f8fafc;
                    horizontal-alignment: center;
                }

                Text {
                    text: "ॐ नमः शरभाय — THE DUAL ASPECT ENGINE (उग्र व शान्त)";
                    font-size: 14px;
                    font-weight: 800;
                    letter-spacing: 3px;
                    color: #eab308;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.splash_status;
                    font-size: 12px;
                    color: #94a3b8;
                    horizontal-alignment: center;
                }
            }

            // Dismiss / Enter Temple Button (Centered)
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 250px;
                    height: 48px;
                    background: #ff4d2e;
                    border-radius: 8px;
                    TouchArea {
                        clicked => {
                            root.show_splash = false;
                            root.dismiss_splash();
                        }
                    }
                    Text {
                        text: "ENTER TEMPLE (मंदिर प्रवेश)";
                        font-size: 13px;
                        font-weight: 900;
                        letter-spacing: 1.5px;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
