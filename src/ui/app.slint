import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView, ListView } from "std-widgets.slint";

/* ==========================================================================
   SHARABHA THEME — Shaivite Mysticism & Systems Duality
   - Bhasma (Ash Charcoal): #07090d, #0d1117, #151a23
   - Rudra Agni (Third-Eye Ember): #ff4d2e, #ff7b00
   - Shanti Ganga (Celestial Cyan): #38bdf8, #0ea5e9
   - Trishula Suvarna (Sacred Bronze/Gold): #eab308, #ca8a04
   - Translucent Glass: rgba(13, 17, 24, 0.88)
   ========================================================================== */

export struct ProcessUiEntry {
    pid: int,
    name: string,
    arch: string,
}

export struct MemoryScanResult {
    address: string,
    value: string,
    previous: string,
    val_type: string,
    is_frozen: bool,
}

export struct SaveFieldEntry {
    offset: string,
    label: string,
    inferred_type: string,
    value: string,
    confidence: int,
}

/* ==========================================================================
   THEMATIC ACTION BUTTON WITH OPAQUE HOVER EXPLANATION
   ========================================================================== */
export component ThematicActionButton inherits Rectangle {
    in property <string> text;
    in property <color> bg_color: #ff4d2e;
    in property <color> hover_color: #ff684a;
    in property <string> sanskrit_title: "";
    in property <string> feature_name: "";
    in property <string> explanation: "";
    in property <length> btn_width: 140px;
    in property <length> btn_height: 38px;

    callback clicked();

    width: btn_width;
    height: btn_height;
    background: touch.has_hover ? hover_color : bg_color;
    border-radius: 6px;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Opaque Floating Description Card on Hover
    if touch.has_hover && root.feature_name != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: -self.height - 10px;
        width: 320px;
        height: 82px;
        background: #090c12;
        border-radius: 8px;
        border-width: 1.5px;
        border-color: #eab308;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000;
        z: 1000;

        VerticalLayout {
            padding: 10px;
            spacing: 3px;
            alignment: center;

            Text {
                text: root.sanskrit_title;
                font-size: 11px;
                font-weight: 800;
                color: #eab308;
            }

            Text {
                text: root.feature_name;
                font-size: 11px;
                font-weight: 700;
                color: #f8fafc;
            }

            Text {
                text: root.explanation;
                font-size: 10px;
                color: #94a3b8;
                wrap: word-wrap;
            }
        }
    }
}

/* ==========================================================================
   THEMATIC COLUMN HEADER WITH OPAQUE HOVER EXPLANATION
   ========================================================================== */
export component ThematicColumnHeader inherits Rectangle {
    in property <string> title;
    in property <length> col_width: 100px;
    in property <color> text_color: #64748b;
    in property <string> sanskrit_title: "";
    in property <string> feature_name: "";
    in property <string> explanation: "";

    width: col_width;
    height: 100%;

    touch := TouchArea {}

    Text {
        text: root.title;
        width: 100%;
        height: 100%;
        font-size: 10px;
        font-weight: 800;
        color: touch.has_hover ? #eab308 : root.text_color;
        vertical-alignment: center;
    }

    // Opaque Floating Tooltip
    if touch.has_hover && root.feature_name != "": Rectangle {
        x: 0px;
        y: -self.height - 8px;
        width: 280px;
        height: 74px;
        background: #090c12;
        border-radius: 6px;
        border-width: 1.5px;
        border-color: #eab308;
        drop-shadow-blur: 14px;
        drop-shadow-color: #000000;
        z: 1000;

        VerticalLayout {
            padding: 8px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.sanskrit_title;
                font-size: 10px;
                font-weight: 800;
                color: #eab308;
            }

            Text {
                text: root.feature_name;
                font-size: 10px;
                font-weight: 700;
                color: #ffffff;
            }

            Text {
                text: root.explanation;
                font-size: 9px;
                color: #94a3b8;
                wrap: word-wrap;
            }
        }
    }
}

export component TabButton inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon_text;
    in property <bool> is_active;
    in property <color> active_color: #ff4d2e;
    in property <string> sanskrit_title: "";
    in property <string> feature_name: "";
    in property <string> explanation: "";

    callback clicked();

    height: 60px;
    background: is_active ? #181f2c : (touch.has_hover ? #121722 : transparent);
    border-radius: 8px;
    border-width: is_active ? 1.5px : 0px;
    border-color: is_active ? active_color : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: center;

        Text {
            text: root.icon_text;
            font-size: 22px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 800;
                letter-spacing: 0.5px;
                color: is_active ? #ffffff : #94a3b8;
            }

            Text {
                text: root.subtitle;
                font-size: 10px;
                font-weight: 600;
                color: is_active ? active_color : #64748b;
            }
        }
    }

    // Opaque Floating Description Card on Hover
    if touch.has_hover && root.feature_name != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height + 8px;
        width: 320px;
        height: 78px;
        background: #090c12;
        border-radius: 8px;
        border-width: 1.5px;
        border-color: root.active_color;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000;
        z: 1000;

        VerticalLayout {
            padding: 10px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.sanskrit_title;
                font-size: 11px;
                font-weight: 800;
                color: root.active_color;
            }

            Text {
                text: root.feature_name;
                font-size: 11px;
                font-weight: 700;
                color: #f8fafc;
            }

            Text {
                text: root.explanation;
                font-size: 10px;
                color: #94a3b8;
                wrap: word-wrap;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "SHARABHA — The Dual Aspect Engine (शरभ)";
    min-width: 1180px;
    min-height: 760px;
    default-font-family: "Segoe UI, sans-serif";
    background: #07090d;

    // Splash State
    in-out property <bool> show_splash: false;
    in-out property <string> splash_status: "Awakening the Ashtamurti & Invoking Sharabha (अष्टमूर्ति)...";

    // Active Tab: 0 = Rudra (Memory), 1 = Kalyana (Save Forge), 2 = Jnana (Knowledge Base)
    in-out property <int> active_tab: 0;

    // Callbacks to Zig core
    callback refresh_processes();
    callback attach_process(int);
    callback start_memory_scan(string, string);
    callback rescan_memory(string);
    callback open_save_file();
    callback execute_fuzzy_parse();
    callback save_file_atomic();
    callback dismiss_splash();

    // =========================================================================
    // LAYER 1: AMBIENT CANVAS BACKGROUND (FALLBACK IMAGE + GLOWS)
    // =========================================================================
    Rectangle {
        width: 100%;
        height: 100%;

        // Fallback Still Image (Low opacity so text contrast remains optimal)
        Image {
            source: @image-url("../../assets/media/bg_canvas_fallback.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: 0.28;
        }

        // Vignette & Dark Tint Overlay
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #07090df2 0%, #07090dbb 50%, #07090df8 100%);
        }

        // Ambient Rudra Flame Glow (Left)
        Rectangle {
            x: parent.width * 0.05;
            y: parent.height * 0.10;
            width: 550px;
            height: 550px;
            border-radius: 275px;
            background: @radial-gradient(circle, #ff4d2e09 0%, transparent 70%);
        }

        // Ambient Ganga Cyan Glow (Right)
        Rectangle {
            x: parent.width * 0.65;
            y: parent.height * 0.35;
            width: 650px;
            height: 650px;
            border-radius: 325px;
            background: @radial-gradient(circle, #0ea5e909 0%, transparent 70%);
        }
    }

    // =========================================================================
    // LAYER 2: MAIN WORKSPACE INTERFACE
    // =========================================================================
    if !root.show_splash: VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // TOP HEADER BAR: Trishula Logo & Aspect Selector
        Rectangle {
            height: 72px;
            background: #0d1118ee;
            border-radius: 12px;
            border-width: 1px;
            border-color: #1e2636;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                // Logo & Motto
                HorizontalLayout {
                    spacing: 14px;
                    alignment: center;

                    Image {
                        source: @image-url("../../assets/media/app_icon.png");
                        width: 44px;
                        height: 44px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "SHARABHA";
                                font-size: 21px;
                                font-weight: 900;
                                letter-spacing: 2px;
                                color: #f8fafc;
                            }
                            Text {
                                text: "शरभ";
                                font-size: 17px;
                                font-weight: 800;
                                color: #eab308;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "The Dual Aspect Game Tool // Subduing Narasimha & The Untamed Process";
                            font-size: 11px;
                            color: #64748b;
                        }
                    }
                }

                // Aspect Tabs
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    TabButton {
                        title: "RUDRA TANDAVA";
                        subtitle: "Samhara Memory Inquest [उग्र / Violent]";
                        icon_text: "🔥";
                        is_active: root.active_tab == 0;
                        active_color: #ff4d2e;
                        sanskrit_title: "रुद्र ताण्डव // RUDRA TANDAVA";
                        feature_name: "Aspect: Memory Penetration & Needle Injection";
                        explanation: "Win32 process attachment, SIMD memory scanning, variable freezing, and live code injection.";
                        clicked => { root.active_tab = 0; }
                    }

                    TabButton {
                        title: "KALYANA STHITI";
                        subtitle: "Surgical Save Restoration [शान्त / Calm]";
                        icon_text: "🧊";
                        is_active: root.active_tab == 1;
                        active_color: #38bdf8;
                        sanskrit_title: "कल्याण स्थिति // KALYANA STHITI";
                        feature_name: "Aspect: Universal Heuristic Save Editor";
