    in property <color> tag_color: #eab308;
    in property <bool> is_selected: false;
    callback clicked();

    height: 48px;
    background: is_selected ? #1e293ecc : (touch.has_hover ? #141c2bcc : #0a0f19aa);
    border-radius: 6px;
    border-width: is_selected ? 1.5px : (touch.has_hover ? 1px : 0px);
    border-color: is_selected ? #eab308 : #38bdf844;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Text {
                text: root.icon_text;
                font-size: 15px;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: root.title;
                    font-size: 11px;
                    font-weight: 800;
                    color: is_selected ? #ffffff : #e2e8f0;
                }

                if root.devanagari != "": Text {
                    text: root.devanagari;
                    font-size: 9px;
                    font-weight: 700;
                    color: is_selected ? #fef08a : #94a3b8;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                background: root.tag_color.transparentize(0.85);
                border-radius: 4px;
                border-width: 1px;
                border-color: root.tag_color.transparentize(0.5);
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text {
                        text: root.category;
                        font-size: 8px;
                        font-weight: 800;
                        color: root.tag_color;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component ProcessPickerRow inherits Rectangle {
    in property <string> proc_name: "";
    in property <int> pid: 0;
    in property <string> win_title: "";
    in property <string> memory_str: "";
    in property <string> arch: "x64";
    in property <bool> is_selected: false;
    callback clicked();

    height: 46px;
    background: is_selected ? #1e3a5fcc : (touch.has_hover ? #17253ecc : #0d1524aa);
    border-radius: 6px;
    border-width: is_selected ? 1.5px : 1px;
    border-color: is_selected ? #38bdf8 : #1e293b;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            Text {
                text: "⚙";
