    in-out property <int> selected_scan_type: 0; // 0: Exact, 1: Bigger Than, 2: Smaller Than, 3: Between, 4: Unknown Initial
    in-out property <string> scan_type_name: "EXACT VALUE (सटीक मान)";
    in-out property <int> selected_rescan_type: 0; // 0: Exact, 1: Increased, 2: Decreased, 3: Changed, 4: Unchanged
    in-out property <string> rescan_type_name: "EXACT VALUE (सटीक मान)";
    in-out property <int> selected_data_type: 0; // 0: 4 Bytes (i32), 1: 4 Bytes (u32), 2: 8 Bytes (i64), 3: Float (f32), 4: Double (f64), 5: 1 Byte (i8), 6: 2 Bytes (i16), 7: String (Text), 8: Array of Bytes
    in-out property <string> data_type_name: LiveScan.data_type;
    in-out property <[ScanRowData]> scan_rows: LiveScan.rows;

