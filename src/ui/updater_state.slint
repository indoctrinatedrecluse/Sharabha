// Sharabha Dynamic Auto-Updater State Codex
// Reactively updated by tools/updater.ps1
export global UpdaterState {
    in property <bool> has_update: false;
    in property <bool> is_checking: false;
    in property <bool> is_downloading: false;
    in property <bool> is_ready: false;
    in property <bool> is_modal_open: false;
    in property <int> active_tab: 2;
    in property <string> current_version: "v0.5.1";
    in property <string> latest_version: "v0.5.1";
    in property <string> release_title: "Sharabha v0.5.1 — The Dual Aspect Engine";
    in property <string> release_date: "2026-11-04";
    in property <string> release_notes: "### Added\n- **Universal Unity Engine Save Parser (\"ऐक्य सूत्र // Aikya Sutra\")**:\n  - Implemented universal Unity save container parser and typed serializer (`src/save/unity.zig`) supporting the three predominant save architectures across thousands of Unity games:\n    1. **Unity BinaryFormatter (.NET NRBF)**: Binary deserializer for `SerializationHeaderRecord`, `SystemClassWithMembersAndTypes`, and `ClassWithMembersAndTypes`. Extracts class name, member names, types (`Boolean`, `Byte`, `Int16`, `Int32`, `Int64`, `Single`, `Double`, `String`), and values with in-place byte mutation.\n    2. **Unity Easy Save 2 & 3 (ES3 JSON)**: Parser and serializer for the industry-standard Easy Save format, extracting typed property dictionaries (`__type`, `value`).\n    3. **Unity PlayerPrefs XML**: Native parser and serializer for `<unity_prefs>` XML storage containing typed `<pref name=\"...\" type=\"...\">` elements.\n  - Type-safe mutation helpers: `setInt`, `setFloat`, `setBool`, and `setString` with deterministic serialization.\n  - Multi-metric container detection (`src/save/metrics/magic_header.zig`) auto-identifying Unity NRBF headers, Easy Save JSON dictionaries, and PlayerPrefs XML tags.\n  - CLI in-place mutation: `--write-save-kv` automatically detects Unity containers, applies typed mutations, generates `.sharabha.bak` backups, and atomically swaps via Win32 `MoveFileExW`.\n  - UI integration: `tools/open_dialog.ps1` dynamically parses Unity saves into Kalyana Sthiti (`src/ui/live_save.slint`) with 100% Curated Aikya Sutra confidence.\n  - Added visual save diff support (`diffUnitySaves` in `src/save/diff.zig` and `tools/diff_saves.ps1`) providing 1-click delta comparison against backups for Unity saves.\n  - Added sample test fixtures and mock generator `tools/create_mock_unity.ps1` producing `SampleUnity.dat` (NRBF) and `SampleUnity.es3` (Easy Save 3).\n\n---";
    in property <float> download_progress: 0.00;
    in property <string> status_text: "";
    in property <string> setup_path: "";
}