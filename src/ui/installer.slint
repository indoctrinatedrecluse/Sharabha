import { Button, LineEdit } from "std-widgets.slint";
import { SplashAssets } from "splash_frames.slint";
import { InstallerState } from "installer_state.slint";

/* ==========================================================================
   SHARABHA FLASHY INSTALLER — Shaivite Mysticism & Systems Duality
   - Animated 24 FPS splash cinema in background
   - Translucent glass canvas
   - Desktop shortcut, Start menu, destination folder, and launch options
   ========================================================================== */

export component InstallerWindow inherits Window {
    title: "SHARABHA SETUP // शरभेश्वर प्रतिष्ठापन (v0.5.2)";
    width: 880px;
    height: 580px;
    background: #07090d;
    icon: @image-url("../../assets/media/app_icon.png");

    // Installer State
    in-out property <int> page: 0; // 0: Config, 1: Installing, 2: Complete
    in-out property <string> install_path: InstallerState.detected_install_path;
    in-out property <bool> is_already_installed: InstallerState.is_already_installed;
    in-out property <string> installed_version: InstallerState.installed_version;
    in-out property <bool> create_desktop_shortcut: true;
    in-out property <bool> create_start_menu: true;
    in-out property <bool> launch_after_install: true;
    in-out property <float> install_progress: 0.0; // 0.0 to 1.0
    in-out property <string> install_step_text: InstallerState.is_already_installed ? "Updating Binaries & Engine Files..." : "Sanctifying Binaries & Engine Files...";

    // Animated Splash Cinema Timer
    in-out property <int> current_frame: 0;
    splash_timer := Timer {
        interval: 42ms; // 24 FPS Cinema
        running: true;
        triggered() => {
            root.current_frame = Math.mod(root.current_frame + 1, 143);
        }
    }

    // Installation Progress Animation Timer
    install_timer := Timer {
        interval: 120ms;
        running: root.page == 1;
        triggered() => {
            if (root.install_progress < 0.25) {
                root.install_step_text = "Deploying Native Binaries (Sharabha.exe, SharabhaCli.exe)...";
                root.install_progress += 0.04;
            } else if (root.install_progress < 0.55) {
                root.install_step_text = "Copying Chitrapata Hardware Video Buffers & Sacred Media...";
                root.install_progress += 0.03;
            } else if (root.install_progress < 0.85) {
                root.install_step_text = "Deploying Slint 1.18 Hardware Declarations & Tools...";
                root.install_progress += 0.025;
            } else if (root.install_progress < 0.98) {
                root.install_step_text = "Forging Trishula Shortcuts & Windows Shell Registration...";
                root.install_progress += 0.02;
            } else {
                root.install_progress = 1.0;
                root.page = 2; // Transition to Complete
            }
        }
    }

    // Callbacks to Native Windows Backend
    callback browse_dir();
    callback start_install(string, bool, bool, bool);
    callback finish_install(string, bool);
    callback cancel();

    // LAYER 1: 24 FPS SPLASH VIDEO CINEMA IN BACKGROUND
    Image {
        source: SplashAssets.frames[root.current_frame];
        width: 100%;
        height: 100%;
        image-fit: cover;
        opacity: 0.38;
    }

    // LAYER 2: DARK MYTHIC VIGNETTE OVERLAY
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, #07090de6 0%, #07090db8 45%, #07090df5 100%);
    }

    // LAYER 3: MAIN INSTALLER GLASS CANVAS
    VerticalLayout {
        padding: 28px;
        spacing: 16px;
        alignment: space-between;

        // Header with Mythic Emblem & Title
        HorizontalLayout {
            spacing: 20px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 16px;
                alignment: center;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: @radial-gradient(circle, #ff4d2e55 0%, transparent 70%);

                    Image {
                        source: @image-url("../../assets/media/app_icon.png");
                        width: 56px;
                        height: 56px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "SHARABHA (शरभेश्वर)";
                            font-size: 20px;
                            font-weight: 900;
                            letter-spacing: 2px;
                            color: #f8fafc;
                        }
                        Rectangle {
                            height: 20px;
                            background: #ff4d2e26;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #ff4d2e55;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "v0.5.2";
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: #ff7b00;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: root.is_already_installed ?
                            "THE DUAL ASPECT ENGINE // SANCTIFIED VESSEL UPDATE (अद्यतन)" :
                            "THE DUAL ASPECT ENGINE // SACRED SETUP & INSTALLATION (प्रतिष्ठापन)";
                        font-size: 10px;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                        color: root.is_already_installed ? #38bdf8 : #eab308;
                    }
                }
            }

            // Top Status Pill
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 28px;
                    background: root.is_already_installed ? #0284c725 : #162032b8;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.is_already_installed ? #38bdf8aa : #38bdf855;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: center;
                        Text {
                            text: root.is_already_installed ? "🔄" : "☸";
                            font-size: 12px;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.is_already_installed ? ("Installed: v" + root.installed_version + " • Update Ready") : "Windows x64 Native Vessel";
                            font-size: 11px;
                            font-weight: 700;
                            color: #38bdf8;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Horizontal Separator
        Rectangle {
            height: 1px;
            background: #33415555;
        }

        // =====================================================================
        // PAGE 0: CONFIGURATION & DIRECTORY SELECTION
        // =====================================================================
        if root.page == 0: VerticalLayout {
            spacing: 20px;

            // Welcome Text Box
            Rectangle {
                background: #0d1626a8;
                border-radius: 8px;
                border-width: 1px;
                border-color: root.is_already_installed ? #0284c755 : #1e293b;

                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    Text {
                        text: root.is_already_installed ? "Existing Sharabha Vessel Detected on this System" : "Welcome to the Sharabha Consecration Setup";
                        font-size: 14px;
                        font-weight: 800;
                        color: #f1f5f9;
                    }
                    Text {
                        text: root.is_already_installed ?
                            "An active installation of Sharabha was detected. Proceeding will update all core binaries, memory inquest engines, video media, and Slint UI declarations to v0.5.2 without disturbing your saved states or DPAPI vault." :
                            "This wizard will install the complete Sharabha Dual Aspect Engine suite on your PC, including Rudra Tandava memory scanning, Kalyana Sthiti multi-format save forging, Chitrapata hardware video pipelines, and the DPAPI-encrypted Gupta Kosha.";
                        font-size: 12px;
                        color: #94a3b8;
                        wrap: word-wrap;
                    }
                }
            }

            // Installation Location Group
            VerticalLayout {
                spacing: 8px;

                Text {
                    text: root.is_already_installed ? "ACTIVE INSTALLATION VESSEL (अद्यतन स्थान):" : "DESTINATION VESSEL (प्रतिष्ठापन स्थान):";
                    font-size: 11px;
                    font-weight: 800;
                    letter-spacing: 1px;
                    color: #38bdf8;
                }

                HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        height: 42px;
                        horizontal-stretch: 1;
                        background: #090e17d9;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #334155;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            LineEdit {
                                text <=> root.install_path;
                                font-size: 12px;
                            }
                        }
                    }

                    Rectangle {
                        width: 130px;
                        height: 42px;
                        background: #1e293b;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #475569;
                        TouchArea {
                            clicked => { root.browse_dir(); }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: center;
                            Text {
                                text: "📂";
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "BROWSE...";
                                font-size: 11px;
                                font-weight: 800;
                                color: #f8fafc;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: "Space Required: ~65 MB • Space Available: Plenty";
                    font-size: 10px;
                    color: #64748b;
                }
            }

            // Options Checkboxes
            Rectangle {
                background: #0d1626a8;
                border-radius: 8px;
                border-width: 1px;
                border-color: #1e293b;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    Text {
                        text: "INSTALLATION PREFERENCES (संकल्प):";
                        font-size: 11px;
                        font-weight: 800;
                        color: #eab308;
                    }

                    // Desktop Shortcut Checkbox
                    Rectangle {
                        height: 24px;
                        background: transparent;
                        TouchArea {
                            clicked => { root.create_desktop_shortcut = !root.create_desktop_shortcut; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.create_desktop_shortcut ? #38bdf8 : #475569;
                                background: root.create_desktop_shortcut ? #0284c7 : #0f172a;
                                Text {
                                    text: root.create_desktop_shortcut ? "✓" : "";
                                    font-size: 13px;
                                    font-weight: 900;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "Create Desktop Trishula Shortcut (with high-res mythic icon)";
                                font-size: 12px;
                                font-weight: 600;
                                color: #e2e8f0;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Start Menu Entry Checkbox
                    Rectangle {
                        height: 24px;
                        background: transparent;
                        TouchArea {
                            clicked => { root.create_start_menu = !root.create_start_menu; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.create_start_menu ? #38bdf8 : #475569;
                                background: root.create_start_menu ? #0284c7 : #0f172a;
                                Text {
                                    text: root.create_start_menu ? "✓" : "";
                                    font-size: 13px;
                                    font-weight: 900;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "Create Start Menu Program Entry (प्रारंभ सूची प्रविष्टि)";
                                font-size: 12px;
                                font-weight: 600;
                                color: #e2e8f0;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Launch After Install Checkbox
                    Rectangle {
                        height: 24px;
                        background: transparent;
                        TouchArea {
                            clicked => { root.launch_after_install = !root.launch_after_install; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.launch_after_install ? #ff4d2e : #475569;
                                background: root.launch_after_install ? #ff4d2e : #0f172a;
                                Text {
                                    text: root.launch_after_install ? "✓" : "";
                                    font-size: 13px;
                                    font-weight: 900;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "Launch Sharabha (शरभेश्वर) immediately when installation completes";
                                font-size: 12px;
                                font-weight: 600;
                                color: #e2e8f0;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // PAGE 1: INSTALLATION IN PROGRESS
        // =====================================================================
        if root.page == 1: VerticalLayout {
            spacing: 24px;
            alignment: center;

            VerticalLayout {
                spacing: 10px;
                alignment: center;

                Text {
                    text: root.is_already_installed ? "UPDATING SHARABHA (संस्थापन नवीनीकरण)..." : "CONSECRATING SHARABHA (संस्थापन क्रियमाण)...";
                    font-size: 16px;
                    font-weight: 900;
                    letter-spacing: 2px;
                    color: #f8fafc;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.install_step_text;
                    font-size: 13px;
                    font-weight: 700;
                    color: #38bdf8;
                    horizontal-alignment: center;
                }
            }

            // Large Glowing Progress Bar
            Rectangle {
                height: 18px;
                background: #090e17;
                border-radius: 9px;
                border-width: 1px;
                border-color: #334155;

                // Filled Bar
                Rectangle {
                    x: 0;
                    width: root.width * root.install_progress * 0.88;
                    height: 100%;
                    border-radius: 9px;
                    background: @linear-gradient(90deg, #ff4d2e 0%, #ff7b00 50%, #38bdf8 100%);
                }
            }

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Extracting pure Zig 0.17 native binaries & hardware frame buffers";
                    font-size: 10px;
                    color: #64748b;
                }
                Text {
                    text: Math.round(root.install_progress * 100) + "%";
                    font-size: 12px;
                    font-weight: 900;
                    color: #eab308;
                }
            }
        }

        // =====================================================================
        // PAGE 2: INSTALLATION COMPLETED
        // =====================================================================
        if root.page == 2: VerticalLayout {
            spacing: 24px;
            alignment: center;

            VerticalLayout {
                spacing: 12px;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 72px;
                        height: 72px;
                        border-radius: 36px;
                        background: #22c55e22;
                        border-width: 2px;
                        border-color: #22c55e;

                        Text {
                            text: "✓";
                            font-size: 36px;
                            font-weight: 900;
                            color: #4ade80;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: root.is_already_installed ? "UPDATE COMPLETE (अद्यतन सम्पन्न)" : "CONSECRATION COMPLETE (प्रतिष्ठा सम्पन्न)";
                    font-size: 18px;
                    font-weight: 900;
                    letter-spacing: 2px;
                    color: #f8fafc;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.is_already_installed ?
                        "Sharabha v0.5.2 has been sanctified and successfully updated on this PC." :
                        "Sharabha v0.5.2 has been sanctified and registered on this system.";
                    font-size: 13px;
                    color: #cbd5e1;
                    horizontal-alignment: center;
                }
            }

            Rectangle {
                background: #0d1626a8;
                border-radius: 8px;
                border-width: 1px;
                border-color: #1e293b;

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text {
                        text: "INSTALLED LOCATION: " + root.install_path;
                        font-size: 11px;
                        font-weight: 700;
                        color: #38bdf8;
                    }
                    Text {
                        text: "Desktop Shortcut: " + (root.create_desktop_shortcut ? "Created (Trishula Icon)" : "Skipped");
                        font-size: 11px;
                        color: #94a3b8;
                    }
                    Text {
                        text: "Start Menu: " + (root.create_start_menu ? "Registered under Sharabha" : "Skipped");
                        font-size: 11px;
                        color: #94a3b8;
                    }
                }
            }

            // Launch Checkbox
            Rectangle {
                height: 24px;
                background: transparent;
                TouchArea {
                    clicked => { root.launch_after_install = !root.launch_after_install; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.launch_after_install ? #ff4d2e : #475569;
                        background: root.launch_after_install ? #ff4d2e : #0f172a;
                        Text {
                            text: root.launch_after_install ? "✓" : "";
                            font-size: 13px;
                            font-weight: 900;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "Launch Sharabha (शरभेश्वर) now upon exit";
                        font-size: 12px;
                        font-weight: 700;
                        color: #f8fafc;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // =====================================================================
        // BOTTOM ACTION CONTROL BAR
        // =====================================================================
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;

            // Cancel Button
            Rectangle {
                width: 110px;
                height: 42px;
                background: #1e293b88;
                border-radius: 6px;
                border-width: 1px;
                border-color: #334155;
                TouchArea {
                    clicked => { root.cancel(); }
                }
                Text {
                    text: root.page == 2 ? "CLOSE" : "CANCEL";
                    font-size: 11px;
                    font-weight: 800;
                    color: #94a3b8;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Right Action Buttons
            HorizontalLayout {
                spacing: 12px;

                if root.page == 0: Rectangle {
                    width: 250px;
                    height: 44px;
                    background: root.is_already_installed ? #0284c7 : #ff4d2e;
                    border-radius: 6px;
                    TouchArea {
                        clicked => {
                            root.page = 1;
                            root.start_install(root.install_path, root.create_desktop_shortcut, root.create_start_menu, root.launch_after_install);
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Text {
                            text: root.is_already_installed ? "🔄" : "🔱";
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.is_already_installed ? "UPDATE // अद्यतन प्रारंभ" : "INSTALL // संस्थापन प्रारंभ";
                            font-size: 12px;
                            font-weight: 900;
                            letter-spacing: 1px;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.page == 2: Rectangle {
                    width: 250px;
                    height: 44px;
                    background: #0284c7;
                    border-radius: 6px;
                    TouchArea {
                        clicked => {
                            root.finish_install(root.install_path, root.launch_after_install);
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Text {
                            text: "⚡";
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "FINISH & ENTER TEMPLE";
                            font-size: 12px;
                            font-weight: 900;
                            letter-spacing: 1px;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
